---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'tuweb.dev — esta web es tuya',
	description = 'Una web que se itera en público. Entra con GitHub, propone el siguiente cambio y un proceso automático elige la mejor idea.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<!-- Con initial-scale=1 el móvil no entra ya con la página encogida, y sin
		     maximum-scale para no quitarle el zoom a nadie. -->
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Un solo tema: papel claro y naranja. Ni modo oscuro ni interruptor. -->
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content="#fdf6ef" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Precargadas: llegan antes del primer pintado, así no hay cambio de fuente. -->
		<link
			rel="preload"
			href="/fonts/geist-mono-latin-wght-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/geist-pixel-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!--
			Lo que se haya afinado en la caja de herramientas —color y fondo— se aplica
			en cuanto carga este script, junto con las variables tocadas en el panel de
			Config. Va en la cabecera y no en línea porque la CSP es script-src 'self':
			lo más pronto que puede correr es esto. El fondo de la web no depende de
			esto: el papel claro ya lo pinta la hoja de estilos, así que no parpadea.
		-->
		<script>
			import { applyConfig, readConfig } from '../lib/config';
			import { applyTheme, readTheme } from '../lib/theme';

			applyTheme(readTheme());
			applyConfig(readConfig());
		</script>
	</head>
	<body data-canvas class="bg-bg font-mono text-fg antialiased">
		<slot />
	</body>
</html>
