---
import A11yPanel from '../components/A11yPanel.astro';
import Archivo from '../components/Archivo.astro';
import NyanCat from '../components/NyanCat.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'tuweb.dev — esta web es tuya',
	description = 'Una web que se itera en público. Entra con GitHub, propone el siguiente cambio y un proceso automático elige la mejor idea.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<!-- Con initial-scale=1 el móvil no entra ya con la página encogida, y sin
		     maximum-scale para no quitarle el zoom a nadie. Con viewport-fit=cover
		     la web ocupa la pantalla entera en los móviles con muesca —el fondo y
		     los paneles llegan hasta el filo— y los márgenes de la hoja de estilos
		     apartan el texto de lo que se come el marco. -->
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<!-- Dos temas: blanco de alto contraste, que es el de entrada, y noche
		     cálida. El interruptor está en el pie. -->
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#ffffff" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Precargadas: llegan antes del primer pintado, así no hay cambio de fuente. -->
		<link
			rel="preload"
			href="/fonts/geist-mono-latin-wght-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/geist-pixel-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!--
			Lo que se haya afinado en la caja de herramientas —modo, color y fondo— se
			aplica en cuanto carga este script, junto con las variables tocadas en el
			panel de Config. Va en la cabecera y no en línea porque la CSP es
			script-src 'self': lo más pronto que puede correr es esto. El modo no
			parpadea: quien no ha elegido nada ya entra con el del sistema, que lo
			pinta la hoja de estilos antes de que esto corra.
		-->
		<script>
			import { applyAccesibilidad, readAccesibilidad } from '../lib/accesibilidad';
			import { applyConfig, readConfig } from '../lib/config';
			import { watchEfectos } from '../lib/efectos';
			import { applyTheme, readTheme, watchSystemMode } from '../lib/theme';

			applyTheme(readTheme());
			applyConfig(readConfig());
			// Contraste, tamaño de letra y tipografía para dislexia, del panel de accesibilidad.
			applyAccesibilidad(readAccesibilidad());
			// Con el modo en «sistema», la web sigue al sistema sin recargar.
			watchSystemMode();
			// Los sonidos de clic y scroll, si alguien los ha encendido en Herramientas.
			watchEfectos();
		</script>
	</head>
	<body data-canvas class="bg-bg font-mono text-fg antialiased">
		<slot />
		<!-- La mascota de la casa: cruza por encima de todo sin tocar nada. -->
		<NyanCat />
		<!-- Contraste, letra y tipografía para dislexia, a mano en todas las páginas. -->
		<A11yPanel />
		<!-- El experimento está parado: lo cuenta al entrar. -->
		<Archivo />
	</body>
</html>
