---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'tuweb.dev — esta web es tuya',
	description = 'Una web que se itera en público. Entra con GitHub, propone el siguiente cambio y un proceso automático elige la mejor idea.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- Oscuro primero: es el de casa. El claro lo pone el selector de temas. -->
		<meta name="color-scheme" content="dark light" />
		<meta name="theme-color" content="#0a0a0a" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Precargadas: llegan antes del primer pintado, así no hay cambio de fuente. -->
		<link
			rel="preload"
			href="/fonts/geist-mono-latin-wght-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/geist-pixel-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!--
			El tema que se haya elegido en la caja de herramientas —modo, color y
			fondo— se aplica en cuanto carga este script. Va en la cabecera y no en
			línea porque la CSP es script-src 'self': lo más pronto que puede correr
			es esto.
		-->
		<script>
			import { applyTheme, readTheme } from '../lib/theme';

			applyTheme(readTheme());

			// Con el modo del sistema puesto, la web va detrás de lo que haga el sistema.
			window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
				const theme = readTheme();
				if (theme.mode === 'auto') applyTheme(theme);
			});
		</script>
	</head>
	<body data-canvas class="bg-bg font-mono text-fg antialiased">
		<slot />
	</body>
</html>
