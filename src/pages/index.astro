---
import FeatureLog from '../components/FeatureLog.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import IdeasLink from '../components/IdeasLink.astro';
import ProposeForm from '../components/ProposeForm.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Toolbox from '../components/Toolbox.astro';
import { getSessionUser } from '../lib/auth';
import { getHomeData } from '../lib/db/queries';
import Layout from '../layouts/Layout.astro';

const user = await getSessionUser(Astro);
const data = await getHomeData(user?.id);

const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const flashesOk: Record<string, string> = {
	prompt: 'Tu idea entra en esta ventana.',
};
const flashesError: Record<string, string> = {
	login: 'Entra con GitHub para continuar.',
	oauth: 'Falta configurar GitHub para poder entrar.',
	auth: 'No se pudo entrar con GitHub.',
	length: 'Entre 16 y 280 caracteres.',
	filtro: 'La IA ha descartado tu idea.',
	enviada: 'Ya enviaste tu idea en esta ventana. Espera a la siguiente.',
	origin: 'Petición no válida.',
};
const flash = (ok && flashesOk[ok]) || (error && flashesError[error]) || null;

// Un 'building' viejo es una iteración que se quedó a medias: no lo damos por vivo.
const BUILDING_MAX_MS = 30 * 60 * 1000;
const building =
	data.lastRelease?.status === 'building' &&
	Date.now() - new Date(data.lastRelease.createdAt).getTime() < BUILDING_MAX_MS;

const deployedAt =
	(data.lastRelease?.status === 'live' ? data.lastRelease.createdAt : null) ??
	data.lastShipped?.shippedAt ??
	null;
---

<Layout>
	<div class="flex min-h-screen flex-col">
		<section class="border-b border-line bg-panel" aria-label="Tu idea">
			<div class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-10">
				<Header user={user} version={data.version} deployedAt={deployedAt} building={building} />
				{flash && <p class="text-sm text-mark">{flash}</p>}
				<ProposeForm user={user} myPrompt={data.myPrompt} endsAt={data.window.endsAt} />
				<IdeasLink ideaCount={data.ideaCount} discardedCount={data.discardedCount} />
			</div>
		</section>

		<section class="grow bg-bg" aria-labelledby="label-app">
			<div class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-10">
				<SectionLabel forId="label-app">Y ESTO ES LO QUE YA FUNCIONA</SectionLabel>

				<Toolbox />
			</div>
		</section>

		<!-- Prefooter: esto cuenta el proceso, no forma parte de lo construido. -->
		<div class="border-t border-line bg-panel">
			<div class="mx-auto w-full max-w-5xl px-6 py-8">
				<FeatureLog
					version={data.version}
					lastShipped={data.lastShipped}
					next={data.next}
					lastRelease={data.lastRelease}
				/>
			</div>
		</div>

		<Footer />
	</div>
</Layout>
