---
import Chat from '../components/Chat.astro';
import Dashboard from '../components/Dashboard.astro';
import FeatureLog from '../components/FeatureLog.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import IdeasLink from '../components/IdeasLink.astro';
import LiveState from '../components/LiveState.astro';
import Minigame from '../components/Minigame.astro';
import ProposeForm from '../components/ProposeForm.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Toolbox from '../components/Toolbox.astro';
import { getSessionUser } from '../lib/auth';
import { getDashboardData, getHomeData } from '../lib/db/queries';
import { siteState } from '../lib/releases';
import Layout from '../layouts/Layout.astro';

const user = await getSessionUser(Astro);
const data = await getHomeData(user?.id);
const dashboard = await getDashboardData();

const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const flashesOk: Record<string, string> = {
	prompt: 'Tu idea entra en esta ventana.',
	cambio: 'Idea cambiada.',
};
const flashesError: Record<string, string> = {
	login: 'Entra con GitHub para continuar.',
	oauth: 'Falta configurar GitHub para poder entrar.',
	auth: 'No se pudo entrar con GitHub.',
	length: 'Entre 16 y 280 caracteres.',
	enviada: 'Ya enviaste tu idea en esta ventana. Espera a la siguiente.',
	cambios: 'Ya has gastado los cambios de esta ventana.',
	origin: 'Petición no válida.',
};
const flash = (ok && flashesOk[ok]) || (error && flashesError[error]) || null;

const state = siteState(data.lastRelease);

const deployedAt =
	(data.lastRelease?.status === 'live' ? data.lastRelease.createdAt : null) ??
	data.lastShipped?.shippedAt ??
	null;
---

<Layout>
	<!-- El dashboard es un raíl a la izquierda; el pie cruza por debajo de las dos columnas. -->
	<div class="flex min-h-screen flex-col">
		<div class="flex grow flex-col lg:flex-row">
			<Dashboard
				version={data.version}
				state={state}
				ideaCount={data.ideaCount}
				discardedCount={data.discardedCount}
				endsAt={data.window.endsAt}
				next={data.next}
				totals={dashboard}
				points={dashboard.points}
			/>

			<div class="flex min-w-0 grow flex-col">
				<section class="border-b border-line bg-panel" aria-label="Tu idea">
					<div class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-10">
						<div data-live="header">
							<Header user={user} version={data.version} deployedAt={deployedAt} state={state} />
						</div>
						{flash && <p class="text-sm text-mark">{flash}</p>}
						<ProposeForm user={user} myPrompt={data.myPrompt} endsAt={data.window.endsAt} state={state} />
						<div data-live="ideas">
							<IdeasLink ideaCount={data.ideaCount} discardedCount={data.discardedCount} />
						</div>
					</div>
				</section>

				<section class="grow bg-bg" aria-labelledby="label-app">
					<div class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-10">
						<SectionLabel forId="label-app">Y ESTO ES LO QUE YA FUNCIONA</SectionLabel>

						<Toolbox />

						<Minigame />

						<Chat
							login={user?.login ?? null}
							version={data.version}
							ideaCount={data.ideaCount}
							endsAt={data.window.endsAt}
							next={data.next}
							lastShipped={data.lastShipped}
						/>
					</div>
				</section>

				<!-- Prefooter: esto cuenta el proceso, no forma parte de lo construido. -->
				<div class="border-t border-line bg-panel">
					<div class="mx-auto w-full max-w-5xl px-6 py-8" data-live="featurelog">
						<FeatureLog
							version={data.version}
							lastShipped={data.lastShipped}
							next={data.next}
							lastRelease={data.lastRelease}
							state={state}
						/>
					</div>
				</div>
			</div>
		</div>

		<Footer />
	</div>

	<LiveState />
</Layout>
