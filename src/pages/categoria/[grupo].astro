---
/**
 * La página de un apartado: solo sus secciones, sin nada más alrededor.
 * /categoria/juegos es el salón entero; /categoria/herramientas, la mesa de
 * trabajo. La lista sale de src/lib/sections.ts, así que un apartado nuevo se
 * abre solo. Un apartado que no existe cae en el 404, que enseña los que sí hay.
 */
import BackLink from '../../components/BackLink.astro';
import Footer from '../../components/Footer.astro';
import GroupNav from '../../components/GroupNav.astro';
import Icon from '../../components/Icon.astro';
import RetosHoy from '../../components/RetosHoy.astro';
import SectionCards from '../../components/SectionCards.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { GROUPS, sectionsOf, type Group } from '../../lib/sections';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
	return GROUPS.map((group) => ({ params: { grupo: group.id }, props: { group } }));
}

const { group } = Astro.props as { group: Group };
const sections = sectionsOf(group.id);
---

<Layout title={`${group.title} — tuweb.dev`} description={group.intro}>
	<div class="flex min-h-dvh flex-col">
		<div class="aire">
			<div class="zona flex flex-col gap-8">
				<BackLink />

				<div class="flex flex-col gap-3">
					<h1 class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-pixel text-titulo font-normal sm:gap-x-3">
						<Icon name={group.icon} class="size-5 shrink-0 text-accent sm:size-6" />
						{group.title}
						<span class="text-lg tabular-nums text-muted">{sections.length}</span>
					</h1>
					<p class="max-w-[62ch] text-sm text-pretty text-muted">{group.intro}</p>
				</div>

				{group.id === 'juegos' && <RetosHoy />}

				<SectionCards sections={sections} />
			</div>
		</div>

		<div class="grow"></div>

		<nav data-canvas class="border-t border-line bg-panel" aria-label="Otros apartados">
			<div class="zona flex flex-col gap-4 py-8">
				<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
					<SectionLabel>OTROS APARTADOS</SectionLabel>
					<a href="/todo" class="inline-flex items-center gap-2 text-sm text-accent hover:underline">
						Todo en un sitio
						<Icon name="arrow-right" class="size-4 shrink-0" />
					</a>
				</div>
				<GroupNav current={group.id} />
			</div>
		</nav>

		<Footer />
	</div>
</Layout>
