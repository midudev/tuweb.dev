---
/**
 * La página de un apartado: solo sus secciones, sin nada más alrededor.
 * /categoria/juegos es el salón entero; /categoria/herramientas, la mesa de
 * trabajo. La lista sale de src/lib/sections.ts, así que un apartado nuevo se
 * abre solo. Si la URL trae un apartado que no existe, la página responde 404 y
 * enseña los que sí hay.
 */
import BackLink from '../../components/BackLink.astro';
import Footer from '../../components/Footer.astro';
import GroupNav from '../../components/GroupNav.astro';
import Icon from '../../components/Icon.astro';
import SectionCards from '../../components/SectionCards.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { findGroup, sectionsOf } from '../../lib/sections';
import Layout from '../../layouts/Layout.astro';

const group = findGroup(Astro.params.grupo);
const sections = group ? sectionsOf(group.id) : [];

if (!group) Astro.response.status = 404;
---

<Layout
	title={group ? `${group.title} — tuweb.dev` : 'Ese apartado no existe — tuweb.dev'}
	description={group?.intro}
>
	<div class="flex min-h-screen flex-col">
		<div class="px-5 py-10 sm:px-6 lg:px-8">
			<div class="mx-auto flex w-full max-w-5xl flex-col gap-8">
				<BackLink />

				{
					group ? (
						<>
							<div class="flex flex-col gap-3">
								<h1 class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-pixel text-2xl leading-tight font-normal sm:gap-x-3 sm:text-3xl">
									<Icon name={group.icon} class="size-5 shrink-0 text-accent sm:size-6" />
									{group.title}
									<span class="text-lg tabular-nums text-muted">{sections.length}</span>
								</h1>
								<p class="max-w-[62ch] text-sm text-pretty text-muted">{group.intro}</p>
							</div>

							<SectionCards sections={sections} />
						</>
					) : (
						<div class="flex flex-col gap-3">
							<h1 class="font-pixel text-2xl leading-tight font-normal sm:text-3xl">
								Ese apartado no existe
							</h1>
							<p class="max-w-[62ch] text-sm text-pretty text-muted">
								La web está repartida en estos, y debajo los tienes todos.
							</p>
						</div>
					)
				}
			</div>
		</div>

		<div class="grow"></div>

		<nav data-canvas class="border-t border-line bg-panel" aria-label="Otros apartados">
			<div class="mx-auto flex w-full max-w-5xl flex-col gap-4 px-5 py-8 sm:px-6 lg:px-8">
				<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
					<SectionLabel>OTROS APARTADOS</SectionLabel>
					<a href="/todo" class="inline-flex items-center gap-2 text-sm text-accent hover:underline">
						Todo en un sitio
						<Icon name="arrow-right" class="size-4 shrink-0" />
					</a>
				</div>
				<GroupNav current={group?.id} />
			</div>
		</nav>

		<Footer />
	</div>
</Layout>
