---
import Footer from '../components/Footer.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { getChangelogData } from '../lib/db/queries';
import Layout from '../layouts/Layout.astro';

const data = await getChangelogData();
const REPO = 'https://github.com/midudev/tuweb.dev';

function fecha(iso: string | null) {
	if (!iso) return null;
	return new Date(iso).toLocaleDateString('es-ES', {
		day: 'numeric',
		month: 'long',
		year: 'numeric',
		hour: '2-digit',
		minute: '2-digit',
	});
}
---

<Layout
	title="Changelog — tuweb.dev"
	description="Todas las ideas que ha pedido la gente y que ya están implementadas en tuweb.dev."
>
	<div class="flex min-h-screen flex-col">
		<section class="px-6 py-10">
			<div class="mx-auto flex w-full max-w-5xl flex-col gap-8">
				<a href="/" class="inline-flex items-center gap-2 self-start text-sm text-accent hover:underline">
					<svg class="size-4 shrink-0 rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M5 12h14m-6 6l6-6m-6-6l6 6" />
					</svg>
					Volver a tuweb.dev
				</a>

				<div class="flex flex-wrap items-end justify-between gap-6">
					<h1 class="font-pixel text-3xl leading-tight font-normal">Changelog</h1>
					<p class="text-sm text-muted">{data.version} {data.version === 1 ? 'versión' : 'versiones'}</p>
				</div>

				<p class="max-w-[62ch] text-sm text-muted">
					Todo lo que hay aquí lo pidió alguien. Cada versión es una ventana de ideas que cerró y
					una IA implementó.
				</p>

				{
					data.queued.length > 0 && (
						<div class="flex flex-col gap-2 border border-line bg-panel px-6 py-5">
							<SectionLabel>EN CONSTRUCCIÓN</SectionLabel>
							{data.queued.map((feature) => (
								<div class="flex flex-col gap-1">
									<p>{feature.title}</p>
									{feature.summary !== feature.title && (
										<p class="text-sm text-muted text-pretty">{feature.summary}</p>
									)}
								</div>
							))}
						</div>
					)
				}

				{
					data.entries.length === 0 ? (
						<p class="text-muted">Todavía no se ha implementado ninguna idea.</p>
					) : (
						<ul class="flex flex-col">
							{data.entries.map((entry) => (
								<li class="flex flex-col gap-2 border-t border-line py-6 last:border-b sm:flex-row sm:gap-8">
									<p class="w-16 shrink-0 font-pixel text-lg text-accent">v{entry.version}</p>
									<div class="flex grow flex-col gap-1.5 sm:max-w-[68ch]">
										<p class="text-lg text-pretty">{entry.title}</p>
										{entry.summary !== entry.title && (
											<p class="text-sm text-muted text-pretty">{entry.summary}</p>
										)}
										<div class="flex flex-wrap items-center gap-4 text-sm text-muted">
											{fecha(entry.shippedAt) && <span>{fecha(entry.shippedAt)}</span>}
											{entry.commitSha && (
												<a
													href={`${REPO}/commit/${entry.commitSha}`}
													class="text-accent hover:underline"
												>
													{entry.commitSha.slice(0, 7)}
												</a>
											)}
										</div>
									</div>
								</li>
							))}
						</ul>
					)
				}
			</div>
		</section>

		<div class="grow"></div>
		<Footer />
	</div>
</Layout>
