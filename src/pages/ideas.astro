---
import BackLink from '../components/BackLink.astro';
import Footer from '../components/Footer.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SectionNav from '../components/SectionNav.astro';
import Votes from '../components/Votes.astro';
import WindowClock from '../components/WindowClock.astro';
import { getIdeasData } from '../lib/db/queries';
import Layout from '../layouts/Layout.astro';
import { MAX_VOTES } from '../lib/votes';
import { DISCARD_LABELS } from '../lib/window';

const data = await getIdeasData();
// Vencida es que ya tocaba cerrarla; abierta sigue hasta que pase el cron.
const overdue = new Date(data.window.endsAt).getTime() <= Date.now();

const received = data.ideas.length + data.discarded.length;
---

<Layout title="Ideas de esta ventana — tuweb.dev">
	<div class="flex min-h-screen flex-col">
		<section class="flex flex-col gap-8 px-5 py-10 sm:px-6 lg:px-8">
			<div class="mx-auto flex w-full max-w-5xl flex-col gap-8">
				<BackLink />

				<div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
					<h1 class="font-pixel text-2xl leading-tight font-normal sm:text-3xl">
						Ideas de esta ventana
					</h1>
					<p class="text-sm text-muted">
						<span data-window-open hidden={overdue}>
							se cierra en <WindowClock endsAt={data.window.endsAt} />
						</span>
						<span data-window-closed hidden={!overdue}>ha cerrado: la IA elige en breve</span>
					</p>
				</div>

				<p class="max-w-[62ch] text-sm text-muted">
					{received} recibidas · {data.ideas.length} pasan el filtro de la IA. Cuando se cierre la
					ventana, gana lo que más se repita. Vota hasta {MAX_VOTES}: las votadas suben arriba.
				</p>

				{
					data.ideas.length === 0 ? (
						<p class="text-muted">Todavía no hay ninguna idea en esta ventana.</p>
					) : (
						<Votes ideas={data.ideas} windowStartedAt={data.window.startedAt} />
					)
				}
			</div>
		</section>

		{
			data.discarded.length > 0 && (
				<section data-canvas class="grow border-t border-line bg-panel px-5 py-9 sm:px-6 lg:px-8" aria-labelledby="label-descartadas">
					<div class="mx-auto flex w-full max-w-5xl flex-col gap-5">
						<div class="flex flex-wrap items-baseline justify-between gap-4">
							<SectionLabel forId="label-descartadas">DESCARTADAS POR LA IA</SectionLabel>
							<p class="text-sm text-muted">{data.discarded.length} de {received}</p>
						</div>

						<ul class="flex flex-col">
							{data.discarded.map((item) => (
								<li class="flex flex-col gap-1.5 border-t border-line py-3 text-sm text-muted last:border-b sm:flex-row sm:items-baseline sm:gap-5">
									<p class="grow max-w-[66ch] text-pretty">{item.body}</p>
									<span class="shrink-0 sm:ml-auto">{DISCARD_LABELS[item.reason ?? 'spam'] ?? 'no encaja'}</span>
								</li>
							))}
						</ul>

						<p class="text-sm text-muted">
							Se descartan por repetidas, por no ser una funcionalidad o por pedir algo peligroso.
						</p>
					</div>
				</section>
			)
		}

		<SectionNav href="/ideas" />
		<Footer />
	</div>
</Layout>

