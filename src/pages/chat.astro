---
import Chat from '../components/Chat.astro';
import WeeklyBanner from '../components/WeeklyBanner.astro';
import { getSessionUser } from '../lib/auth';
import { getHomeData } from '../lib/db/queries';
import Section from '../layouts/Section.astro';

// El tema del canal lleva la versión de la web.
const user = await getSessionUser(Astro);
const data = await getHomeData(user?.id);
---

<Section href="/chat">
	<WeeklyBanner />
	<Chat login={user?.login ?? null} version={data.version} />
</Section>
