---
/**
 * Todo en un sitio: la página donde están juntas las veintitantas secciones de
 * la web, con su buscador. La portada solo lleva el botón que trae aquí; la
 * lista sale de src/lib/sections.ts, así que una sección nueva aparece sola.
 */
import BackLink from '../components/BackLink.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import SectionGrid from '../components/SectionGrid.astro';
import { GROUPS, SECTIONS } from '../lib/sections';
import Layout from '../layouts/Layout.astro';

const intro = `Todo lo que ya funciona en esta web, junto: ${SECTIONS.length} secciones en ${GROUPS.length} apartados. Busca por nombre o baja por apartados; cada una tiene su página y solo cargas la que abras.`;
---

<Layout title="Todo en un sitio — tuweb.dev" description={intro}>
	<div class="flex min-h-screen flex-col">
		<div class="px-5 py-10 sm:px-6 lg:px-8">
			<div class="mx-auto flex w-full max-w-5xl flex-col gap-8">
				<BackLink />

				<div class="flex flex-col gap-3">
					<h1 class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-pixel text-2xl leading-tight font-normal sm:gap-x-3 sm:text-3xl">
						<Icon name="layout-grid" class="size-5 shrink-0 text-accent sm:size-6" />
						Todo en un sitio
						<span class="text-lg tabular-nums text-muted">{SECTIONS.length}</span>
					</h1>
					<p class="max-w-[62ch] text-sm text-pretty text-muted">{intro}</p>
				</div>

				<SectionGrid />
			</div>
		</div>

		<div class="grow"></div>

		<Footer />
	</div>
</Layout>
