---
/**
 * El índice de la portada, por apartados: juegos por un lado, herramientas por
 * otro, y lo demás en su sitio. Arriba, la fila de apartados para saltar al que
 * interese; cada bloque enseña sus tarjetas y enlaza a su página, que es la
 * misma lista a solas. La portada solo enseña puertas: no carga el JS de nada.
 */
import { GROUPS, groupHref, sectionsOf } from '../lib/sections';
import GroupNav from './GroupNav.astro';
import Icon from './Icon.astro';
import SectionCards from './SectionCards.astro';
import SectionLabel from './SectionLabel.astro';
---

<section id="secciones" class="flex flex-col gap-10" aria-labelledby="label-app">
	<div class="flex flex-col gap-3">
		<SectionLabel forId="label-app">Y ESTO ES LO QUE YA FUNCIONA</SectionLabel>
		<p class="max-w-[62ch] text-sm text-muted">
			Repartido en {GROUPS.length} apartados. Cada sección tiene su página: entras en la que te interese
			y no cargas el resto.
		</p>
		<GroupNav anchors />
	</div>

	{
		GROUPS.map((group) => (
			<section
				id={`grupo-${group.id}`}
				class="flex scroll-mt-6 flex-col gap-4"
				aria-labelledby={`titulo-${group.id}`}
			>
				<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-line pb-3">
					<h2 id={`titulo-${group.id}`} class="flex items-center gap-2.5 font-pixel text-lg font-normal">
						<Icon name={group.icon} class="size-5 shrink-0 text-accent" />
						{group.title}
						<span class="text-sm tabular-nums text-muted">{sectionsOf(group.id).length}</span>
					</h2>
					<a
						href={groupHref(group.id)}
						class="inline-flex items-center gap-2 text-sm text-accent hover:underline"
					>
						Ver solo este apartado
						<Icon name="arrow-right" class="size-4 shrink-0" />
					</a>
				</div>

				<p class="max-w-[62ch] text-sm text-muted">{group.card}</p>

				<SectionCards sections={sectionsOf(group.id)} />
			</section>
		))
	}
</section>

<script>
	/*
	 * Los enlaces de antes apuntaban todos a la portada: tuweb.dev/#regex,
	 * tuweb.dev/#chat. Ahora cada sección tiene su página, así que esos hashes se
	 * mandan a su sitio. Con replace, para no dejar la portada en el historial.
	 */
	const VIEJOS: Record<string, string> = {
		herramientas: '/herramientas',
		'json-yaml': '/herramientas#json-yaml',
		cron: '/herramientas#cron',
		regex: '/herramientas#regex',
		colores: '/herramientas#colores',
		patrones: '/herramientas#patrones',
		tema: '/herramientas#tema',
		config: '/herramientas#config',
		minijuego: '/minijuego',
		escaparate: '/escaparate',
		chat: '/chat',
		anonimo: '/anonimo',
	};

	function hash() {
		// Un hash mal escrito (%) revienta el decode: mejor el crudo que nada.
		try {
			return decodeURIComponent(location.hash.slice(1));
		} catch {
			return location.hash.slice(1);
		}
	}

	const destino = VIEJOS[hash()];
	if (destino) location.replace(destino);
</script>
