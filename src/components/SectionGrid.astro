---
/**
 * El índice entero de la web, ahora en su propia página: /todo. Antes esto iba
 * en la portada y soltaba las veintitantas tarjetas de golpe; la portada ahora
 * solo enseña el botón que trae aquí.
 *
 * Salen todos los apartados con sus tarjetas y, arriba, un buscador que filtra
 * por nombre, por la línea de la tarjeta o por el apartado. Filtrar es esconder
 * tarjetas que ya están puestas: no se carga el JS de ninguna sección.
 */
import { GROUPS, SECTIONS, groupHref, sectionsOf } from '../lib/sections';
import GroupNav from './GroupNav.astro';
import Icon from './Icon.astro';
import SectionCards from './SectionCards.astro';
---

<div class="flex flex-col gap-10">
	<div class="flex flex-col gap-4">
		<label class="flex flex-col gap-2">
			<span class="text-sm text-muted">Buscar</span>
			<span class="flex items-center gap-3 border border-line bg-panel px-4 focus-within:border-accent">
				<Icon name="search" class="size-4 shrink-0 text-muted" />
				<input
					type="search"
					data-buscador
					placeholder="regex, chistes, ranking…"
					autocomplete="off"
					spellcheck="false"
					class="w-full bg-transparent py-3 text-sm outline-none"
				/>
			</span>
		</label>

		<p data-cuenta aria-live="polite" class="text-sm text-muted">
			Las {SECTIONS.length} secciones, repartidas en {GROUPS.length} apartados.
		</p>

		<GroupNav anchors />
	</div>

	{
		GROUPS.map((group) => (
			<section
				id={`grupo-${group.id}`}
				data-grupo
				class="flex scroll-mt-6 flex-col gap-4"
				aria-labelledby={`titulo-${group.id}`}
			>
				<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-line pb-3">
					<h2 id={`titulo-${group.id}`} class="flex items-center gap-2.5 font-pixel text-lg font-normal">
						<Icon name={group.icon} class="size-5 shrink-0 text-accent" />
						{group.title}
						<span data-cuenta-grupo class="text-sm tabular-nums text-muted">
							{sectionsOf(group.id).length}
						</span>
					</h2>
					<a
						href={groupHref(group.id)}
						class="inline-flex items-center gap-2 text-sm text-accent hover:underline"
					>
						Ver solo este apartado
						<Icon name="arrow-right" class="size-4 shrink-0" />
					</a>
				</div>

				<p class="max-w-[62ch] text-sm text-muted">{group.card}</p>

				<SectionCards sections={sectionsOf(group.id)} />
			</section>
		))
	}

	<p data-vacio hidden class="text-sm text-mark">
		Nada se llama así. Prueba con otra palabra o borra la búsqueda.
	</p>
</div>

<script>
	const buscador = document.querySelector<HTMLInputElement>('[data-buscador]');
	const tarjetas = document.querySelectorAll<HTMLElement>('[data-buscar]');
	const grupos = document.querySelectorAll<HTMLElement>('[data-grupo]');
	const cuenta = document.querySelector<HTMLElement>('[data-cuenta]');
	const vacio = document.querySelector<HTMLElement>('[data-vacio]');

	// Se busca sin acentos y sin mayúsculas: «diseno» encuentra «Diseño».
	function llano(texto: string) {
		return texto
			.toLowerCase()
			.normalize('NFD')
			.replace(/\p{Diacritic}/gu, '');
	}

	function filtrar() {
		const busca = llano(buscador?.value.trim() ?? '');
		let visibles = 0;

		tarjetas.forEach((tarjeta) => {
			const cabe = busca === '' || llano(tarjeta.dataset.buscar ?? '').includes(busca);
			tarjeta.hidden = !cabe;
			if (cabe) visibles += 1;
		});

		grupos.forEach((grupo) => {
			const quedan = grupo.querySelectorAll('[data-buscar]:not([hidden])').length;
			grupo.hidden = quedan === 0;
			const marcador = grupo.querySelector('[data-cuenta-grupo]');
			if (marcador) marcador.textContent = String(quedan);
		});

		if (vacio) vacio.hidden = visibles > 0;
		if (cuenta) {
			cuenta.textContent =
				busca === ''
					? `Las ${tarjetas.length} secciones, repartidas en ${grupos.length} apartados.`
					: visibles === 1
						? '1 sección con esa palabra.'
						: `${visibles} secciones con esa palabra.`;
		}
	}

	buscador?.addEventListener('input', filtrar);

	// Escape limpia la búsqueda, como en cualquier campo de buscar.
	buscador?.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape' || !buscador.value) return;
		buscador.value = '';
		filtrar();
	});

	// Al volver atrás el navegador restaura lo escrito, así que se filtra al entrar.
	filtrar();
</script>
