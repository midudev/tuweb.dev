---
/**
 * El taller de prompts: se arma un prompt combinando piezas (rol, tono,
 * formato y reglas), se guarda con etiquetas y se vota. Los mejores suben.
 *
 * La biblioteca vive en tu navegador y se pasa a otras personas con un
 * enlace que lleva el prompt dentro, votos incluidos. No se envía nada.
 */
import { FORMATS, MAX_TEXT, MAX_TITLE, ROLES, RULES, TONES } from '../lib/prompt-lab';
import Icon from './Icon.astro';

const BOTON =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent';
const FICHA =
	'border border-line px-3 py-1.5 text-xs text-muted hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent';
const CAMPO = 'w-full border border-line bg-panel p-3 text-sm outline-none focus-visible:border-accent';

const GRUPOS = [
	{ id: 'role', label: 'Rol', items: ROLES },
	{ id: 'tone', label: 'Tono', items: TONES },
	{ id: 'format', label: 'Formato', items: FORMATS },
];
---

<div
	role="tabpanel"
	id="prompts-ia"
	aria-labelledby="tab-prompts-ia"
	data-panel="prompts-ia"
	hidden
	class="flex flex-col gap-8"
>
	<div class="grid gap-6 lg:grid-cols-2 lg:items-start">
		<div class="flex flex-col gap-5">
			<label class="flex flex-col gap-2">
				<span class="inline-flex items-center gap-2 text-sm text-muted">
					<Icon name="sparkles" class="size-4 shrink-0 text-accent" />
					Qué le pides a la IA
				</span>
				<textarea
					data-pl-goal
					rows="3"
					spellcheck="false"
					maxlength={MAX_TEXT}
					placeholder="Ej.: Resume este hilo de correos y dime qué tengo que contestar"
					class={`${CAMPO} resize-y`}></textarea>
			</label>

			{
				GRUPOS.map((grupo) => (
					<div class="flex flex-col gap-2">
						<span class="text-sm text-muted">{grupo.label}</span>
						<div class="flex flex-wrap gap-2" role="group" aria-label={grupo.label}>
							{grupo.items.map((item) => (
								<button type="button" data-pl-piece={grupo.id} data-pl-id={item.id} aria-pressed="false" class={FICHA}>
									{item.label}
								</button>
							))}
						</div>
					</div>
				))
			}

			<div class="flex flex-col gap-2">
				<span class="text-sm text-muted">Reglas</span>
				<div class="flex flex-wrap gap-x-5 gap-y-2">
					{
						RULES.map((rule) => (
							<label class="inline-flex items-center gap-2 text-sm text-muted">
								<input type="checkbox" data-pl-rule={rule.id} class="size-4 accent-accent" />
								{rule.label}
							</label>
						))
					}
				</div>
			</div>
		</div>

		<div class="flex flex-col gap-3">
			<div class="flex flex-wrap items-center justify-between gap-3 text-sm text-muted">
				<span class="inline-flex items-center gap-2">
					<Icon name="message-chatbot" class="size-4 shrink-0 text-accent" />
					Tu prompt
				</span>
				<span data-pl-count class="text-mark"></span>
			</div>
			<textarea
				data-pl-output
				rows="12"
				spellcheck="false"
				maxlength={MAX_TEXT}
				aria-label="Prompt"
				placeholder="Escribe qué le pides y elige piezas: el prompt sale aquí."
				class={`${CAMPO} resize-y p-4 text-mark`}></textarea>
			<p class="text-sm text-muted">Retócalo a mano si quieres. Si tocas las piezas, se vuelve a armar.</p>

			<div class="grid gap-3 sm:grid-cols-2">
				<label class="flex flex-col gap-2">
					<span class="text-sm text-muted">Título</span>
					<input type="text" data-pl-title maxlength={MAX_TITLE} autocomplete="off" class={CAMPO} />
				</label>
				<label class="flex flex-col gap-2">
					<span class="text-sm text-muted">Etiquetas, separadas por comas</span>
					<input type="text" data-pl-tags autocomplete="off" placeholder="código, git" class={CAMPO} />
				</label>
			</div>

			<div class="flex flex-wrap items-center gap-3">
				<button type="button" data-pl-save class={`${BOTON} border-accent text-accent`}>
					<Icon name="device-floppy" class="size-4 shrink-0" />
					Guardar en la biblioteca
				</button>
				<button type="button" data-pl-copy-main class={BOTON}>
					<Icon name="copy" class="size-4 shrink-0" />
					Copiar
				</button>
				<span data-pl-status class="text-sm text-mark" aria-live="polite"></span>
			</div>
		</div>
	</div>

	<div data-pl-incoming hidden class="flex flex-col gap-3 border border-accent bg-panel p-4">
		<span class="inline-flex items-center gap-2 text-sm text-accent">
			<Icon name="share" class="size-4 shrink-0" />
			Te han pasado un prompt: <strong data-pl-incoming-title class="text-fg"></strong>
		</span>
		<pre data-pl-incoming-text class="max-h-40 overflow-auto text-sm whitespace-pre-wrap text-muted"></pre>
		<div class="flex flex-wrap gap-3">
			<button type="button" data-pl-incoming-save class={`${BOTON} border-accent text-accent`}>
				<Icon name="download" class="size-4 shrink-0" />
				Guardarlo en mi biblioteca
			</button>
			<button type="button" data-pl-incoming-skip class={BOTON}>Descartar</button>
		</div>
	</div>

	<div class="flex flex-col gap-4">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<span class="inline-flex items-center gap-2 text-sm text-muted">
				<Icon name="users" class="size-4 shrink-0 text-accent" />
				Biblioteca <span data-pl-total class="text-mark"></span>
			</span>
			<div class="flex flex-wrap gap-2" role="group" aria-label="Orden">
				<button type="button" data-pl-sort="votos" aria-pressed="true" class={FICHA}>Más votados</button>
				<button type="button" data-pl-sort="recientes" aria-pressed="false" class={FICHA}>Recientes</button>
			</div>
		</div>
		<input type="search" data-pl-search autocomplete="off" placeholder="Buscar en títulos, textos y etiquetas" aria-label="Buscar prompts" class={CAMPO} />
		<div data-pl-tagbar class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por etiqueta"></div>
		<div data-pl-list class="grid gap-4 md:grid-cols-2"></div>
		<p data-pl-empty hidden class="text-sm text-muted">Nada por aquí con ese filtro.</p>
		<p class="text-sm text-muted">
			Tu biblioteca y tus votos se quedan en tu navegador, un voto por prompt. Para que otra persona
			lo tenga, pásale el enlace de Compartir: el prompt viaja dentro con sus etiquetas y sus votos.
		</p>
	</div>

	<template data-pl-template>
		<article class="flex flex-col gap-3 border border-line bg-panel p-4">
			<div class="flex items-start justify-between gap-3">
				<h3 data-pl-entry-title class="text-fg"></h3>
				<div class="flex shrink-0 items-center gap-1">
					<button type="button" data-pl-vote="1" aria-pressed="false" aria-label="Votar a favor" class="p-1 text-muted hover:text-accent aria-pressed:text-accent">
						<Icon name="thumb-up" class="size-4" />
					</button>
					<span data-pl-score class="min-w-6 text-center text-sm text-mark"></span>
					<button type="button" data-pl-vote="-1" aria-pressed="false" aria-label="Votar en contra" class="p-1 text-muted hover:text-heart aria-pressed:text-heart">
						<Icon name="thumb-down" class="size-4" />
					</button>
				</div>
			</div>
			<pre data-pl-entry-text class="max-h-40 overflow-auto text-sm whitespace-pre-wrap text-muted"></pre>
			<div data-pl-entry-tags class="flex flex-wrap gap-2 empty:hidden"></div>
			<div class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
				<button type="button" data-pl-act="usar" class="inline-flex items-center gap-1 text-accent hover:underline">
					<Icon name="pencil" class="size-4 shrink-0" />Usar
				</button>
				<button type="button" data-pl-act="copiar" class="inline-flex items-center gap-1 text-accent hover:underline">
					<Icon name="copy" class="size-4 shrink-0" />Copiar
				</button>
				<button type="button" data-pl-act="compartir" class="inline-flex items-center gap-1 text-accent hover:underline">
					<Icon name="link" class="size-4 shrink-0" />Compartir
				</button>
				<button type="button" data-pl-act="borrar" class="inline-flex items-center gap-1 text-muted hover:text-heart">
					<Icon name="trash" class="size-4 shrink-0" />Borrar
				</button>
			</div>
		</article>
	</template>
</div>

<script>
	import {
		KEY,
		SHARE_PARAM,
		buildCombo,
		cleanTags,
		decodeShare,
		encodeShare,
		makeEntry,
		readLibrary,
		saveLibrary,
		score,
		type Combo,
		type Entry,
		type RuleId,
	} from '../lib/prompt-lab';

	const panel = document.querySelector<HTMLElement>('[data-panel="prompts-ia"]');
	const goal = panel?.querySelector<HTMLTextAreaElement>('[data-pl-goal]');
	const output = panel?.querySelector<HTMLTextAreaElement>('[data-pl-output]');
	const title = panel?.querySelector<HTMLInputElement>('[data-pl-title]');
	const tagsInput = panel?.querySelector<HTMLInputElement>('[data-pl-tags]');
	const list = panel?.querySelector<HTMLElement>('[data-pl-list]');
	const template = panel?.querySelector<HTMLTemplateElement>('[data-pl-template]');

	if (panel && goal && output && title && tagsInput && list && template) {
		const pieces = panel.querySelectorAll<HTMLButtonElement>('[data-pl-piece]');
		const rules = panel.querySelectorAll<HTMLInputElement>('[data-pl-rule]');
		const sorts = panel.querySelectorAll<HTMLButtonElement>('[data-pl-sort]');
		const search = panel.querySelector<HTMLInputElement>('[data-pl-search]');
		const tagbar = panel.querySelector<HTMLElement>('[data-pl-tagbar]');
		const status = panel.querySelector<HTMLElement>('[data-pl-status]');
		const count = panel.querySelector<HTMLElement>('[data-pl-count]');
		const total = panel.querySelector<HTMLElement>('[data-pl-total]');
		const empty = panel.querySelector<HTMLElement>('[data-pl-empty]');

		const combo: Combo = { role: '', tone: '', format: '', rules: [], goal: '' };
		let library = readLibrary();
		let order: 'votos' | 'recientes' = 'votos';
		let activeTag = '';

		let statusTimer: number | undefined;
		function say(message: string) {
			if (!status) return;
			status.textContent = message;
			clearTimeout(statusTimer);
			statusTimer = window.setTimeout(() => (status.textContent = ''), 2500);
		}

		function countChars() {
			if (count) count.textContent = output.value ? `${output.value.length} caracteres` : '';
		}

		function rebuild() {
			combo.goal = goal.value;
			combo.rules = [...rules].filter((rule) => rule.checked).map((rule) => rule.dataset.plRule as RuleId);
			output.value = buildCombo(combo);
			countChars();
		}

		pieces.forEach((piece) => {
			piece.addEventListener('click', () => {
				const group = piece.dataset.plPiece as 'role' | 'tone' | 'format';
				const id = piece.dataset.plId ?? '';
				// Otro clic en la misma pieza la quita: ninguna es obligatoria.
				combo[group] = combo[group] === id ? '' : id;
				pieces.forEach((other) => {
					if (other.dataset.plPiece === group) {
						other.setAttribute('aria-pressed', String(other.dataset.plId === combo[group]));
					}
				});
				rebuild();
			});
		});
		rules.forEach((rule) => rule.addEventListener('change', rebuild));
		goal.addEventListener('input', rebuild);
		output.addEventListener('input', countChars);

		async function copy(text: string) {
			try {
				await navigator.clipboard.writeText(text);
				return true;
			} catch {
				// Sin portapapeles (o sin permiso): el truco del textarea de siempre.
				try {
					const field = document.createElement('textarea');
					field.value = text;
					field.readOnly = true;
					field.style.position = 'fixed';
					field.style.opacity = '0';
					document.body.append(field);
					field.select();
					const done = document.execCommand('copy');
					field.remove();
					return done;
				} catch {
					return false;
				}
			}
		}

		function store() {
			if (!saveLibrary(library)) say('No se pudo guardar en este navegador');
		}

		/** Mete un prompt en la biblioteca, salvo que ya esté el mismo texto. */
		function add(entry: Entry) {
			const same = library.find((item) => item.text === entry.text);
			if (same) return false;
			library = [entry, ...library];
			store();
			render();
			return true;
		}

		panel.querySelector('[data-pl-save]')?.addEventListener('click', () => {
			const text = output.value.trim();
			if (!text) {
				say('Primero arma un prompt');
				goal.focus();
				return;
			}
			const fallback = text.split('\n').find((line) => line.trim() && !line.startsWith('Actúa como')) ?? text;
			const entry = makeEntry(title.value || fallback.slice(0, 50), text, cleanTags(tagsInput.value));
			say(add(entry) ? 'Guardado' : 'Ese prompt ya está en tu biblioteca');
		});

		panel.querySelector('[data-pl-copy-main]')?.addEventListener('click', async () => {
			if (!output.value) return say('Todavía no hay prompt');
			say((await copy(output.value)) ? 'Copiado' : 'No se pudo copiar');
		});

		function tagChip(tag: string, pressed: boolean) {
			const chip = document.createElement('button');
			chip.type = 'button';
			chip.className =
				'border border-line px-2 py-1 text-xs text-muted hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent';
			chip.textContent = `#${tag}`;
			chip.setAttribute('aria-pressed', String(pressed));
			chip.addEventListener('click', () => {
				activeTag = activeTag === tag ? '' : tag;
				render();
			});
			return chip;
		}

		function renderTagbar() {
			if (!tagbar) return;
			const counts = new Map<string, number>();
			library.forEach((entry) => entry.tags.forEach((tag) => counts.set(tag, (counts.get(tag) ?? 0) + 1)));
			if (activeTag && !counts.has(activeTag)) activeTag = '';
			const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'es'));
			tagbar.replaceChildren(...tags.map(([tag]) => tagChip(tag, tag === activeTag)));
		}

		function visible() {
			const query = (search?.value ?? '').trim().toLocaleLowerCase('es');
			return library
				.filter((entry) => !activeTag || entry.tags.includes(activeTag))
				.filter(
					(entry) =>
						!query ||
						`${entry.title}\n${entry.text}\n${entry.tags.join(' ')}`.toLocaleLowerCase('es').includes(query),
				)
				.sort((a, b) =>
					order === 'votos' ? score(b) - score(a) || b.created - a.created : b.created - a.created,
				);
		}

		function card(entry: Entry) {
			const node = template.content.firstElementChild?.cloneNode(true) as HTMLElement;
			const field = (name: string) => node.querySelector<HTMLElement>(`[data-pl-${name}]`);

			const titleNode = field('entry-title');
			const textNode = field('entry-text');
			const scoreNode = field('score');
			const tagsNode = field('entry-tags');
			if (titleNode) titleNode.textContent = entry.title;
			if (textNode) textNode.textContent = entry.text;
			if (scoreNode) scoreNode.textContent = String(score(entry));
			tagsNode?.replaceChildren(...entry.tags.map((tag) => tagChip(tag, tag === activeTag)));

			node.querySelectorAll<HTMLButtonElement>('[data-pl-vote]').forEach((button) => {
				const value = Number(button.dataset.plVote);
				button.setAttribute('aria-pressed', String(entry.vote === value));
				button.addEventListener('click', () => {
					// Un voto por prompt: repetir lo quita, el contrario lo cambia.
					entry.vote = entry.vote === value ? 0 : value;
					store();
					render();
				});
			});

			node.querySelectorAll<HTMLButtonElement>('[data-pl-act]').forEach((button) => {
				const label = button.lastChild;
				const original = label?.textContent ?? '';
				function flash(text: string) {
					if (!label) return;
					label.textContent = text;
					window.setTimeout(() => (label.textContent = original), 2000);
				}

				button.addEventListener('click', async () => {
					const action = button.dataset.plAct;
					if (action === 'usar') {
						output.value = entry.text;
						title.value = entry.title;
						tagsInput.value = entry.tags.join(', ');
						countChars();
						output.focus();
						output.scrollIntoView({ block: 'center' });
					} else if (action === 'copiar') {
						flash((await copy(entry.text)) ? 'Copiado' : 'No se pudo');
					} else if (action === 'compartir') {
						const link = `${location.origin}/herramientas?${SHARE_PARAM}=${encodeShare(entry)}#prompts-ia`;
						flash((await copy(link)) ? 'Enlace copiado' : 'No se pudo');
					} else if (action === 'borrar') {
						library = library.filter((item) => item.id !== entry.id);
						store();
						render();
					}
				});
			});

			return node;
		}

		function render() {
			renderTagbar();
			const entries = visible();
			list.replaceChildren(...entries.map(card));
			if (empty) empty.hidden = entries.length > 0;
			if (total) total.textContent = `· ${library.length}`;
			sorts.forEach((sort) => sort.setAttribute('aria-pressed', String(sort.dataset.plSort === order)));
		}

		sorts.forEach((sort) => {
			sort.addEventListener('click', () => {
				order = sort.dataset.plSort === 'recientes' ? 'recientes' : 'votos';
				render();
			});
		});
		search?.addEventListener('input', render);

		// Otra pestaña ha guardado o votado: se recoge sin recargar.
		window.addEventListener('storage', (event) => {
			if (event.key !== KEY) return;
			library = readLibrary();
			render();
		});

		// Si se entra con un enlace compartido, se enseña antes de guardar nada.
		const incoming = panel.querySelector<HTMLElement>('[data-pl-incoming]');
		const code = new URLSearchParams(location.search).get(SHARE_PARAM);
		const shared = code ? decodeShare(code) : null;

		function closeIncoming() {
			if (incoming) incoming.hidden = true;
			history.replaceState(null, '', `${location.pathname}${location.hash}`);
		}

		if (incoming && shared) {
			const sharedTitle = incoming.querySelector('[data-pl-incoming-title]');
			const sharedText = incoming.querySelector('[data-pl-incoming-text]');
			if (sharedTitle) sharedTitle.textContent = shared.title;
			if (sharedText) sharedText.textContent = shared.text;
			incoming.hidden = false;

			incoming.querySelector('[data-pl-incoming-save]')?.addEventListener('click', () => {
				say(add(shared) ? 'Guardado en tu biblioteca' : 'Ese prompt ya lo tenías');
				closeIncoming();
			});
			incoming.querySelector('[data-pl-incoming-skip]')?.addEventListener('click', closeIncoming);
		}

		render();
	}
</script>
