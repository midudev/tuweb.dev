---
/**
 * Diseñador de tartas: cada porción con su etiqueta, su valor y su color, y
 * unos mandos para la forma. El SVG se rehace a cada tecla y se baja en SVG o
 * PNG. Todo se pinta en el navegador; no se guarda ni se envía nada.
 */
import { MAX_SLICES } from '../lib/pie';
import Icon from './Icon.astro';

const OPCION =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent disabled:opacity-40';
const CAMPO = 'w-full border border-line bg-panel px-3 py-2 text-sm outline-none focus-visible:border-accent';

const ETIQUETAS = [
	{ id: 'porcentaje', label: 'Porcentaje', icon: 'percentage' },
	{ id: 'valor', label: 'Valor', icon: 'number' },
	{ id: 'nada', label: 'Sin etiqueta', icon: 'eye-off' },
];
const ORDENES = [
	{ id: 'libre', label: 'Como las escribo', icon: 'arrows-sort' },
	{ id: 'mayor', label: 'De mayor a menor', icon: 'sort-descending' },
];
---

<div role="tabpanel" id="tarta" aria-labelledby="tab-tarta" data-panel="tarta" hidden class="grid gap-7 md:grid-cols-2">
	<div class="flex min-w-0 flex-col gap-6">
		<div class="grid gap-3 sm:grid-cols-[1fr_8rem]">
			<label class="flex flex-col gap-1">
				<span class="text-sm text-muted">Título</span>
				<input type="text" data-pie-texto="title" maxlength="80" class={CAMPO} />
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm text-muted">Unidad</span>
				<input type="text" data-pie-texto="unit" maxlength="8" placeholder="€, h, kg…" class={CAMPO} />
			</label>
		</div>

		<div class="flex flex-col gap-3">
			<h3 id="pie-etiquetas" class="text-sm text-muted">En cada porción</h3>
			<div role="group" aria-labelledby="pie-etiquetas" class="flex flex-wrap gap-2">
				{
					ETIQUETAS.map((o) => (
						<button type="button" data-pie-etiquetas={o.id} aria-pressed="false" class={OPCION}>
							<Icon name={o.icon} class="size-4 shrink-0" />
							{o.label}
						</button>
					))
				}
			</div>
		</div>

		<div class="flex flex-col gap-3">
			<h3 id="pie-orden" class="text-sm text-muted">Orden</h3>
			<div role="group" aria-labelledby="pie-orden" class="flex flex-wrap gap-2">
				{
					ORDENES.map((o) => (
						<button type="button" data-pie-orden={o.id} aria-pressed="false" class={OPCION}>
							<Icon name={o.icon} class="size-4 shrink-0" />
							{o.label}
						</button>
					))
				}
			</div>
		</div>

		<div class="grid gap-4 sm:grid-cols-2">
			<label class="flex flex-col gap-2">
				<span class="flex justify-between text-sm text-muted">
					Hueco central
					<output data-pie-rango-valor="hole" class="text-mark"></output>
				</span>
				<input type="range" data-pie-rango="hole" min="0" max="80" step="5" class="w-full accent-accent" />
			</label>
			<label class="flex flex-col gap-2">
				<span class="flex justify-between text-sm text-muted">
					Separación
					<output data-pie-rango-valor="gap" class="text-mark"></output>
				</span>
				<input type="range" data-pie-rango="gap" min="0" max="12" step="1" class="w-full accent-accent" />
			</label>
		</div>

		<div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
			<label class="inline-flex items-center gap-2">
				<input type="checkbox" data-pie-leyenda class="size-4 accent-accent" />
				Leyenda
			</label>
			<label class="inline-flex items-center gap-2">
				<input type="checkbox" data-pie-oscuro class="size-4 accent-accent" />
				Fondo oscuro
			</label>
		</div>

		<div class="flex flex-col gap-3">
			<h3 class="text-sm text-muted">Porciones</h3>
			<ol data-pie-lista class="flex flex-col gap-2"></ol>
			<div class="flex flex-wrap items-center gap-2">
				<button type="button" data-pie-nueva class={OPCION}>
					<Icon name="plus" class="size-4 shrink-0" />
					Porción
				</button>
				<button type="button" data-pie-paleta class={OPCION}>
					<Icon name="palette" class="size-4 shrink-0" />
					Paleta
				</button>
			</div>
		</div>
	</div>

	<div class="flex min-w-0 flex-col gap-4 md:sticky md:top-6 md:self-start">
		<span class="text-sm text-muted">Así queda</span>
		<div data-pie-previo class="border border-line [&>svg]:block [&>svg]:h-auto [&>svg]:w-full"></div>
		<p class="flex min-h-6 items-center gap-2 text-sm" aria-live="polite">
			<Icon name="pointer" class="size-4 shrink-0 text-muted" />
			<output data-pie-dato class="text-mark">Pasa por una porción para ver su valor; púlsala para editarla.</output>
		</p>
		<div class="flex flex-wrap items-center gap-2">
			<button type="button" data-pie-baja="svg" class={OPCION}>
				<Icon name="file-type-svg" class="size-4 shrink-0" />
				Descargar .svg
			</button>
			<button type="button" data-pie-baja="png" class={OPCION}>
				<Icon name="file-type-png" class="size-4 shrink-0" />
				Descargar .png
			</button>
		</div>
		<p data-pie-aviso class="text-sm text-muted empty:hidden" aria-live="polite"></p>
		<p class="text-sm text-muted">
			Hasta {MAX_SLICES} porciones. Decimales con coma; los ceros y negativos no entran en la tarta. Con el teclado, Tab
			recorre las porciones.
		</p>
	</div>

	<template data-pie-icono><Icon name="x" class="size-4 shrink-0" /></template>
</div>

<style>
	/* El SVG entra con innerHTML, así que sus reglas van sin el ámbito del componente. */
	[data-pie-previo] :global(path[data-porcion]) {
		cursor: pointer;
		outline: none;
		transition: opacity 150ms;
	}
	/* La porción señalada se queda y las demás se apagan. */
	[data-pie-previo] :global(svg:has(path[data-porcion]:is(:hover, :focus-visible)) path[data-porcion]:not(:hover, :focus-visible)) {
		opacity: 0.35;
	}
	[data-pie-previo] :global(path[data-porcion]:focus-visible) {
		stroke: var(--color-fg);
		stroke-width: 2;
	}
	@media (prefers-reduced-motion: reduce) {
		[data-pie-previo] :global(path[data-porcion]) {
			transition: none;
		}
	}
</style>

<script>
	import { DEFAULT_TARTA, MAX_SLICES, buildPie, type Etiquetas, type Orden, type Tarta } from '../lib/pie';
	import { PALETTE, type Theme } from '../lib/chart';

	const previo = document.querySelector<HTMLElement>('[data-pie-previo]');
	const lista = document.querySelector<HTMLOListElement>('[data-pie-lista]');
	const aviso = document.querySelector<HTMLElement>('[data-pie-aviso]');
	const leyenda = document.querySelector<HTMLInputElement>('[data-pie-leyenda]');
	const oscuro = document.querySelector<HTMLInputElement>('[data-pie-oscuro]');
	const nueva = document.querySelector<HTMLButtonElement>('[data-pie-nueva]');
	const icono = document.querySelector<HTMLTemplateElement>('[data-pie-icono]');

	const CAMPO = 'min-w-0 border border-line bg-panel px-2 py-1 text-sm outline-none focus-visible:border-accent';

	type Texto = 'title' | 'unit';
	type Rango = 'hole' | 'gap';
	const SUFIJO: Record<Rango, string> = { hole: ' %', gap: ' px' };

	let tarta: Tarta = structuredClone(DEFAULT_TARTA);
	// Arranca con el fondo de la web: quien la lee de noche, se la encuentra oscura.
	if (document.documentElement.dataset.modo === 'oscuro') tarta = recolorea(tarta, 'oscuro');

	/** Los colores de la paleta pasan a su paso del otro fondo; los elegidos a mano se quedan. */
	function recolorea(d: Tarta, theme: Theme): Tarta {
		const paso = (color: string) => {
			const i = PALETTE[d.theme].indexOf(color);
			return i >= 0 ? PALETTE[theme][i] : color;
		};
		return { ...d, theme, slices: d.slices.map((s) => ({ ...s, color: paso(s.color) })) };
	}

	function campo(type: string, value: string, data: Record<string, string>, label: string) {
		const input = document.createElement('input');
		input.type = type;
		input.value = value;
		input.setAttribute('aria-label', label);
		Object.assign(input.dataset, data);
		return input;
	}

	/** La lista se rehace solo cuando cambia su forma; al escribir, se toca el estado y ya. */
	function pintaLista() {
		if (!lista) return;
		lista.replaceChildren(
			...tarta.slices.map((porcion, i) => {
				const li = document.createElement('li');
				li.className = 'flex items-center gap-2';
				const color = campo('color', porcion.color, { pieColor: String(i) }, `Color de la porción ${i + 1}`);
				color.className = 'h-8 w-9 shrink-0 cursor-pointer border border-line bg-panel p-0.5';
				const etiqueta = campo('text', porcion.label, { pieEtiqueta: String(i) }, `Etiqueta de la porción ${i + 1}`);
				etiqueta.maxLength = 40;
				etiqueta.className = `${CAMPO} flex-1`;
				const valor = campo('text', porcion.value, { pieValor: String(i) }, `Valor de la porción ${i + 1}`);
				valor.maxLength = 20;
				valor.inputMode = 'decimal';
				valor.className = `${CAMPO} w-24 text-right`;
				const quitar = document.createElement('button');
				quitar.type = 'button';
				quitar.className = 'inline-flex shrink-0 items-center p-1 text-muted hover:text-accent disabled:opacity-30';
				quitar.disabled = tarta.slices.length <= 1;
				quitar.title = 'Quitar porción';
				quitar.setAttribute('aria-label', 'Quitar porción');
				quitar.dataset.pieQuita = String(i);
				if (icono) quitar.append(icono.content.cloneNode(true));
				li.append(color, etiqueta, valor, quitar);
				return li;
			}),
		);
		if (nueva) nueva.disabled = tarta.slices.length >= MAX_SLICES;
	}

	function pintaControles() {
		document.querySelectorAll<HTMLButtonElement>('[data-pie-etiquetas]').forEach((b) => {
			b.setAttribute('aria-pressed', String(b.dataset.pieEtiquetas === tarta.labels));
		});
		document.querySelectorAll<HTMLButtonElement>('[data-pie-orden]').forEach((b) => {
			b.setAttribute('aria-pressed', String(b.dataset.pieOrden === tarta.order));
		});
		document.querySelectorAll<HTMLInputElement>('[data-pie-texto]').forEach((input) => {
			input.value = tarta[input.dataset.pieTexto as Texto];
		});
		document.querySelectorAll<HTMLInputElement>('[data-pie-rango]').forEach((input) => {
			input.value = String(tarta[input.dataset.pieRango as Rango]);
		});
		pintaRangos();
		if (leyenda) leyenda.checked = tarta.showLegend;
		if (oscuro) oscuro.checked = tarta.theme === 'oscuro';
	}

	function pintaRangos() {
		document.querySelectorAll<HTMLOutputElement>('[data-pie-rango-valor]').forEach((output) => {
			const rango = output.dataset.pieRangoValor as Rango;
			output.value = `${tarta[rango]}${SUFIJO[rango]}`;
		});
	}

	const dato = document.querySelector<HTMLOutputElement>('[data-pie-dato]');
	const AYUDA = dato?.value ?? '';

	function pinta() {
		if (!previo) return;
		previo.innerHTML = buildPie(tarta).svg;
		// El tabindex solo va en la vista previa: el fichero que se baja sale limpio.
		previo.querySelectorAll('path[data-porcion]').forEach((path) => {
			path.setAttribute('tabindex', '0');
			path.setAttribute('aria-label', path.querySelector('title')?.textContent ?? '');
		});
		if (dato) dato.value = AYUDA;
	}

	const porcionDe = (event: Event) => (event.target as Element).closest?.('path[data-porcion]') ?? null;

	function senala(event: Event) {
		const path = porcionDe(event);
		if (dato) dato.value = path?.querySelector('title')?.textContent ?? AYUDA;
	}

	previo?.addEventListener('pointerover', senala);
	previo?.addEventListener('focusin', senala);
	previo?.addEventListener('pointerleave', () => {
		if (dato && !previo?.contains(document.activeElement)) dato.value = AYUDA;
	});
	previo?.addEventListener('focusout', () => {
		if (dato) dato.value = AYUDA;
	});

	function edita(event: Event) {
		const path = porcionDe(event);
		if (!path) return;
		const campo = lista?.querySelector<HTMLInputElement>(`[data-pie-valor="${path.getAttribute('data-porcion')}"]`);
		campo?.focus();
		campo?.select();
	}

	previo?.addEventListener('click', edita);
	previo?.addEventListener('keydown', (event) => {
		if (event.key !== 'Enter' && event.key !== ' ') return;
		if (!porcionDe(event)) return;
		event.preventDefault();
		edita(event);
	});

	document.querySelectorAll<HTMLButtonElement>('[data-pie-etiquetas]').forEach((b) => {
		b.addEventListener('click', () => {
			tarta.labels = b.dataset.pieEtiquetas as Etiquetas;
			pintaControles();
			pinta();
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-pie-orden]').forEach((b) => {
		b.addEventListener('click', () => {
			tarta.order = b.dataset.pieOrden as Orden;
			pintaControles();
			pinta();
		});
	});

	document.querySelectorAll<HTMLInputElement>('[data-pie-texto]').forEach((input) => {
		input.addEventListener('input', () => {
			tarta[input.dataset.pieTexto as Texto] = input.value;
			pinta();
		});
	});

	document.querySelectorAll<HTMLInputElement>('[data-pie-rango]').forEach((input) => {
		input.addEventListener('input', () => {
			tarta[input.dataset.pieRango as Rango] = Number(input.value);
			pintaRangos();
			pinta();
		});
	});

	leyenda?.addEventListener('change', () => {
		tarta.showLegend = leyenda.checked;
		pinta();
	});

	oscuro?.addEventListener('change', () => {
		tarta = recolorea(tarta, oscuro.checked ? 'oscuro' : 'claro');
		pintaControles();
		pintaLista();
		pinta();
	});

	lista?.addEventListener('input', (event) => {
		const input = event.target as HTMLInputElement;
		const { pieColor, pieEtiqueta, pieValor } = input.dataset;
		if (pieColor) tarta.slices[Number(pieColor)].color = input.value;
		else if (pieEtiqueta) tarta.slices[Number(pieEtiqueta)].label = input.value;
		else if (pieValor) tarta.slices[Number(pieValor)].value = input.value;
		else return;
		pinta();
	});

	lista?.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-pie-quita]');
		if (!button || button.disabled) return;
		tarta.slices.splice(Number(button.dataset.pieQuita), 1);
		pintaLista();
		pinta();
	});

	nueva?.addEventListener('click', () => {
		if (tarta.slices.length >= MAX_SLICES) return;
		const paleta = PALETTE[tarta.theme];
		const usados = tarta.slices.map((s) => s.color);
		const color = paleta.find((c) => !usados.includes(c)) ?? paleta[tarta.slices.length % paleta.length];
		tarta.slices.push({ label: `Porción ${tarta.slices.length + 1}`, value: '', color });
		pintaLista();
		pinta();
		lista?.querySelector<HTMLInputElement>('li:last-child input[type="text"]')?.select();
	});

	document.querySelector('[data-pie-paleta]')?.addEventListener('click', () => {
		const paleta = PALETTE[tarta.theme];
		tarta.slices.forEach((s, i) => (s.color = paleta[i % paleta.length]));
		pintaLista();
		pinta();
	});

	function nombre(extension: string) {
		const base = tarta.title
			.normalize('NFD')
			.replace(/[̀-ͯ]/g, '')
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-|-$/g, '')
			.slice(0, 40);
		return `${base || 'tarta'}.${extension}`;
	}

	function bajar(fichero: Blob, name: string) {
		const url = URL.createObjectURL(fichero);
		const enlace = document.createElement('a');
		enlace.href = url;
		enlace.download = name;
		enlace.click();
		// Soltar la URL en el mismo tick corta la descarga en algún navegador.
		setTimeout(() => URL.revokeObjectURL(url), 1000);
	}

	/* Un SVG pintado como imagen no ve las fuentes de la página: para el PNG van dentro. */
	const FUENTES = [
		['Geist Mono Variable', '/fonts/geist-mono-latin-wght-normal.woff2', '100 900'],
		['Geist Pixel', '/fonts/geist-pixel-latin-400-normal.woff2', '400'],
	];
	let fuentesCss: Promise<string> | null = null;

	function fuentes() {
		fuentesCss ??= Promise.all(
			FUENTES.map(async ([family, url, weight]) => {
				const blob = await (await fetch(url)).blob();
				const data = await new Promise<string>((resolve, reject) => {
					const lector = new FileReader();
					lector.onload = () => resolve(String(lector.result));
					lector.onerror = () => reject(lector.error);
					lector.readAsDataURL(blob);
				});
				return `@font-face{font-family:'${family}';font-weight:${weight};src:url(${data}) format('woff2');}`;
			}),
		)
			.then((reglas) => reglas.join(''))
			.catch(() => '');
		return fuentesCss;
	}

	async function png() {
		const { svg, width, height } = buildPie(tarta, { fontCss: await fuentes() });
		const imagen = new Image();
		imagen.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
		await imagen.decode();
		// Al doble, para que se vea nítido en pantallas densas.
		const lienzo = document.createElement('canvas');
		lienzo.width = width * 2;
		lienzo.height = height * 2;
		lienzo.getContext('2d')?.drawImage(imagen, 0, 0, lienzo.width, lienzo.height);
		const blob = await new Promise<Blob | null>((resolve) => lienzo.toBlob(resolve, 'image/png'));
		if (!blob) throw new Error('sin PNG');
		bajar(blob, nombre('png'));
	}

	document.querySelectorAll<HTMLButtonElement>('[data-pie-baja]').forEach((button) => {
		button.addEventListener('click', async () => {
			if (button.dataset.pieBaja === 'svg') {
				bajar(new Blob([buildPie(tarta).svg], { type: 'image/svg+xml' }), nombre('svg'));
				return;
			}
			button.disabled = true;
			try {
				await png();
				if (aviso) aviso.textContent = '';
			} catch {
				if (aviso) aviso.textContent = 'No se pudo sacar el PNG. Prueba con el SVG.';
			} finally {
				button.disabled = false;
			}
		});
	});

	pintaControles();
	pintaLista();
	pinta();
</script>
