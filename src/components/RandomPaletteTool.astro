---
/**
 * Paletas al azar: eliges cuántos colores quieres y salen combinaciones nuevas
 * a cada clic (o con la barra espaciadora). Los colores que te gustan se fijan
 * con el candado y sobreviven a la siguiente tirada. La paleta se lleva como
 * variables CSS o como PNG, todo hecho en el navegador.
 */
import Icon from './Icon.astro';

const OPCION =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent';
---

<div role="tabpanel" id="paletas-azar" aria-labelledby="tab-paletas-azar" data-panel="paletas-azar" hidden class="flex flex-col gap-6">
	<div class="flex flex-wrap items-end gap-5">
		<label class="flex w-full max-w-xs flex-col gap-1">
			<span class="flex justify-between gap-2 text-sm text-muted">
				<span>Colores</span>
				<output data-azar-cuantos class="text-mark">5</output>
			</span>
			<input type="range" data-azar-rango min="2" max="10" step="1" value="5" class="w-full accent-accent" />
		</label>
		<button type="button" data-azar-tirar class={`${OPCION} border-accent text-accent`}>
			<Icon name="arrows-shuffle" class="size-4 shrink-0" />
			Otra paleta
		</button>
		<span class="text-xs text-muted">O pulsa la barra espaciadora.</span>
	</div>

	<ul data-azar-colores class="flex min-h-48 flex-col border border-line sm:h-64 sm:flex-row"></ul>

	<label class="flex flex-col gap-2">
		<span class="text-sm text-muted">Variables CSS</span>
		<textarea
			data-azar-css
			rows="6"
			readonly
			spellcheck="false"
			class="w-full resize-y border border-line bg-panel p-4 text-sm text-mark outline-none"></textarea>
	</label>

	<div class="flex flex-wrap items-center gap-2">
		<button type="button" data-azar-copia class={OPCION}>
			<Icon name="copy" class="size-4 shrink-0" />
			Copiar CSS
		</button>
		<button type="button" data-azar-baja="css" class={OPCION}>
			<Icon name="file-type-css" class="size-4 shrink-0" />
			Descargar .css
		</button>
		<button type="button" data-azar-baja="png" class={OPCION}>
			<Icon name="file-type-png" class="size-4 shrink-0" />
			Descargar .png
		</button>
		<span data-azar-estado class="text-sm text-muted" aria-live="polite"></span>
	</div>
</div>

<script>
	interface Color {
		hex: string;
		fijo: boolean;
	}

	const lista = document.querySelector<HTMLUListElement>('[data-azar-colores]');
	const rango = document.querySelector<HTMLInputElement>('[data-azar-rango]');
	const cuantos = document.querySelector<HTMLOutputElement>('[data-azar-cuantos]');
	const css = document.querySelector<HTMLTextAreaElement>('[data-azar-css]');
	const estado = document.querySelector<HTMLElement>('[data-azar-estado]');
	const panel = document.querySelector<HTMLElement>('[data-panel="paletas-azar"]');

	let colores: Color[] = [];
	let reloj: number | undefined;

	function hslAHex(h: number, s: number, l: number) {
		const a = s * Math.min(l, 1 - l);
		const canal = (n: number) => {
			const k = (n + h / 30) % 12;
			return Math.round((l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1))) * 255)
				.toString(16)
				.padStart(2, '0');
		};
		return `#${canal(0)}${canal(8)}${canal(4)}`;
	}

	function luminancia(hex: string) {
		const [r, g, b] = [1, 3, 5].map((i) => {
			const c = parseInt(hex.slice(i, i + 2), 16) / 255;
			return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
		});
		return 0.2126 * r + 0.7152 * g + 0.0722 * b;
	}

	/**
	 * Una tirada que combina: un tono de partida y una armonía al azar, y el
	 * brillo repartido de oscuro a claro para que los colores no se pisen.
	 */
	function tirada(n: number) {
		const tono = Math.random() * 360;
		const paso = [25, 137.5, 180 / n, 360 / n][Math.floor(Math.random() * 4)];
		const sat = 0.35 + Math.random() * 0.5;
		return Array.from({ length: n }, (_, i) => {
			const h = (tono + i * paso) % 360;
			const l = 0.18 + (0.66 * (i + 0.5)) / n + (Math.random() - 0.5) * 0.08;
			const s = Math.min(1, Math.max(0.1, sat + (Math.random() - 0.5) * 0.25));
			return hslAHex(h, s, Math.min(0.92, Math.max(0.08, l)));
		});
	}

	function tirar() {
		const nuevos = tirada(colores.length);
		colores = colores.map((color, i) => (color.fijo ? color : { hex: nuevos[i], fijo: false }));
		pintar();
	}

	function ajustar(n: number) {
		if (n < colores.length) colores = colores.slice(0, n);
		else {
			const nuevos = tirada(n);
			colores = [...colores, ...nuevos.slice(colores.length).map((hex) => ({ hex, fijo: false }))];
		}
		pintar();
	}

	function textoCss() {
		return `:root {\n${colores.map((c, i) => `\t--color-${i + 1}: ${c.hex};`).join('\n')}\n}\n`;
	}

	function avisar(texto: string) {
		if (estado) estado.textContent = texto;
		window.clearTimeout(reloj);
		reloj = window.setTimeout(() => {
			if (estado) estado.textContent = '';
		}, 1800);
	}

	async function copiar(texto: string) {
		try {
			await navigator.clipboard.writeText(texto);
			return true;
		} catch {
			return false;
		}
	}

	function pintar() {
		if (!lista) return;
		lista.replaceChildren(
			...colores.map((color, i) => {
				const tinta = luminancia(color.hex) > 0.4 ? '#1a120c' : '#fdf6ef';
				const item = document.createElement('li');
				item.className = 'flex min-h-16 flex-1 items-end justify-between gap-2 p-3 text-sm sm:flex-col sm:items-start';
				item.style.background = color.hex;
				item.style.color = tinta;

				const hex = document.createElement('button');
				hex.type = 'button';
				hex.className = 'hover:underline';
				hex.textContent = color.hex;
				hex.setAttribute('aria-label', `Copiar ${color.hex}`);
				hex.addEventListener('click', async () => {
					avisar((await copiar(color.hex)) ? `Copiado ${color.hex}.` : 'No se pudo copiar.');
				});

				const fijar = document.createElement('button');
				fijar.type = 'button';
				fijar.className = 'border border-current px-2 py-1 text-xs';
				fijar.setAttribute('aria-pressed', String(color.fijo));
				fijar.setAttribute('aria-label', `${color.fijo ? 'Soltar' : 'Fijar'} el color ${i + 1}`);
				fijar.textContent = color.fijo ? 'fijo' : 'fijar';
				fijar.style.opacity = color.fijo ? '1' : '0.7';
				fijar.addEventListener('click', () => {
					color.fijo = !color.fijo;
					pintar();
				});

				item.append(hex, fijar);
				return item;
			}),
		);
		if (cuantos) cuantos.textContent = String(colores.length);
		if (rango) rango.value = String(colores.length);
		if (css) css.value = textoCss();
	}

	function bajar(blob: Blob, nombre: string) {
		const enlace = document.createElement('a');
		enlace.href = URL.createObjectURL(blob);
		enlace.download = nombre;
		document.body.append(enlace);
		enlace.click();
		enlace.remove();
		window.setTimeout(() => URL.revokeObjectURL(enlace.href), 4000);
	}

	function png() {
		const ancho = 240;
		const alto = 320;
		const lienzo = document.createElement('canvas');
		lienzo.width = ancho * colores.length;
		lienzo.height = alto;
		const ctx = lienzo.getContext('2d');
		if (!ctx) return;
		ctx.font = '20px "Geist Mono", monospace';
		ctx.textBaseline = 'bottom';
		colores.forEach((color, i) => {
			ctx.fillStyle = color.hex;
			ctx.fillRect(i * ancho, 0, ancho, alto);
			ctx.fillStyle = luminancia(color.hex) > 0.4 ? '#1a120c' : '#fdf6ef';
			ctx.fillText(color.hex, i * ancho + 20, alto - 20);
		});
		lienzo.toBlob((blob) => {
			if (blob) bajar(blob, `paleta-${colores.length}.png`);
			else avisar('No se pudo crear el PNG.');
		}, 'image/png');
	}

	rango?.addEventListener('input', () => ajustar(Number(rango.value)));

	document.querySelector('[data-azar-tirar]')?.addEventListener('click', tirar);

	document.querySelector('[data-azar-copia]')?.addEventListener('click', async () => {
		avisar((await copiar(textoCss())) ? 'Copiado el CSS.' : 'No se pudo copiar.');
	});

	document.querySelectorAll<HTMLButtonElement>('[data-azar-baja]').forEach((boton) => {
		boton.addEventListener('click', () => {
			if (boton.dataset.azarBaja === 'png') png();
			else bajar(new Blob([textoCss()], { type: 'text/css' }), `paleta-${colores.length}.css`);
		});
	});

	// La barra espaciadora tira otra vez, pero solo con la pestaña a la vista y
	// sin robarle la tecla a un botón, un campo o un rango.
	document.addEventListener('keydown', (evento) => {
		if (evento.code !== 'Space' || !panel || panel.hidden) return;
		const foco = evento.target as HTMLElement | null;
		if (foco?.closest('input, textarea, select, button, a, [contenteditable]')) return;
		evento.preventDefault();
		tirar();
	});

	ajustar(5);
</script>
