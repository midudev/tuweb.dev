---
/**
 * Un minijuego para la espera entre ventanas: la serpiente de toda la vida.
 * Todo pasa en el navegador y nada se guarda en el servidor; el récord y el
 * ranking viven en el localStorage de quien juega.
 */
import Icon from './Icon.astro';

const COLS = 20;
const ROWS = 14;

/** Lo que cabe en una línea del ranking sin romperla. */
const NOMBRE_MAX = 14;

const PAD = [
	{ id: 'up', label: 'Arriba', icon: 'chevron-up', class: 'col-start-2' },
	{ id: 'left', label: 'Izquierda', icon: 'chevron-left', class: 'col-start-1 row-start-2' },
	{ id: 'down', label: 'Abajo', icon: 'chevron-down', class: 'col-start-2 row-start-2' },
	{ id: 'right', label: 'Derecha', icon: 'chevron-right', class: 'col-start-3 row-start-2' },
];

/*
 * Los dos ajustes de siempre: si las paredes matan y a qué ritmo va. Cada
 * combinación guarda su propio récord, que si no no hay quien los compare.
 */
const MODOS = [
	{ id: 'paredes', label: 'Matan', icon: 'border-all' },
	{ id: 'tunel', label: 'Se cruzan', icon: 'arrow-bar-both' },
];

const RITMOS = [
	{ id: 'calma', label: 'Calmada', icon: 'walk' },
	{ id: 'normal', label: 'Normal', icon: 'gauge' },
	{ id: 'nervio', label: 'Nerviosa', icon: 'bolt' },
];

const OPCION =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent';

const BOTON =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent';
---

<section id="minijuego" class="flex flex-col gap-7">
	<div class="flex flex-col gap-6 md:flex-row md:items-start">
		<div class="relative w-full max-w-md shrink-0">
			<div
				data-board
				data-cols={COLS}
				data-rows={ROWS}
				tabindex="0"
				role="application"
				aria-label="Tablero de la serpiente"
				class="grid touch-none gap-px border border-line bg-line select-none"
				style={`grid-template-columns: repeat(${COLS}, minmax(0, 1fr))`}
			>
				{Array.from({ length: COLS * ROWS }, () => <span class="aspect-square bg-panel" />)}
			</div>

			<div
				data-overlay
				class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-2 bg-bg/85 px-6 text-center"
			>
				<p data-overlay-title class="font-pixel text-lg text-accent">Serpiente</p>
				<p data-overlay-text class="text-sm text-muted">Toca el tablero y no te choques.</p>
			</div>
		</div>

		<div class="flex min-w-0 grow flex-col gap-6">
			<dl class="flex flex-col gap-1.5 text-sm">
				<div class="flex items-baseline justify-between gap-3 border-t border-line pt-1.5">
					<dt class="text-muted">puntos</dt>
					<dd data-score class="font-pixel tabular-nums text-accent">0</dd>
				</div>
				<div class="flex items-baseline justify-between gap-3 border-t border-line pt-1.5">
					<dt class="flex items-baseline gap-2 text-muted">
						<Icon name="trophy" class="size-3.5 shrink-0 self-center" />
						récord <span data-best-tag class="text-xs">con paredes · normal</span>
					</dt>
					<dd data-best class="tabular-nums">0</dd>
				</div>
			</dl>

			<form data-firma hidden class="flex flex-col gap-3 border border-accent bg-panel p-4">
				<label class="flex flex-col gap-2">
					<span class="text-sm">
						Se acabó con <span data-firma-puntos class="font-pixel text-accent">0</span> puntos.
						Firma la marca.
					</span>
					<input
						type="text"
						data-firma-nombre
						maxlength={NOMBRE_MAX}
						autocomplete="off"
						spellcheck="false"
						placeholder="Tu nombre"
						class="w-full border border-line bg-bg px-3 py-2 text-sm outline-none focus-visible:border-accent"
					/>
				</label>
				<div class="flex flex-wrap items-center gap-3">
					<button type="submit" class={BOTON}>
						<Icon name="writing-sign" class="size-4 shrink-0" />
						Firmar
					</button>
					<button type="button" data-firma-pasar class={BOTON}>Paso</button>
				</div>
			</form>

			<div class="flex flex-wrap gap-2 text-sm">
				<button
					type="button"
					data-play
					class="inline-flex items-center gap-2 border border-line px-4 py-3 text-muted hover:border-accent hover:text-accent"
				>
					<span data-icon="play" class="inline-flex"><Icon name="player-play" class="size-4" /></span>
					<span data-icon="pause" class="inline-flex"><Icon name="player-pause" class="size-4" /></span>
					<span data-play-label>Jugar</span>
				</button>
				<button
					type="button"
					data-reset
					class="inline-flex items-center gap-2 border border-line px-4 py-3 text-muted hover:border-accent hover:text-accent"
				>
					<Icon name="refresh" class="size-4 shrink-0" />
					Reiniciar
				</button>
			</div>

			<div class="grid w-44 grid-cols-3 gap-2" role="group" aria-label="Dirección">
				{
					PAD.map((key) => (
						<button
							type="button"
							data-pad={key.id}
							aria-label={key.label}
							class:list={[
								'flex items-center justify-center border border-line py-3 text-muted hover:border-accent hover:text-accent',
								key.class,
							]}
						>
							<Icon name={key.icon} class="size-4 shrink-0" />
						</button>
					))
				}
			</div>

			<div class="flex flex-col gap-3">
				<h3 id="serpiente-paredes" class="text-sm text-muted">Paredes</h3>
				<div role="group" aria-labelledby="serpiente-paredes" class="flex flex-wrap gap-2">
					{
						MODOS.map((modo) => (
							<button type="button" data-juego-modo={modo.id} aria-pressed="false" class={OPCION}>
								<Icon name={modo.icon} class="size-4 shrink-0" />
								{modo.label}
							</button>
						))
					}
				</div>
			</div>

			<div class="flex flex-col gap-3">
				<h3 id="serpiente-ritmo" class="text-sm text-muted">Ritmo</h3>
				<div role="group" aria-labelledby="serpiente-ritmo" class="flex flex-wrap gap-2">
					{
						RITMOS.map((ritmo) => (
							<button type="button" data-juego-ritmo={ritmo.id} aria-pressed="false" class={OPCION}>
								<Icon name={ritmo.icon} class="size-4 shrink-0" />
								{ritmo.label}
							</button>
						))
					}
				</div>
				<p class="text-sm text-muted">
					Cada ajuste lleva su récord y su ranking, y se guardan en este navegador. Tocarlos deja el
					tablero a cero.
				</p>
			</div>

			<p data-status class="sr-only" role="status" aria-live="polite"></p>
		</div>
	</div>

	<div class="flex flex-col gap-3">
		<h3 class="flex items-baseline gap-2 text-sm text-muted">
			<Icon name="list-numbers" class="size-3.5 shrink-0 self-center" />
			Ranking <span data-ranking-tag class="text-xs">con paredes · normal</span>
		</h3>

		<ol data-ranking class="flex flex-col gap-1.5 text-sm"></ol>

		<p data-ranking-vacio class="text-sm text-muted">
			Aquí no ha firmado nadie. Pierde una partida y pon tu nombre.
		</p>

		<p data-ranking-aviso hidden class="text-sm text-muted"></p>

		<div>
			<button type="button" data-ranking-vaciar hidden class={BOTON}>
				<Icon name="trash" class="size-4 shrink-0" />
				Vaciar este ranking
			</button>
		</div>

		<template data-fila>
			<li class="flex items-baseline justify-between gap-3 border-t border-line pt-1.5">
				<span class="flex min-w-0 items-baseline gap-3">
					<span data-pos class="tabular-nums text-muted"></span>
					<span data-nombre class="truncate"></span>
				</span>
				<span data-puntos class="font-pixel tabular-nums">0</span>
			</li>
		</template>
	</div>
</section>

<style>
	[data-board] span[data-k='cuerpo'] {
		background: var(--color-accent);
	}

	[data-board] span[data-k='cabeza'] {
		background: var(--color-mark);
	}

	[data-board] span[data-k='comida'] {
		background: var(--color-fg);
	}

	[data-play] [data-icon='pause'] {
		display: none;
	}

	[data-play][data-state='jugando'] [data-icon='play'] {
		display: none;
	}

	[data-play][data-state='jugando'] [data-icon='pause'] {
		display: inline-flex;
	}
</style>

<script>
	const section = document.querySelector<HTMLElement>('#minijuego');
	const board = section?.querySelector<HTMLElement>('[data-board]');

	if (section && board) {
		// El tamaño lo manda el tablero ya pintado: aquí no se adivina.
		const COLS = Number(board.dataset.cols);
		const ROWS = Number(board.dataset.rows);
		// Empieza lenta y se va apretando con cada bocado, hasta un tope.
		const MS_POR_PUNTO = 4;
		// El récord de antes era uno solo; el nuevo va por ajuste.
		const CLAVE_RECORD = 'tuweb:serpiente:record';
		const CLAVE_RECORDS = 'tuweb:serpiente:records';
		const CLAVE_AJUSTES = 'tuweb:serpiente:ajustes';
		// El ranking va por ajuste, como el récord, y recuerda el último nombre.
		const CLAVE_RANKING = 'tuweb:serpiente:ranking';
		const CLAVE_NOMBRE = 'tuweb:serpiente:nombre';
		const NOMBRE_MAX = 14;
		const TOPE = 10;

		type Giro = { x: number; y: number };
		type Estado = 'listo' | 'jugando' | 'pausa' | 'fin';
		type Modo = 'paredes' | 'tunel';
		type Ritmo = 'calma' | 'normal' | 'nervio';
		type Ajustes = { modo: Modo; ritmo: Ritmo };
		type Marca = { nombre: string; puntos: number; fecha: number };

		const RITMOS: Record<Ritmo, { inicial: number; minimo: number; label: string }> = {
			calma: { inicial: 200, minimo: 110, label: 'calmada' },
			normal: { inicial: 150, minimo: 70, label: 'normal' },
			nervio: { inicial: 100, minimo: 50, label: 'nerviosa' },
		};

		const casillas = Array.from(board.children) as HTMLElement[];
		const capa = section.querySelector<HTMLElement>('[data-overlay]');
		const capaTitulo = section.querySelector<HTMLElement>('[data-overlay-title]');
		const capaTexto = section.querySelector<HTMLElement>('[data-overlay-text]');
		const marcador = section.querySelector<HTMLElement>('[data-score]');
		const marcadorRecord = section.querySelector<HTMLElement>('[data-best]');
		const etiquetaRecord = section.querySelector<HTMLElement>('[data-best-tag]');
		const botonJugar = section.querySelector<HTMLButtonElement>('[data-play]');
		const etiquetaJugar = section.querySelector<HTMLElement>('[data-play-label]');
		const aviso = section.querySelector<HTMLElement>('[data-status]');
		const firma = section.querySelector<HTMLFormElement>('[data-firma]');
		const firmaNombre = section.querySelector<HTMLInputElement>('[data-firma-nombre]');
		const firmaPuntos = section.querySelector<HTMLElement>('[data-firma-puntos]');
		const listaRanking = section.querySelector<HTMLElement>('[data-ranking]');
		const rankingVacio = section.querySelector<HTMLElement>('[data-ranking-vacio]');
		const etiquetaRanking = section.querySelector<HTMLElement>('[data-ranking-tag]');
		const avisoRanking = section.querySelector<HTMLElement>('[data-ranking-aviso]');
		const botonVaciar = section.querySelector<HTMLButtonElement>('[data-ranking-vaciar]');
		const plantillaFila = section.querySelector<HTMLTemplateElement>('[data-fila]');

		const GIROS: Record<string, Giro> = {
			arrowup: { x: 0, y: -1 },
			arrowdown: { x: 0, y: 1 },
			arrowleft: { x: -1, y: 0 },
			arrowright: { x: 1, y: 0 },
			w: { x: 0, y: -1 },
			s: { x: 0, y: 1 },
			a: { x: -1, y: 0 },
			d: { x: 1, y: 0 },
			up: { x: 0, y: -1 },
			down: { x: 0, y: 1 },
			left: { x: -1, y: 0 },
			right: { x: 1, y: 0 },
		};

		let estado: Estado = 'listo';
		let serpiente: number[] = [];
		let direccion: Giro = { x: 1, y: 0 };
		let pendientes: Giro[] = [];
		let comida = -1;
		let puntos = 0;
		let temporizador = 0;
		let pintadas: number[] = [];

		function leerAjustes(): Ajustes {
			try {
				const guardado = JSON.parse(localStorage.getItem(CLAVE_AJUSTES) ?? 'null');
				return {
					modo: guardado?.modo === 'tunel' ? 'tunel' : 'paredes',
					ritmo: guardado?.ritmo in RITMOS ? guardado.ritmo : 'normal',
				};
			} catch {
				// Sin almacenamiento (modo privado) o con basura dentro: los de casa.
				return { modo: 'paredes', ritmo: 'normal' };
			}
		}

		function leerRecords(): Record<string, number> {
			try {
				const crudo = localStorage.getItem(CLAVE_RECORDS);
				if (crudo) {
					const limpio: Record<string, number> = {};
					for (const [clave, valor] of Object.entries(JSON.parse(crudo) ?? {})) {
						if (typeof valor === 'number' && Number.isFinite(valor)) limpio[clave] = valor;
					}
					return limpio;
				}
				// Quien ya tenía récord jugaba con paredes y a ritmo normal: ahí se queda.
				const viejo = Number(localStorage.getItem(CLAVE_RECORD)) || 0;
				return viejo > 0 ? { 'paredes:normal': viejo } : {};
			} catch {
				return {};
			}
		}

		/** Del almacén solo sale lo que tiene forma de marca; lo demás se tira. */
		function leerRanking(): Record<string, Marca[]> {
			try {
				const crudo = JSON.parse(localStorage.getItem(CLAVE_RANKING) ?? 'null');
				const limpio: Record<string, Marca[]> = {};
				for (const [clave, marcas] of Object.entries(crudo ?? {})) {
					if (!Array.isArray(marcas)) continue;
					const buenas = marcas
						.filter(
							(marca) => typeof marca?.nombre === 'string' && Number.isFinite(marca?.puntos),
						)
						.map((marca) => ({
							nombre: limpiarNombre(marca.nombre) || 'anónimo',
							puntos: Math.max(0, Math.floor(marca.puntos)),
							fecha: Number.isFinite(marca.fecha) ? Number(marca.fecha) : 0,
						}));
					if (buenas.length > 0) limpio[clave] = ordenar(buenas).slice(0, TOPE);
				}
				return limpio;
			} catch {
				return {};
			}
		}

		function leerNombre(): string {
			try {
				const guardado = JSON.parse(localStorage.getItem(CLAVE_NOMBRE) ?? 'null');
				return typeof guardado === 'string' ? limpiarNombre(guardado) : '';
			} catch {
				return '';
			}
		}

		/** Un nombre es una línea corta: sin saltos, sin dobles espacios y sin sobras. */
		function limpiarNombre(valor: string) {
			return valor.replace(/\s+/g, ' ').trim().slice(0, NOMBRE_MAX).trim();
		}

		/** Más puntos arriba y, en empate, primero quien llegó antes. */
		function ordenar(marcas: Marca[]) {
			return [...marcas].sort((a, b) => b.puntos - a.puntos || a.fecha - b.fecha);
		}

		function guardar(clave: string, valor: unknown) {
			try {
				localStorage.setItem(clave, JSON.stringify(valor));
			} catch {
				// Da igual: el récord es un lujo, no el juego.
			}
		}

		let ajustes = leerAjustes();
		let records = leerRecords();
		let ranking = leerRanking();
		// La última marca firmada, para poder señalarla en la lista.
		let mia: Marca | null = null;
		// Los puntos con los que se abrió la firma; la partida puede seguir sin ella.
		let puntosFirma = 0;
		let velocidad = RITMOS[ajustes.ritmo].inicial;

		function claveRecord() {
			return `${ajustes.modo}:${ajustes.ritmo}`;
		}

		function record() {
			return records[claveRecord()] ?? 0;
		}

		function marcasAhora() {
			return ranking[claveRecord()] ?? [];
		}

		function etiquetaAjuste() {
			const paredes = ajustes.modo === 'tunel' ? 'sin paredes' : 'con paredes';
			return `${paredes} · ${RITMOS[ajustes.ritmo].label}`;
		}

		function pintar() {
			for (const i of pintadas) casillas[i]?.removeAttribute('data-k');
			pintadas = [];

			serpiente.forEach((i, n) => {
				const casilla = casillas[i];
				if (!casilla) return;
				casilla.dataset.k = n === 0 ? 'cabeza' : 'cuerpo';
				pintadas.push(i);
			});

			if (comida >= 0 && casillas[comida]) {
				casillas[comida].dataset.k = 'comida';
				pintadas.push(comida);
			}
		}

		function capaVisible(titulo: string | null, texto = '') {
			if (!capa) return;
			capa.style.display = titulo === null ? 'none' : '';
			if (titulo !== null) {
				if (capaTitulo) capaTitulo.textContent = titulo;
				if (capaTexto) capaTexto.textContent = texto;
			}
		}

		function refrescarBoton() {
			const etiquetas: Record<Estado, string> = {
				listo: 'Jugar',
				jugando: 'Pausa',
				pausa: 'Seguir',
				fin: 'Otra vez',
			};
			if (etiquetaJugar) etiquetaJugar.textContent = etiquetas[estado];
			if (botonJugar) {
				if (estado === 'jugando') botonJugar.dataset.state = 'jugando';
				else botonJugar.removeAttribute('data-state');
			}
		}

		function marcar() {
			if (marcador) marcador.textContent = String(puntos);
			if (marcadorRecord) marcadorRecord.textContent = String(record());
			if (etiquetaRecord) etiquetaRecord.textContent = etiquetaAjuste();
		}

		function decir(texto: string) {
			if (aviso) aviso.textContent = texto;
		}

		/** El ranking del ajuste que está puesto, de arriba abajo. */
		function pintarRanking() {
			if (etiquetaRanking) etiquetaRanking.textContent = etiquetaAjuste();

			const marcas = marcasAhora();
			if (rankingVacio) rankingVacio.hidden = marcas.length > 0;
			if (botonVaciar) botonVaciar.hidden = marcas.length === 0;
			const molde = plantillaFila?.content.firstElementChild;
			if (!listaRanking || !molde) return;

			const filas = marcas.map((marca, n) => {
				const fila = molde.cloneNode(true) as HTMLElement;

				const puesto = fila.querySelector<HTMLElement>('[data-pos]');
				if (puesto) puesto.textContent = String(n + 1);

				const nombre = fila.querySelector<HTMLElement>('[data-nombre]');
				if (nombre) nombre.textContent = marca.nombre;

				const tanteo = fila.querySelector<HTMLElement>('[data-puntos]');
				if (tanteo) tanteo.textContent = String(marca.puntos);

				// La marca recién firmada se distingue sin salirse de la lista.
				if (marca === mia) {
					nombre?.classList.add('text-accent');
					tanteo?.classList.add('text-accent');
				}

				return fila;
			});

			listaRanking.replaceChildren(...filas);
		}

		/** Lo que pasó con la última firma, a la vista y también para el lector. */
		function contarRanking(texto: string) {
			if (avisoRanking) {
				avisoRanking.textContent = texto;
				avisoRanking.hidden = texto === '';
			}
			if (texto) decir(texto);
		}

		/** Al perder se pide nombre; con cero puntos no hay nada que firmar. */
		function pedirFirma() {
			if (!firma) return;
			puntosFirma = puntos;
			firma.hidden = puntos <= 0;
			if (firma.hidden) return;
			if (firmaPuntos) firmaPuntos.textContent = String(puntos);
			if (firmaNombre) firmaNombre.value = leerNombre();
		}

		function cerrarFirma() {
			if (firma) firma.hidden = true;
		}

		function libre() {
			const ocupadas = new Set(serpiente);
			const huecos: number[] = [];
			for (let i = 0; i < COLS * ROWS; i += 1) {
				if (!ocupadas.has(i)) huecos.push(i);
			}
			return huecos;
		}

		function nuevaComida() {
			const huecos = libre();
			comida = huecos.length === 0 ? -1 : huecos[Math.floor(Math.random() * huecos.length)];
			return huecos.length > 0;
		}

		function programar() {
			clearTimeout(temporizador);
			temporizador = window.setTimeout(paso, velocidad);
		}

		function parar() {
			clearTimeout(temporizador);
			temporizador = 0;
		}

		function terminar(titulo: string, texto: string) {
			parar();
			estado = 'fin';
			if (puntos > record()) {
				records = { ...records, [claveRecord()]: puntos };
				guardar(CLAVE_RECORDS, records);
			}
			marcar();
			capaVisible(titulo, texto);
			refrescarBoton();
			pedirFirma();
			decir(`${titulo} ${puntos} puntos. Récord ${record()}.`);
		}

		function paso() {
			const siguienteGiro = pendientes.shift();
			if (siguienteGiro) direccion = siguienteGiro;

			const cabeza = serpiente[0];
			let x = (cabeza % COLS) + direccion.x;
			let y = Math.floor(cabeza / COLS) + direccion.y;

			// Sin paredes se sale por un lado y se entra por el otro; con ellas, adiós.
			if (ajustes.modo === 'tunel') {
				x = (x + COLS) % COLS;
				y = (y + ROWS) % ROWS;
			} else if (x < 0 || x >= COLS || y < 0 || y >= ROWS) {
				terminar('Contra la pared.', `${puntos} puntos. Firma y otra vez.`);
				return;
			}

			const destino = y * COLS + x;
			const crece = destino === comida;
			const cuerpo = crece ? serpiente : serpiente.slice(0, -1);

			if (cuerpo.includes(destino)) {
				terminar('Te has mordido.', `${puntos} puntos. Firma y otra vez.`);
				return;
			}

			serpiente.unshift(destino);
			if (!crece) {
				serpiente.pop();
			} else {
				puntos += 1;
				const ritmo = RITMOS[ajustes.ritmo];
				velocidad = Math.max(ritmo.minimo, ritmo.inicial - puntos * MS_POR_PUNTO);
				marcar();
				if (!nuevaComida()) {
					pintar();
					terminar('Tablero lleno.', `${puntos} puntos. No se puede más.`);
					return;
				}
			}

			pintar();
			programar();
		}

		function empezar() {
			const centro = Math.floor(ROWS / 2) * COLS + Math.floor(COLS / 3);
			serpiente = [centro, centro - 1, centro - 2];
			direccion = { x: 1, y: 0 };
			pendientes = [];
			puntos = 0;
			velocidad = RITMOS[ajustes.ritmo].inicial;
			estado = 'jugando';
			cerrarFirma();
			nuevaComida();
			marcar();
			pintar();
			capaVisible(null);
			refrescarBoton();
			decir('Empieza la partida.');
			programar();
		}

		/** Tablero vacío y a la espera: es donde deja el juego cambiar un ajuste. */
		function reposar() {
			parar();
			estado = 'listo';
			serpiente = [];
			comida = -1;
			puntos = 0;
			cerrarFirma();
			pintar();
			marcar();
			capaVisible(
				'Serpiente',
				ajustes.modo === 'tunel'
					? 'Las paredes no matan: sales por un lado y entras por el otro.'
					: 'Toca el tablero y no te choques.',
			);
			refrescarBoton();
		}

		function pausar() {
			if (estado !== 'jugando') return;
			parar();
			estado = 'pausa';
			capaVisible('En pausa', 'Dale a seguir cuando quieras.');
			refrescarBoton();
		}

		function seguir() {
			if (estado !== 'pausa') return;
			estado = 'jugando';
			capaVisible(null);
			refrescarBoton();
			programar();
		}

		function alternar() {
			if (estado === 'jugando') pausar();
			else if (estado === 'pausa') seguir();
			else empezar();
		}

		function encolar(giro: Giro) {
			if (estado === 'listo' || estado === 'fin') {
				empezar();
			} else if (estado === 'pausa') {
				seguir();
			}

			// El último giro que cuenta es el de la cola, no el que se ve pintado.
			const ultimo = pendientes.at(-1) ?? direccion;
			if (giro.x === -ultimo.x && giro.y === -ultimo.y) return;
			if (giro.x === ultimo.x && giro.y === ultimo.y) return;
			if (pendientes.length < 2) pendientes.push(giro);
		}

		board.addEventListener('keydown', (event) => {
			if (event.key === ' ' || event.key === 'Enter') {
				event.preventDefault();
				alternar();
				return;
			}

			const giro = GIROS[event.key.toLowerCase()];
			if (!giro) return;
			event.preventDefault();
			encolar(giro);
		});

		// Deslizar sobre el tablero gira; un toque seco juega o pausa.
		let toque: { x: number; y: number } | null = null;

		board.addEventListener('pointerdown', (event) => {
			toque = { x: event.clientX, y: event.clientY };
		});

		board.addEventListener('pointerup', (event) => {
			if (!toque) return;
			const dx = event.clientX - toque.x;
			const dy = event.clientY - toque.y;
			toque = null;

			if (Math.abs(dx) < 16 && Math.abs(dy) < 16) {
				alternar();
				return;
			}

			encolar(
				Math.abs(dx) > Math.abs(dy)
					? { x: Math.sign(dx), y: 0 }
					: { x: 0, y: Math.sign(dy) },
			);
		});

		board.addEventListener('pointercancel', () => {
			toque = null;
		});

		/**
		 * Tras un clic de ratón o de dedo el foco vuelve al tablero para que las
		 * flechas sigan funcionando. Con el teclado no se toca el foco: quien va
		 * tabulando por los botones se quedaría sin poder salir de ahí.
		 */
		function devolverFoco(event: MouseEvent) {
			if (event.detail > 0) board.focus({ preventScroll: true });
		}

		botonJugar?.addEventListener('click', (event) => {
			alternar();
			devolverFoco(event);
		});

		section.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', (event) => {
			empezar();
			devolverFoco(event);
		});

		section.querySelectorAll<HTMLButtonElement>('[data-pad]').forEach((boton) => {
			boton.addEventListener('click', (event) => {
				const giro = GIROS[boton.dataset.pad ?? ''];
				if (giro) encolar(giro);
				devolverFoco(event);
			});
		});

		/*
		 * Firmar una marca: entra en el ranking del ajuste con el que se jugó, se
		 * ordena por puntos y solo se quedan las diez primeras. El nombre se
		 * recuerda para la próxima, que nadie quiere teclearlo cada vez.
		 */
		firma?.addEventListener('submit', (event) => {
			event.preventDefault();
			const nombre = limpiarNombre(firmaNombre?.value ?? '') || 'anónimo';
			guardar(CLAVE_NOMBRE, nombre);

			const marca: Marca = { nombre, puntos: puntosFirma, fecha: Date.now() };
			const clave = claveRecord();
			const marcas = ordenar([...(ranking[clave] ?? []), marca]).slice(0, TOPE);
			ranking = { ...ranking, [clave]: marcas };
			guardar(CLAVE_RANKING, ranking);

			const puesto = marcas.indexOf(marca);
			mia = puesto >= 0 ? marca : null;
			// El formulario se va, así que el foco no puede quedarse dentro.
			const dentro = firma?.contains(document.activeElement) === true;
			cerrarFirma();
			pintarRanking();
			contarRanking(
				puesto >= 0
					? `${nombre}, ${marca.puntos} puntos: puesto ${puesto + 1}.`
					: `${nombre}, ${marca.puntos} puntos: no entra en los diez primeros.`,
			);
			if (dentro) board.focus({ preventScroll: true });
		});

		section
			.querySelector<HTMLButtonElement>('[data-firma-pasar]')
			?.addEventListener('click', (event) => {
				cerrarFirma();
				contarRanking('Marca sin firmar.');
				devolverFoco(event);
			});

		botonVaciar?.addEventListener('click', () => {
			const { [claveRecord()]: fuera, ...resto } = ranking;
			if (!fuera) return;
			ranking = resto;
			mia = null;
			guardar(CLAVE_RANKING, ranking);
			pintarRanking();
			contarRanking('Ranking vacío.');
		});

		function marcarOpciones() {
			section.querySelectorAll<HTMLButtonElement>('[data-juego-modo]').forEach((boton) => {
				boton.setAttribute('aria-pressed', String(boton.dataset.juegoModo === ajustes.modo));
			});
			section.querySelectorAll<HTMLButtonElement>('[data-juego-ritmo]').forEach((boton) => {
				boton.setAttribute('aria-pressed', String(boton.dataset.juegoRitmo === ajustes.ritmo));
			});
		}

		/*
		 * Un ajuste nuevo es otro juego y otro récord, así que la partida en curso
		 * se corta aquí: seguir con la vieja a otra velocidad sería hacer trampa.
		 */
		function cambiarAjuste(patch: Partial<Ajustes>) {
			ajustes = { ...ajustes, ...patch };
			guardar(CLAVE_AJUSTES, ajustes);
			marcarOpciones();
			reposar();
			contarRanking('');
			pintarRanking();
			decir('Ajuste cambiado. Tablero a cero.');
		}

		section.querySelectorAll<HTMLButtonElement>('[data-juego-modo]').forEach((boton) => {
			boton.addEventListener('click', (event) => {
				cambiarAjuste({ modo: boton.dataset.juegoModo as Modo });
				devolverFoco(event);
			});
		});

		section.querySelectorAll<HTMLButtonElement>('[data-juego-ritmo]').forEach((boton) => {
			boton.addEventListener('click', (event) => {
				cambiarAjuste({ ritmo: boton.dataset.juegoRitmo as Ritmo });
				devolverFoco(event);
			});
		});

		// Con la pestaña de fondo la partida no corre sola.
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) pausar();
		});

		// Y si el tablero se va de la pantalla, tampoco: quien juega ya no lo ve.
		if ('IntersectionObserver' in window) {
			new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) pausar();
					}
				},
				{ threshold: 0 },
			).observe(board);
		}

		marcarOpciones();
		reposar();
		pintarRanking();
	}
</script>
