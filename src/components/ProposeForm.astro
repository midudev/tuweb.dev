---
import type { SessionUser } from '../lib/auth';
import { getGithubConfig } from '../lib/env';
import type { SiteState } from '../lib/releases';
import { DISCARD_LABELS } from '../lib/window';
import Icon from './Icon.astro';
import WindowClock from './WindowClock.astro';

interface Props {
	user: SessionUser | null;
	myPrompt: { body: string; status: string; discardReason: string | null } | null;
	endsAt: string;
	state: SiteState;
}

const { user, myPrompt, endsAt, state } = Astro.props;
const githubReady = getGithubConfig().configured;
const discarded = myPrompt?.status === 'discarded';
// Vencida es que ya tocaba cerrarla; abierta sigue hasta que pase el cron.
const overdue = new Date(endsAt).getTime() <= Date.now();
// Con la IA trabajando lo que toca no es "espera", es "manda la siguiente".
const working = state === 'building' || state === 'repairing';
---

<section id="proponer" class="border border-line bg-bg px-8 py-7">
	{
		myPrompt ? (
			<div class="flex flex-col gap-6">
				<p class="max-w-[52ch] text-2xl/normal text-pretty">{myPrompt.body}</p>

				<div class="flex flex-wrap items-center justify-between gap-6 border-t border-line pt-5 text-sm">
					{discarded ? (
						<p class="text-mark">
							La IA descartó tu idea: {DISCARD_LABELS[myPrompt.discardReason ?? 'spam'] ?? 'no encaja'}.
						</p>
					) : (
						<p class="text-muted">Ya has enviado tu idea en esta ventana.</p>
					)}
					<p class="text-muted">
						<span data-window-open hidden={overdue}>
							La siguiente se abre en <WindowClock endsAt={endsAt} />
						</span>
						<span data-window-closed hidden={!overdue}>
							{working
								? 'La IA está implementando la idea ganadora. La siguiente ventana se abre en cuanto termine.'
								: 'La ventana ha cerrado. La IA elige la idea ganadora en breve.'}
						</span>
					</p>
				</div>
			</div>
		) : (
			<form method="post" action="/api/prompts" class="flex flex-col gap-6">
				<label class="block">
					<span class="sr-only">Tu idea</span>
					<textarea
						name="body"
						required
						minlength="16"
						maxlength="280"
						rows="2"
						data-prompt-input
						disabled={!user}
						placeholder="Escribe lo que le falta a esta web"
						class="w-full resize-none border-0 bg-transparent p-0 text-2xl/normal outline-none placeholder:text-muted disabled:cursor-not-allowed"
					/>
				</label>

				<div class="flex flex-wrap items-center justify-between gap-6 border-t border-line pt-5">
					<p class="max-w-lg text-sm text-muted">
						<span data-window-open hidden={overdue}>
							Una idea por persona en cada ventana. Se cierra en <WindowClock endsAt={endsAt} /> y
							una IA implementa lo que más se repita.
						</span>
						<span data-window-closed hidden={!overdue}>
							{working
								? 'La IA está implementando la idea ganadora de la ventana anterior. Manda la tuya igualmente: entra en la siguiente.'
								: 'Una idea por persona en cada ventana. Esta ya ha cerrado: la IA elige en breve la idea ganadora y la tuya entra en la siguiente.'}
						</span>
					</p>

					{
						user ? (
							<div class="flex items-center gap-5 text-sm">
								<span class="text-muted"><span data-prompt-count>0</span>/280</span>
								<button type="submit" class="bg-accent px-6 py-3.5 text-bg hover:bg-mark">
									Enviar mi idea
								</button>
							</div>
						) : githubReady ? (
							<a
								href="/api/auth/github"
								class="inline-flex items-center gap-2.5 bg-accent px-6 py-3.5 text-bg no-underline hover:bg-mark hover:no-underline"
							>
								<Icon name="brand-github" class="size-[18px] shrink-0" />
								Entra para enviar tu idea
							</a>
						) : (
							<p class="text-sm text-muted">Falta configurar GitHub.</p>
						)
					}
				</div>
			</form>
		)
	}
</section>

<script>
	const input = document.querySelector<HTMLTextAreaElement>('[data-prompt-input]');
	const count = document.querySelector('[data-prompt-count]');
	if (input && count) {
		const update = () => {
			count.textContent = String(input.value.length);
		};
		input.addEventListener('input', update);
		update();
	}

</script>
