---
/**
 * El interruptor de la luz: claro u oscuro. Vive en el Dashboard de la portada,
 * junto a los números. Lo elegido se guarda en este navegador y no viaja a
 * ningún sitio; los demás siguen viendo el suyo.
 */
import Icon from './Icon.astro';
---

<div class="flex items-center justify-between gap-3 text-sm">
	<span id="modo-oscuro" class="text-muted">modo oscuro</span>

	<button
		type="button"
		role="switch"
		aria-checked="false"
		aria-labelledby="modo-oscuro"
		data-modo
		class="relative inline-flex h-6 w-12 shrink-0 border border-line bg-bg hover:border-accent"
	>
		<span
			data-pomo
			class="absolute top-[2px] bottom-[2px] left-[2px] flex aspect-square items-center justify-center bg-accent text-bg"
		>
			<span data-cuando="claro" class="flex"><Icon name="sun" class="size-3" /></span>
			<span data-cuando="oscuro" class="flex"><Icon name="moon" class="size-3" /></span>
		</span>
	</button>
</div>

<style>
	/*
	 * Dónde está el pomo y qué icono lleva se decide en CSS y no en JS: el <html>
	 * ya viene marcado, así que sale bien en el primer pintado. El aria-checked lo
	 * pone el script, que eso no se puede decir con estilos.
	 */
	[data-pomo] {
		transform: translateX(0);
		transition: transform 150ms ease;
	}

	:global(html[data-tema='oscuro']) [data-pomo] {
		transform: translateX(1.5rem);
	}

	[data-cuando='oscuro'] {
		display: none;
	}

	:global(html[data-tema='oscuro']) [data-cuando='oscuro'] {
		display: flex;
	}

	:global(html[data-tema='oscuro']) [data-cuando='claro'] {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-pomo] {
			transition: none;
		}
	}
</style>

<script>
	import { type ThemeEvent, applyTheme, currentMode, readTheme, saveTheme } from '../lib/theme';

	let theme = readTheme();

	/** El aria-checked del interruptor, que en CSS no se puede poner. */
	function marcar() {
		const oscuro = String(currentMode() === 'oscuro');
		for (const boton of document.querySelectorAll('[data-modo]')) {
			boton.setAttribute('aria-checked', oscuro);
		}
	}

	/*
	 * El Dashboard se repinta solo cada minuto y este botón se va con él, así que
	 * el clic se escucha en el documento: el nodo de dentro de un rato es otro.
	 */
	document.addEventListener('click', (event) => {
		if (!(event.target as Element | null)?.closest('[data-modo]')) return;

		theme = { ...theme, mode: theme.mode === 'oscuro' ? 'claro' : 'oscuro' };
		applyTheme(theme);
		saveTheme(theme);
	});

	// Tras un repintado el botón vuelve del servidor sin estado: se le pone aquí.
	for (const zona of document.querySelectorAll('[data-live]')) {
		new MutationObserver(marcar).observe(zona, { childList: true });
	}

	// El modo también se cambia desde la pestaña de Tema de las herramientas.
	document.addEventListener('tuweb:tema', (event) => {
		theme = (event as CustomEvent<ThemeEvent>).detail.theme;
		marcar();
	});

	marcar();
</script>
