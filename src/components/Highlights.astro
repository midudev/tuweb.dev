---
/**
 * Ideas destacadas. Las mejores ideas de la comunidad no las elige nadie: son
 * las que ganaron su ventana y acabaron publicadas, así que salen de lo que ya
 * está guardado, cada una con su versión y su fecha.
 *
 * Encima se vota y se comenta, y eso sí se guarda en el servidor y lo ve todo
 * el mundo. Leer no pide nada; votar y comentar piden entrar con GitHub, pero
 * lo que se enseña no es tu nombre: se te pone un alias de números que tiras
 * cuando quieras.
 *
 * La lista viene pintada del servidor: sin JavaScript se lee igual, solo que sin
 * botones.
 */
import GitHubLogin from './GitHubLogin.astro';
import Hora from './Hora.astro';
import Icon from './Icon.astro';
import { COMMENT_MAX, type Destacada } from '../lib/destacadas';

interface Props {
	ideas: Destacada[];
	/** La idea que se está construyendo ahora, si hay alguna. */
	enObras: string | null;
}

const { ideas, enObras } = Astro.props;

const BOTON =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent';
const CHIP = 'border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent';
const FIELD =
	'w-full border border-line bg-bg px-3 py-2 text-sm outline-none focus-visible:border-accent';
---

<section id="destacadas" data-sinjs class="flex flex-col gap-7">
	<div class="flex flex-col gap-4 border border-line bg-panel p-4">
		<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
			<h2 class="inline-flex items-center gap-2 font-pixel text-lg font-normal">
				<Icon name="star" class="size-5 shrink-0 text-accent" />
				{ideas.length}
				{ideas.length === 1 ? 'idea publicada' : 'ideas publicadas'}
			</h2>

			<p data-solo-js class="inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
				<span>eres <span data-alias class="text-fg">…</span></span>
				<button type="button" data-rotar class="inline-flex items-center gap-2 hover:text-accent">
					<Icon name="refresh" class="size-4 shrink-0" />
					Cambiar de alias
				</button>
			</p>
		</div>

		{
			enObras && (
				<p class="flex items-start gap-2 text-sm text-muted">
					<Icon name="tool" class="mt-1 size-4 shrink-0" />
					<span>
						En obras ahora: <span class="text-fg">{enObras}</span>. Cuando salga, se pone aquí.
					</span>
				</p>
			)
		}

		<div data-solo-js class="flex flex-col gap-3">
			<label class="flex flex-col gap-2">
				<span class="text-sm text-muted">Buscar</span>
				<input
					type="search"
					data-busca
					autocomplete="off"
					placeholder="Por título o por lo que hace"
					class={FIELD}
				/>
			</label>

			<div role="group" aria-label="Ordenar las ideas" class="flex flex-wrap gap-2">
				<button type="button" data-orden="votos" aria-pressed="true" class={CHIP}>Más votadas</button>
				<button type="button" data-orden="comentarios" aria-pressed="false" class={CHIP}>
					Más comentadas
				</button>
				<button type="button" data-orden="nuevas" aria-pressed="false" class={CHIP}>Últimas</button>
			</div>
		</div>

		<p data-nota role="status" class="text-sm text-muted"></p>

		<p data-entrar hidden class="text-sm">
			<GitHubLogin label="Entra con GitHub para votar y comentar" />
		</p>
	</div>

	<ul data-list class="flex flex-col gap-4">
		{
			ideas.map((idea) => (
				<li
					data-idea={idea.id}
					data-busqueda={`${idea.title} ${idea.summary}`}
					class="flex flex-col gap-3 border border-line bg-panel p-4"
				>
					<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
						<h3 class="max-w-[60ch] text-base text-pretty">{idea.title}</h3>
						<p class="shrink-0 text-xs text-muted">
							<span class="text-accent tabular-nums">v{idea.version}</span>
							{' · '}
							<Hora iso={idea.at} formato="dia-corto" class="tabular-nums" />
						</p>
					</div>

					<p class="max-w-[70ch] text-sm text-pretty text-muted">{idea.summary}</p>

					<div data-solo-js class="flex flex-wrap items-center gap-3 border-t border-line pt-3">
						<button type="button" data-vote aria-pressed="false" class={BOTON}>
							<span data-icon="off" class="inline-flex items-center gap-2">
								<Icon name="arrow-big-up" class="size-4 shrink-0" />
								Votar
							</span>
							<span data-icon="on" class="inline-flex items-center gap-2">
								<Icon name="check" class="size-4 shrink-0" />
								Votada
							</span>
							<span data-votos class="tabular-nums">0</span>
						</button>

						<button type="button" data-abrir aria-expanded="false" class={BOTON}>
							<Icon name="message-2" class="size-4 shrink-0" />
							Comentar
							<span data-comentarios class="tabular-nums">0</span>
						</button>

						<span data-resumen class="text-sm text-muted">Sin votos · sin comentarios</span>
					</div>

					<div data-panel hidden class="flex flex-col gap-3 border-t border-line pt-3">
						<ul data-hilo aria-label="Comentarios" class="flex flex-col gap-3" />

						<p data-hilo-vacio class="text-sm text-muted">
							Nadie ha dicho nada de esta idea. Empieza tú.
						</p>

						<p data-hilo-nota role="status" hidden class="text-sm text-muted" />

						<p data-entrar hidden class="text-sm">
							<GitHubLogin label="Entra con GitHub para comentar" />
						</p>

						<form data-form hidden class="flex flex-wrap items-end gap-3">
							<label class="flex min-w-0 grow flex-col gap-2">
								<span class="text-sm text-muted">Tu comentario</span>
								<input
									type="text"
									data-input
									maxlength={COMMENT_MAX}
									autocomplete="off"
									placeholder="Qué te parece, qué le falta"
									aria-label={`Comentar la idea: ${idea.title}`}
									class={FIELD}
								/>
							</label>
							<button type="submit" class={BOTON}>
								<Icon name="send" class="size-4 shrink-0" />
								Enviar
							</button>
						</form>
					</div>
				</li>
			))
		}
	</ul>

	{
		ideas.length === 0 ? (
			<p class="text-sm text-muted">
				Todavía no se ha publicado ninguna idea. En cuanto cierre la primera ventana, aquí estará.
			</p>
		) : (
			<p data-vacio hidden class="text-sm text-muted">
				Ninguna idea dice eso. Prueba con otra palabra.
			</p>
		)
	}

	<template data-plantilla>
		<li data-comentario class="flex flex-col gap-1 border-l border-line pl-3">
			<p class="flex flex-wrap items-baseline justify-between gap-x-3 text-xs text-muted">
				<span data-quien class="text-fg"></span>
				<span class="inline-flex items-baseline gap-3">
					<span data-cuando class="tabular-nums"></span>
					<button type="button" data-borrar hidden class="inline-flex items-center gap-1 hover:text-accent">
						<Icon name="trash" class="size-3.5 shrink-0 self-center" />
						Borrar
					</button>
				</span>
			</p>
			<p data-texto class="min-w-0 text-sm"></p>
		</li>
	</template>

	<p data-solo-js class="text-sm text-muted">
		Los votos y los comentarios se guardan y los ve cualquiera que pase por aquí; tu nombre de
		GitHub no, solo el alias. Los tuyos los puedes borrar cuando quieras. Si lo que dices merece
		construirse, proponlo como idea en la portada, que es como se cambia esta web.
	</p>
</section>

<style is:global>
	/*
	 * Va global porque el estado lo pone el script sobre nodos que no llevan la
	 * marca del componente; por eso todo cuelga de #destacadas.
	 */

	/* Sin JavaScript no hay votos ni comentarios: las ideas se leen y ya está. */
	#destacadas[data-sinjs] [data-solo-js] {
		display: none;
	}

	#destacadas [data-orden][aria-pressed='true'] {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	/* El botón enseña solo el estado en el que está. */
	#destacadas [data-vote] > [data-icon='on'],
	#destacadas [data-vote][aria-pressed='true'] > [data-icon='off'] {
		display: none;
	}
	#destacadas [data-vote][aria-pressed='true'] {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
	#destacadas [data-vote][aria-pressed='true'] > [data-icon='on'] {
		display: inline-flex;
	}

	/* La idea votada lleva su canto naranja, para verla de un vistazo. */
	#destacadas [data-idea][data-votada='si'] {
		border-inline-start: 2px solid var(--color-accent);
	}
</style>

<script>
	import {
		type Comentario,
		type Orden,
		coincide,
		cuandoTexto,
		errorTexto,
		isOrden,
		limpiar,
		nuevoAlias,
		ordenarFilas,
		resumenTexto,
	} from '../lib/destacadas';

	const section = document.querySelector<HTMLElement>('#destacadas');
	const list = section?.querySelector<HTMLElement>('[data-list]');
	const plantilla = section?.querySelector<HTMLTemplateElement>('[data-plantilla]');
	const aliasOut = section?.querySelector<HTMLElement>('[data-alias]');
	const notaOut = section?.querySelector<HTMLElement>('[data-nota]');
	const vacio = section?.querySelector<HTMLElement>('[data-vacio]');
	const buscador = section?.querySelector<HTMLInputElement>('[data-busca]');

	if (section && list && plantilla && aliasOut && notaOut && vacio && buscador) {
		const REPASO_MS = 30_000;
		const REINTENTO_MS = 5_000;
		const REINTENTO_MAX_MS = 60_000;
		const JSON_HEADERS = { 'Content-Type': 'application/json' };

		interface Fila {
			id: number;
			busqueda: string;
			node: HTMLElement;
			vote: HTMLButtonElement;
			votosOut: HTMLElement;
			abrir: HTMLButtonElement;
			comentariosOut: HTMLElement;
			resumen: HTMLElement;
			panel: HTMLElement;
			hilo: HTMLElement;
			hiloVacio: HTMLElement;
			hiloNota: HTMLElement;
			entrar: HTMLElement;
			form: HTMLFormElement;
			input: HTMLInputElement;
			votos: number;
			comentarios: number;
			/** El hilo tal como lo dio la API, o null si todavía no se ha pedido. */
			hiloDatos: Comentario[] | null;
			pidiendo: boolean;
			espera: number;
		}

		const rows: Fila[] = [...list.querySelectorAll<HTMLElement>('[data-idea]')].map((node) => ({
			id: Number(node.dataset.idea),
			busqueda: node.dataset.busqueda ?? '',
			node,
			vote: node.querySelector<HTMLButtonElement>('[data-vote]')!,
			votosOut: node.querySelector<HTMLElement>('[data-votos]')!,
			abrir: node.querySelector<HTMLButtonElement>('[data-abrir]')!,
			comentariosOut: node.querySelector<HTMLElement>('[data-comentarios]')!,
			resumen: node.querySelector<HTMLElement>('[data-resumen]')!,
			panel: node.querySelector<HTMLElement>('[data-panel]')!,
			hilo: node.querySelector<HTMLElement>('[data-hilo]')!,
			hiloVacio: node.querySelector<HTMLElement>('[data-hilo-vacio]')!,
			hiloNota: node.querySelector<HTMLElement>('[data-hilo-nota]')!,
			entrar: node.querySelector<HTMLElement>('[data-entrar]')!,
			form: node.querySelector<HTMLFormElement>('[data-form]')!,
			input: node.querySelector<HTMLInputElement>('[data-input]')!,
			votos: 0,
			comentarios: 0,
			hiloDatos: null,
			pidiendo: false,
			espera: REINTENTO_MS,
		}));

		const porId = new Map(rows.map((row) => [row.id, row]));
		const entrarArriba = section.querySelector<HTMLElement>(':scope > div [data-entrar]');

		// Lo compartido llega de la API; aquí solo se guarda lo que ha dicho.
		const misVotos = new Set<number>();
		// Quién eres, solo para saber si enseñar los botones o el enlace de entrar.
		// Lo que se enseña a los demás sigue siendo el alias.
		let login: string | null = null;
		let cargado = false;

		let alias = nuevoAlias();
		let orden: Orden = 'votos';

		function avisar(texto: string) {
			notaOut!.textContent = texto;
		}

		/** Lo que devuelve la API, o el error con su estado para contarlo en corto. */
		type Respuesta<T> = { ok: true; data: T } | { ok: false; status: number; error?: string };

		async function pedir<T>(url: string, init?: RequestInit): Promise<Respuesta<T>> {
			try {
				const res = await fetch(url, init);
				const data = await res.json().catch(() => null);
				if (!res.ok) return { ok: false, status: res.status, error: data?.error };
				return { ok: true, data: data as T };
			} catch {
				return { ok: false, status: 0 };
			}
		}

		function numero(raw: unknown) {
			const n = Number(raw);
			return Number.isFinite(n) && n > 0 ? Math.floor(n) : 0;
		}

		// --- Lo que se pinta ---

		function pintarEntrar() {
			// Mientras no ha llegado la primera respuesta no se sabe si hay sesión:
			// ni formulario ni enlace, para no enseñar lo que no toca.
			const dentro = login !== null;
			if (entrarArriba) entrarArriba.hidden = !cargado || dentro;
			for (const row of rows) {
				row.entrar.hidden = !cargado || dentro;
				row.form.hidden = !cargado || !dentro;
			}
		}

		function pintarHilo(row: Fila) {
			const ahora = Date.now();
			row.hilo.replaceChildren();

			if (row.hiloDatos === null) {
				row.hiloVacio.hidden = true;
				return;
			}

			row.hiloVacio.hidden = row.hiloDatos.length > 0;

			// La API los da los últimos primero; aquí se leen como una conversación.
			for (const comentario of [...row.hiloDatos].reverse()) {
				const nodo = plantilla!.content.firstElementChild!.cloneNode(true) as HTMLElement;
				const quien = nodo.querySelector<HTMLElement>('[data-quien]')!;

				quien.textContent = comentario.mine ? `${comentario.alias} (tú)` : comentario.alias;
				nodo.querySelector<HTMLElement>('[data-cuando]')!.textContent = cuandoTexto(comentario.at, ahora);
				nodo.querySelector<HTMLElement>('[data-texto]')!.textContent = comentario.text;

				if (comentario.mine) {
					const borrar = nodo.querySelector<HTMLButtonElement>('[data-borrar]')!;
					borrar.hidden = false;
					borrar.setAttribute('aria-label', `Borrar tu comentario: ${comentario.text}`);
					borrar.addEventListener('click', () => borrarComentario(row, comentario, borrar));
				}

				row.hilo.append(nodo);
			}
		}

		/**
		 * Las tarjetas, en el orden que toca. Solo se mueven si ese orden ha
		 * cambiado de verdad: mover un nodo lo saca y lo vuelve a meter, y eso le
		 * quita el foco a quien estuviera escribiendo un comentario dentro.
		 */
		function reordenar() {
			// Mientras se escribe un comentario la lista se queda quieta: ya se pondrá
			// en orden en el próximo repaso, que llega solo.
			const foco = document.activeElement;
			if (foco instanceof HTMLInputElement && foco.type === 'text' && list!.contains(foco)) return;

			const puesto = ordenarFilas(rows, orden);
			const ahora = [...list!.children];
			const igual = puesto.length === ahora.length && puesto.every((row, i) => row.node === ahora[i]);

			if (!igual) list!.append(...puesto.map((row) => row.node));
		}

		function pintar() {
			const busca = buscador!.value;
			let visibles = 0;

			for (const row of rows) {
				const votada = misVotos.has(row.id);
				row.node.dataset.votada = votada ? 'si' : 'no';
				row.vote.setAttribute('aria-pressed', String(votada));
				row.votosOut.textContent = String(row.votos);
				row.comentariosOut.textContent = String(row.comentarios);
				row.resumen.textContent = resumenTexto(row.votos, row.comentarios);

				const cabe = coincide(row.busqueda, busca);
				row.node.hidden = !cabe;
				if (cabe) visibles += 1;
			}

			vacio!.hidden = visibles > 0;
			reordenar();

			for (const chip of section!.querySelectorAll<HTMLElement>('[data-orden]')) {
				chip.setAttribute('aria-pressed', String(chip.dataset.orden === orden));
			}
		}

		// --- Lo que se pide a la API ---

		let esperaCarga = REINTENTO_MS;

		/** Los contadores de todas y cuáles has votado tú. Si falla, se reintenta. */
		async function cargar() {
			const res = await pedir<{
				votes: Record<string, number>;
				comments: Record<string, number>;
				mine: number[];
				login: string | null;
			}>('/api/destacadas');

			if (!res.ok) {
				avisar('No llegan los votos ni los comentarios. Se vuelve a probar en un momento.');
				setTimeout(cargar, esperaCarga);
				esperaCarga = Math.min(esperaCarga * 2, REINTENTO_MAX_MS);
				return;
			}

			esperaCarga = REINTENTO_MS;
			const { votes, comments, mine } = res.data;

			for (const row of rows) {
				row.votos = numero(votes?.[row.id]);
				// Un hilo ya abierto sabe mejor que nadie cuántos lleva.
				if (row.hiloDatos === null) row.comentarios = numero(comments?.[row.id]);
			}

			misVotos.clear();
			for (const id of Array.isArray(mine) ? mine : []) if (porId.has(Number(id))) misVotos.add(Number(id));

			login = typeof res.data.login === 'string' ? res.data.login : null;
			const primera = !cargado;
			cargado = true;

			pintarEntrar();
			pintar();
			if (primera || notaOut!.textContent?.startsWith('No llegan')) {
				avisar(login ? '' : 'Puedes leerlo todo. Para votar o comentar, entra con GitHub.');
			}
		}

		/** El hilo de una idea, cuando se abre. Si falla, se reintenta mientras siga abierto. */
		async function cargarHilo(row: Fila) {
			if (row.pidiendo) return;
			row.pidiendo = true;
			if (row.hiloDatos === null) {
				row.hiloNota.hidden = false;
				row.hiloNota.textContent = 'Cargando comentarios…';
			}

			const res = await pedir<{ comments: Comentario[] }>(`/api/destacadas/${row.id}`);
			row.pidiendo = false;

			if (!res.ok) {
				row.hiloNota.hidden = false;
				row.hiloNota.textContent =
					res.status === 404
						? errorTexto(404, res.error)
						: 'No llegan los comentarios. Se vuelve a probar en un momento.';
				if (res.status === 404) return;

				setTimeout(() => {
					if (!row.panel.hidden) cargarHilo(row);
				}, row.espera);
				row.espera = Math.min(row.espera * 2, REINTENTO_MAX_MS);
				return;
			}

			row.espera = REINTENTO_MS;
			row.hiloNota.hidden = true;
			row.hiloDatos = Array.isArray(res.data.comments) ? res.data.comments : [];
			row.comentarios = row.hiloDatos.length;
			pintarHilo(row);
			pintar();
		}

		// --- Lo que se hace desde aquí ---

		function sinSesion() {
			login = null;
			pintarEntrar();
		}

		async function votar(row: Fila) {
			if (!cargado) return;
			if (!login) {
				avisar(errorTexto(401));
				return;
			}

			row.vote.disabled = true;
			const res = await pedir<{ voted: boolean; votes: number }>('/api/destacadas', {
				method: 'POST',
				headers: JSON_HEADERS,
				body: JSON.stringify({ idea: row.id }),
			});
			row.vote.disabled = false;

			if (!res.ok) {
				if (res.status === 401) sinSesion();
				avisar(errorTexto(res.status, res.error));
				return;
			}

			if (res.data.voted) misVotos.add(row.id);
			else misVotos.delete(row.id);
			row.votos = numero(res.data.votes);
			pintar();
			avisar('');
		}

		async function comentar(row: Fila) {
			const texto = limpiar(row.input.value);
			if (!texto) return;

			const boton = row.form.querySelector<HTMLButtonElement>('[type="submit"]');
			if (boton) boton.disabled = true;

			const res = await pedir<{ comment: Comentario }>(`/api/destacadas/${row.id}`, {
				method: 'POST',
				headers: JSON_HEADERS,
				body: JSON.stringify({ alias, text: texto }),
			});
			if (boton) boton.disabled = false;

			if (!res.ok) {
				if (res.status === 401) sinSesion();
				avisar(errorTexto(res.status, res.error));
				return;
			}

			row.input.value = '';
			row.hiloDatos = [res.data.comment, ...(row.hiloDatos ?? [])];
			row.comentarios += 1;
			pintarHilo(row);
			pintar();
			avisar(`Dicho como ${alias}. Lo ve todo el mundo; si te arrepientes, bórralo.`);
		}

		async function borrarComentario(row: Fila, comentario: Comentario, boton: HTMLButtonElement) {
			boton.disabled = true;
			const res = await pedir<{ ok: boolean }>(`/api/destacadas/comentario/${comentario.id}`, {
				method: 'DELETE',
				headers: JSON_HEADERS,
			});
			boton.disabled = false;

			// Si ya no estaba, da igual: el resultado es el mismo, se quita de aquí.
			if (!res.ok && res.status !== 404) {
				if (res.status === 401) sinSesion();
				avisar(errorTexto(res.status, res.error));
				return;
			}

			row.hiloDatos = (row.hiloDatos ?? []).filter((otro) => otro.id !== comentario.id);
			row.comentarios = Math.max(0, row.comentarios - 1);
			pintarHilo(row);
			pintar();
			avisar('Comentario borrado.');
		}

		for (const row of rows) {
			row.vote.addEventListener('click', () => votar(row));

			row.abrir.addEventListener('click', () => {
				const abierto = !row.panel.hidden;
				row.panel.hidden = abierto;
				row.abrir.setAttribute('aria-expanded', String(!abierto));
				if (abierto) return;

				// Cada vez que se abre se pide de nuevo: así se ve lo último que haya.
				pintarHilo(row);
				cargarHilo(row);
				if (!row.form.hidden) row.input.focus();
			});

			row.form.addEventListener('submit', (evento) => {
				evento.preventDefault();
				comentar(row);
			});
		}

		for (const chip of section.querySelectorAll<HTMLElement>('[data-orden]')) {
			chip.addEventListener('click', () => {
				const pedido = chip.dataset.orden;
				if (!isOrden(pedido)) return;

				orden = pedido;
				pintar();
			});
		}

		buscador.addEventListener('input', () => pintar());

		section.querySelector<HTMLButtonElement>('[data-rotar]')?.addEventListener('click', () => {
			alias = nuevoAlias();
			aliasOut.textContent = alias;
			// Lo ya dicho se queda con el alias viejo: nadie puede atar los dos.
			avisar(`Ahora eres ${alias}. Lo de antes sigue con el alias anterior.`);
		});

		// --- Arranque ---

		aliasOut.textContent = alias;
		buscador.value = '';
		delete section.dataset.sinjs;
		pintar();
		avisar('Cargando votos y comentarios…');
		cargar();

		// Un repaso cada poco, sin pedir nada: se refresca lo de «hace un rato» en
		// los hilos abiertos y se pone en orden lo que se quedó quieto al escribir.
		setInterval(() => {
			// El hilo en el que está el foco se deja, que rehacerlo se lo quitaría.
			const foco = document.activeElement;
			for (const row of rows) {
				if (!row.panel.hidden && !row.hilo.contains(foco)) pintarHilo(row);
			}
			pintar();
		}, REPASO_MS);
	}
</script>
