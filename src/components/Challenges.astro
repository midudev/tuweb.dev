---
/**
 * Los retos semanales: un tablero que se renueva cada lunes. Tres los pone la
 * casa, rotando el catálogo, y los demás los propone la gente con su cuenta de
 * GitHub y los ve todo el mundo. Lo que marcas como hecho es tuyo y se queda en
 * tu navegador; el lunes vuelve a estar todo por hacer.
 */
import GitHubLogin from './GitHubLogin.astro';
import Icon from './Icon.astro';
import { getSessionUser } from '../lib/auth';
import { DETAIL_MAX, NIVELES, TEMAS, TITLE_MAX } from '../lib/retos';

// Con sesión sale el formulario; sin ella, el enlace para entrar. El script lo
// corrige si la sesión cambia mientras la página está abierta.
const user = await getSessionUser(Astro);

const FIELD =
	'w-full border border-line bg-bg px-3 py-2 text-sm outline-none focus-visible:border-accent';
const BOTON =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent disabled:pointer-events-none disabled:opacity-40';
const ENLACE = 'inline-flex items-center gap-2 text-sm text-muted hover:text-accent';
const DATO = 'inline-flex items-center gap-2';
---

<section id="retos" class="flex flex-col gap-7">
	<div class="flex flex-col gap-4 border border-line bg-panel p-4">
		<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
			<h2 class="inline-flex items-center gap-2 font-pixel text-lg font-normal">
				<Icon name="calendar-week" class="size-5 shrink-0 text-accent" />
				<span data-week>Esta semana</span>
			</h2>
			<p class="inline-flex items-center gap-2 text-sm text-muted">
				<Icon name="clock" class="size-4 shrink-0" />
				<span data-left aria-live="polite"></span>
			</p>
		</div>

		<p class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted" aria-live="polite">
			<span class={DATO}>
				Hechos <span data-done-count class="tabular-nums text-fg"></span>
			</span>
			<span class={DATO}>
				Puntos <span data-points class="tabular-nums text-accent"></span>
			</span>
			<span class={DATO}>
				Racha <span data-streak class="tabular-nums text-fg"></span>
			</span>
		</p>
	</div>

	<p data-login hidden={Boolean(user)} class="border border-line bg-panel p-4 text-sm text-muted">
		Los retos los ve todo el mundo; para proponer uno, <GitHubLogin label="entra con GitHub" />.
	</p>

	<form data-form hidden={!user} class="grid gap-4 border border-line bg-panel p-4 md:grid-cols-2">
		<label class="flex flex-col gap-2 md:col-span-2">
			<span class="text-sm text-muted">Tu reto</span>
			<input
				type="text"
				data-field="title"
				maxlength={TITLE_MAX}
				autocomplete="off"
				placeholder="Escribir el test antes que el código"
				class={FIELD}
			/>
		</label>

		<label class="flex flex-col gap-2 md:col-span-2">
			<span class="text-sm text-muted">Qué cuenta como hecho</span>
			<input
				type="text"
				data-field="detail"
				maxlength={DETAIL_MAX}
				autocomplete="off"
				placeholder="En una línea: dónde está la raya"
				class={FIELD}
			/>
		</label>

		<label class="flex flex-col gap-2">
			<span class="text-sm text-muted">Tema</span>
			<select data-field="tema" class={FIELD}>
				{TEMAS.map((tema) => <option value={tema.id}>{tema.label}</option>)}
			</select>
		</label>

		<label class="flex flex-col gap-2">
			<span class="text-sm text-muted">Nivel</span>
			<select data-field="nivel" class={FIELD}>
				{
					NIVELES.map((nivel) => (
						<option value={nivel.id} selected={nivel.id === 'medio'}>
							{nivel.label} · {nivel.points} {nivel.points === 1 ? 'punto' : 'puntos'}
						</option>
					))
				}
			</select>
		</label>

		<div class="flex flex-wrap items-end gap-4 md:col-span-2">
			<button type="submit" class={BOTON}>
				<Icon name="plus" class="size-4 shrink-0" />
				Proponer el reto
			</button>
			<p data-error role="status" class="text-sm text-heart"></p>
		</div>
	</form>

	<p data-status role="status" hidden class="text-sm text-heart"></p>

	<ul data-list class="grid gap-4 md:grid-cols-2"></ul>

	<p data-count class="text-sm text-muted"></p>

	<template data-card>
		<li data-item class="flex flex-col gap-3 border border-line border-l-2 bg-panel p-4">
			<div class="flex items-start justify-between gap-3">
				<label class="flex items-start gap-3">
					<input type="checkbox" data-done class="mt-1 size-4 shrink-0 accent-accent" />
					<span class="flex flex-col gap-1">
						<span data-title class="text-sm"></span>
						<span data-detail class="text-xs text-muted"></span>
					</span>
				</label>
				<span data-badge class="shrink-0 border px-2 py-1 text-xs"></span>
			</div>

			<p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted">
				<span data-nivel></span>
				<span class="inline-flex items-center gap-2">
					<Icon name="flag" class="size-4 shrink-0" />
					<span data-origen></span>
				</span>
			</p>

			<div data-tools class="flex flex-wrap items-center gap-5 border-t border-line pt-3">
				<button type="button" data-remove class={ENLACE}>
					<Icon name="trash" class="size-4 shrink-0" />
					Quitar
				</button>
			</div>
		</li>
	</template>

	<p class="text-sm text-muted">
		Los tres retos de la casa cambian cada lunes, y los que propone la gente duran lo que dura la
		semana. Lo que marcas como hecho, los puntos y la racha solo están en tu navegador.
	</p>
</section>

<style is:global>
	/*
	 * Va global porque las tarjetas las pinta el script y no llevan la marca del
	 * componente; por eso todo cuelga de #retos.
	 */

	/* El tema se ve en el canto de la tarjeta y en su etiqueta. */
	#retos [data-item] {
		border-left-color: var(--tema, var(--color-line));
	}
	#retos [data-badge] {
		color: var(--tema, var(--color-muted));
		border-color: var(--tema, var(--color-line));
	}

	/* Un reto hecho se apaga y se tacha: ese ya está. */
	#retos [data-item][data-hecho='si'] {
		border-left-color: var(--color-ok);
	}
	#retos [data-item][data-hecho='si'] [data-title] {
		color: var(--color-muted);
		text-decoration: line-through;
	}

	/* Solo se quita lo que propusiste tú: lo de la casa y lo de otros, no. */
	#retos [data-item]:not([data-mio='si']) [data-tools] {
		display: none;
	}
</style>

<script>
	import {
		HOUSE_COUNT,
		MAX_RETOS,
		PER_PERSON,
		type Done,
		type Reto,
		fromApi,
		houseRetos,
		isDone,
		nextWeekStart,
		nivelOf,
		pointsOf,
		readDone,
		saveDone,
		spanText,
		streakOf,
		temaOf,
		toReto,
		toggleDone,
		weekIndex,
		weekLabel,
		weekStart,
	} from '../lib/retos';

	const section = document.querySelector<HTMLElement>('#retos');
	const form = section?.querySelector<HTMLFormElement>('[data-form]');
	const list = section?.querySelector<HTMLElement>('[data-list]');
	const template = section?.querySelector<HTMLTemplateElement>('[data-card]');
	const errorOut = section?.querySelector<HTMLElement>('[data-error]');
	const statusOut = section?.querySelector<HTMLElement>('[data-status]');
	const loginOut = section?.querySelector<HTMLElement>('[data-login]');
	const weekOut = section?.querySelector<HTMLElement>('[data-week]');
	const leftOut = section?.querySelector<HTMLElement>('[data-left]');
	const doneOut = section?.querySelector<HTMLElement>('[data-done-count]');
	const pointsOut = section?.querySelector<HTMLElement>('[data-points]');
	const streakOut = section?.querySelector<HTMLElement>('[data-streak]');
	const countOut = section?.querySelector<HTMLElement>('[data-count]');

	/** Lo que la gente puede proponer: lo que dejan libre los de la casa. */
	const SHARED_MAX = MAX_RETOS - HOUSE_COUNT;

	interface Respuesta {
		ok: boolean;
		status: number;
		code: string;
		data: Record<string, unknown> | null;
	}

	/** Una llamada a la API que nunca revienta: si falla la red, status 0. */
	async function pedir(url: string, method = 'GET', body?: unknown): Promise<Respuesta> {
		try {
			const res = await fetch(url, {
				method,
				headers: method === 'GET' ? undefined : { 'Content-Type': 'application/json' },
				body: body === undefined ? undefined : JSON.stringify(body),
			});
			const data = (await res.json().catch(() => null)) as Record<string, unknown> | null;
			const code = typeof data?.error === 'string' ? data.error : '';
			return { ok: res.ok, status: res.status, code, data };
		} catch {
			return { ok: false, status: 0, code: '', data: null };
		}
	}

	/** Lo que dice el servidor, dicho en corto. */
	function mensaje(status: number, code: string) {
		if (status === 400) return 'Al reto le falta algo o algo no vale. Revísalo.';
		if (status === 401) return 'Entra con GitHub para proponer retos.';
		if (status === 403) return 'La petición no salió de esta web. Recarga la página.';
		if (status === 404) return 'Ese reto ya no está.';
		if (status === 409 && code === 'lleno')
			return `El tablero de esta semana está lleno: ${SHARED_MAX} retos de la gente como mucho.`;
		if (status === 409) return `Ya has propuesto ${PER_PERSON} esta semana. Quita alguno.`;
		if (status === 422) return 'Eso parece spam: sin enlaces ni letras repetidas.';
		if (status === 429) return 'Más despacio: espera un minuto y vuelve a probar.';
		return 'No se pudo hablar con el servidor. Prueba otra vez.';
	}

	if (section && form && list && template && countOut) {
		/** Los que propone la gente, tal como vinieron la última vez. */
		let retos: Reto[] = [];
		let done: Done = readDone();
		// Hasta que conteste el servidor, la semana es la de este reloj.
		let start = weekStart(Date.now());
		let end = nextWeekStart(start);
		let week = weekIndex(start);
		let loaded = false;
		let loading = false;
		/** Si alguien pidió cargar mientras ya se cargaba, se repite al acabar. */
		let again = false;
		let retry = 0;
		let retryTimer = 0;
		let sending = false;

		function field(name: string) {
			return form!.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-field="${name}"]`);
		}

		function fail(message: string) {
			if (errorOut) errorOut.textContent = message;
		}

		function aviso(message: string) {
			if (!statusOut) return;
			statusOut.textContent = message;
			statusOut.hidden = !message;
		}

		/** Con sesión, el formulario; sin ella, el enlace para entrar. */
		function setLogin(login: string | null) {
			form!.hidden = !login;
			if (loginOut) loginOut.hidden = Boolean(login);
		}

		/** El tablero: los de la casa y los de la gente, con lo que falta por hacer arriba. */
		function board() {
			return [...houseRetos(week), ...retos].sort((a, b) => {
				const hechoA = isDone(done, week, a.id);
				const hechoB = isDone(done, week, b.id);
				if (hechoA !== hechoB) return hechoA ? 1 : -1;
				if (a.house !== b.house) return a.house ? -1 : 1;
				return b.at - a.at;
			});
		}

		function origen(reto: Reto) {
			if (reto.house) return 'De la casa';
			if (reto.mine) return 'Tuyo';
			return `De ${reto.author || 'alguien'}`;
		}

		async function quitar(reto: Reto, boton: HTMLButtonElement) {
			if (reto.apiId === undefined) return;
			boton.disabled = true;
			aviso('');

			const res = await pedir(`/api/retos/${reto.apiId}`, 'DELETE');
			// Si ya no estaba, el resultado es el mismo: fuera del tablero.
			if (res.ok || res.status === 404) {
				retos = retos.filter((item) => item.id !== reto.id);
				render();
				void cargar();
				return;
			}

			boton.disabled = false;
			if (res.status === 401) setLogin(null);
			aviso(
				res.status === 401
					? 'Tu sesión ha caducado: entra otra vez para quitarlo.'
					: mensaje(res.status, res.code),
			);
		}

		function card(reto: Reto) {
			const node = template!.content.firstElementChild!.cloneNode(true) as HTMLElement;
			const tema = temaOf(reto.tema);
			const nivel = nivelOf(reto.nivel);
			const hecho = isDone(done, week, reto.id);

			node.style.setProperty('--tema', tema.color);
			node.dataset.hecho = hecho ? 'si' : 'no';
			node.dataset.casa = reto.house ? 'si' : 'no';
			node.dataset.mio = reto.mine ? 'si' : 'no';

			node.querySelector('[data-title]')!.textContent = reto.title;
			node.querySelector('[data-detail]')!.textContent = reto.detail;
			node.querySelector('[data-badge]')!.textContent = tema.label;
			node.querySelector('[data-nivel]')!.textContent =
				`${nivel.label} · ${nivel.points} ${nivel.points === 1 ? 'punto' : 'puntos'}`;
			node.querySelector('[data-origen]')!.textContent = origen(reto);

			const check = node.querySelector<HTMLInputElement>('[data-done]')!;
			check.checked = hecho;
			check.setAttribute('aria-label', hecho ? 'Marcar como pendiente' : 'Marcar como hecho');
			check.addEventListener('change', () => {
				done = toggleDone(done, week, reto.id);
				saveDone(done);
				render();
			});

			if (!reto.mine) return node;

			const remove = node.querySelector<HTMLButtonElement>('[data-remove]')!;
			remove.addEventListener('click', () => void quitar(reto, remove));

			return node;
		}

		function render() {
			const tablero = board();
			list!.replaceChildren(...tablero.map(card));

			const hechos = tablero.filter((reto) => isDone(done, week, reto.id)).length;
			const racha = streakOf(done, week);

			if (doneOut) doneOut.textContent = `${hechos} / ${tablero.length}`;
			if (pointsOut) pointsOut.textContent = String(pointsOf(tablero, done, week));
			if (streakOut) streakOut.textContent = racha === 1 ? '1 semana' : `${racha} semanas`;

			const mios = retos.filter((reto) => reto.mine).length;
			countOut!.textContent = !loaded
				? 'Trayendo los retos de la gente…'
				: retos.length === 0
					? 'Los tres de arriba los pone la casa. Nadie ha propuesto nada esta semana: estrénala tú.'
					: `${retos.length} ${retos.length === 1 ? 'propuesto' : 'propuestos'} por la gente · ` +
						`${mios} de ${PER_PERSON} tuyos · quedan ${Math.max(0, SHARED_MAX - retos.length)} huecos.`;

			tick();
		}

		/** Lo único que corre solo: cuánto le queda a la semana. */
		function tick() {
			if (weekOut) weekOut.textContent = weekLabel(start);
			if (leftOut) leftOut.textContent = `Quedan ${spanText(end - Date.now())}`;
		}

		/**
		 * Los retos de la gente y la semana en la que estamos, que la marca el
		 * servidor. Si falla, se avisa y se vuelve a probar cada vez más tarde.
		 */
		async function cargar() {
			if (loading) {
				again = true;
				return;
			}
			loading = true;
			clearTimeout(retryTimer);

			const res = await pedir('/api/retos');
			const data = res.data;
			loading = false;

			if (!res.ok || !data || typeof data.week !== 'number' || !Array.isArray(data.retos)) {
				retry = Math.min(retry ? retry * 2 : 5_000, 60_000);
				aviso(`No llegan los retos de la gente. Se vuelve a probar en ${Math.round(retry / 1000)} s.`);
				retryTimer = window.setTimeout(() => void cargar(), retry);
				render();
				return;
			}

			retry = 0;
			aviso('');
			const lista: unknown[] = data.retos;
			week = data.week as number;
			if (typeof data.start === 'number') start = data.start;
			end = typeof data.end === 'number' ? data.end : nextWeekStart(start);
			retos = lista.map((item) => fromApi(item)).filter((reto): reto is Reto => reto !== null);
			loaded = true;
			setLogin(typeof data.login === 'string' ? data.login : null);
			render();

			if (again) {
				again = false;
				void cargar();
			}
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			fail('');
			if (sending) return;

			if (retos.filter((item) => item.mine).length >= PER_PERSON) {
				fail(`Ya has propuesto ${PER_PERSON} esta semana. Quita alguno.`);
				return;
			}

			const reto = toReto({
				title: field('title')?.value,
				detail: field('detail')?.value,
				tema: field('tema')?.value,
				nivel: field('nivel')?.value,
			});

			if (typeof reto === 'string') {
				fail(reto);
				return;
			}

			const titulo = reto.title.toLowerCase();
			if (board().some((item) => item.title.toLowerCase() === titulo)) {
				fail('Ese reto ya está en el tablero.');
				return;
			}

			const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			sending = true;
			if (submit) submit.disabled = true;

			const res = await pedir('/api/retos', 'POST', {
				title: reto.title,
				detail: reto.detail,
				tema: reto.tema,
				nivel: reto.nivel,
			});

			sending = false;
			if (submit) submit.disabled = false;

			if (!res.ok) {
				if (res.status === 401) setLogin(null);
				fail(mensaje(res.status, res.code));
				return;
			}

			form.reset();
			field('title')?.focus();
			await cargar();
		});

		/*
		 * Cada medio minuto se repinta la cuenta atrás, y si el lunes ha llegado
		 * con la pestaña abierta, se le pide al servidor la semana nueva: retos
		 * nuevos de la casa, los de la gente a cero y todo por hacer otra vez.
		 */
		setInterval(() => {
			if (Date.now() < end) {
				tick();
				return;
			}
			if (loading || retry) return;
			// Mientras llega, la casa ya cambia con el reloj de aquí.
			start = weekStart(Date.now());
			end = nextWeekStart(start);
			week = weekIndex(start);
			retos = [];
			render();
			void cargar();
		}, 30_000);

		render();
		void cargar();
	}
</script>
