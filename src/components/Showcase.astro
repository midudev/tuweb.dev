---
/**
 * El escaparate: una sección para publicar los SaaS y los proyectos ya
 * terminados. Las fichas salen de /api/escaparate y las ve todo el mundo; para
 * publicar hace falta entrar con GitHub, y cada uno solo quita las suyas.
 */
import GitHubLogin from './GitHubLogin.astro';
import Icon from './Icon.astro';
import { getSessionUser } from '../lib/auth';
import { NAME_MAX, PITCH_MAX, TAGS } from '../lib/showcase';

// Con sesión sale el formulario; sin ella, el enlace para entrar. El script lo
// corrige si la sesión cambia mientras la página está abierta.
const user = await getSessionUser(Astro);

const FIELD =
	'w-full border border-line bg-bg px-3 py-2 text-sm outline-none focus-visible:border-accent';
const BOTON =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent disabled:pointer-events-none disabled:opacity-40';
const ENLACE = 'inline-flex items-center gap-2 text-sm text-muted hover:text-accent';
---

<section id="escaparate" class="flex flex-col gap-7">
	<p data-login hidden={Boolean(user)} class="border border-line bg-panel p-4 text-sm text-muted">
		El escaparate lo ve todo el mundo; para publicar lo tuyo, <GitHubLogin label="entra con GitHub" />.
	</p>

	<form data-form hidden={!user} class="grid gap-4 border border-line bg-panel p-4 md:grid-cols-2">
		<label class="flex flex-col gap-2">
			<span class="text-sm text-muted">Nombre</span>
			<input
				type="text"
				data-field="name"
				maxlength={NAME_MAX}
				autocomplete="off"
				spellcheck="false"
				placeholder="Mi SaaS"
				class={FIELD}
			/>
		</label>

		<label class="flex flex-col gap-2">
			<span class="text-sm text-muted">Enlace</span>
			<input
				type="text"
				data-field="url"
				maxlength="200"
				inputmode="url"
				autocomplete="off"
				spellcheck="false"
				placeholder="misaas.com"
				class={FIELD}
			/>
		</label>

		<label class="flex flex-col gap-2 md:col-span-2">
			<span class="text-sm text-muted">En una línea</span>
			<input
				type="text"
				data-field="pitch"
				maxlength={PITCH_MAX}
				autocomplete="off"
				placeholder="Qué hace y para quién"
				class={FIELD}
			/>
		</label>

		<label class="flex flex-col gap-2">
			<span class="text-sm text-muted">Etiqueta</span>
			<select data-field="tag" class={FIELD}>
				{TAGS.map((tag) => <option value={tag}>{tag}</option>)}
			</select>
		</label>

		<div class="flex items-end justify-between gap-4 md:col-span-1">
			<button type="submit" class={BOTON}>
				<Icon name="plus" class="size-4 shrink-0" />
				Publicar
			</button>
			<p data-error role="status" class="text-sm text-heart"></p>
		</div>
	</form>

	<div
		data-filters
		hidden
		role="group"
		aria-label="Filtrar por etiqueta"
		class="flex flex-wrap gap-2 text-sm"
	>
	</div>

	<ul data-list class="grid gap-4 md:grid-cols-2">
		<li data-house class="flex flex-col gap-3 border border-accent bg-panel p-4">
			<div class="flex items-start justify-between gap-3">
				<a href="/" class="inline-flex items-center gap-2 font-pixel text-accent hover:underline">
					tuweb.dev
				</a>
				<span class="shrink-0 border border-line px-2 py-1 text-xs text-muted">de la casa</span>
			</div>
			<p class="text-sm">Una web que cambia con las ideas de quien la visita. Esta misma.</p>
			<p class="text-xs text-muted"><code>tuweb.dev</code> · en obras siempre</p>
		</li>
	</ul>

	<p data-status role="status" hidden class="text-sm text-heart"></p>

	<p data-count class="text-sm text-muted" aria-live="polite"></p>

	<template data-card>
		<li class="flex flex-col gap-3 border border-line bg-panel p-4">
			<div class="flex items-start justify-between gap-3">
				<a
					data-link
					target="_blank"
					rel="noopener noreferrer nofollow ugc"
					class="inline-flex items-center gap-2 font-pixel text-accent hover:underline"
				>
					<span data-name></span>
					<Icon name="external-link" class="size-4 shrink-0" />
				</a>
				<span data-tag-label class="shrink-0 border border-line px-2 py-1 text-xs text-muted"></span>
			</div>
			<p data-pitch class="text-sm"></p>
			<p class="text-xs text-muted">
				<code data-host></code> · <span data-author></span> · <span data-at></span>
			</p>
			<div data-tools hidden class="flex flex-wrap items-center gap-5 border-t border-line pt-3">
				<button type="button" data-remove class={ENLACE}>
					<Icon name="trash" class="size-4 shrink-0" />
					Quitar
				</button>
			</div>
		</li>
	</template>

	<p class="text-sm text-muted">
		Lo que publicas lo ve todo el mundo, con tu nombre de GitHub. Hasta tres fichas por persona.
	</p>
</section>

<style is:global>
	/*
	 * Va global porque las fichas y los chips los pinta el script y no llevan la
	 * marca del componente; por eso todo cuelga de #escaparate.
	 */

	#escaparate [data-filtro][aria-pressed='true'] {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
</style>

<script>
	import { PER_PERSON, type Project, fromApi, hostOf, toProject } from '../lib/showcase';

	const section = document.querySelector<HTMLElement>('#escaparate');
	const form = section?.querySelector<HTMLFormElement>('[data-form]');
	const list = section?.querySelector<HTMLElement>('[data-list]');
	const template = section?.querySelector<HTMLTemplateElement>('[data-card]');
	const filters = section?.querySelector<HTMLElement>('[data-filters]');
	const errorOut = section?.querySelector<HTMLElement>('[data-error]');
	const statusOut = section?.querySelector<HTMLElement>('[data-status]');
	const loginOut = section?.querySelector<HTMLElement>('[data-login]');
	const countOut = section?.querySelector<HTMLElement>('[data-count]');
	const house = section?.querySelector<HTMLElement>('[data-house]');

	interface Respuesta {
		ok: boolean;
		status: number;
		code: string;
		data: Record<string, unknown> | null;
	}

	/** Una llamada a la API que nunca revienta: si falla la red, status 0. */
	async function pedir(url: string, method = 'GET', body?: unknown): Promise<Respuesta> {
		try {
			const res = await fetch(url, {
				method,
				headers: method === 'GET' ? undefined : { 'Content-Type': 'application/json' },
				body: body === undefined ? undefined : JSON.stringify(body),
			});
			const data = (await res.json().catch(() => null)) as Record<string, unknown> | null;
			const code = typeof data?.error === 'string' ? data.error : '';
			return { ok: res.ok, status: res.status, code, data };
		} catch {
			return { ok: false, status: 0, code: '', data: null };
		}
	}

	/** Lo que dice el servidor, dicho en corto. */
	function mensaje(status: number) {
		if (status === 400) return 'A la ficha le falta algo o algo no vale. Revísala.';
		if (status === 401) return 'Entra con GitHub para publicar.';
		if (status === 403) return 'La petición no salió de esta web. Recarga la página.';
		if (status === 404) return 'Esa ficha ya no está.';
		if (status === 409) return `Ya tienes ${PER_PERSON} fichas publicadas. Quita alguna.`;
		if (status === 422) return 'Eso parece spam: sin enlaces en el nombre ni letras repetidas.';
		if (status === 429) return 'Más despacio: espera un minuto y vuelve a probar.';
		return 'No se pudo hablar con el servidor. Prueba otra vez.';
	}

	if (section && form && list && template && filters && countOut) {
		const CHIP =
			'border border-line px-3 py-2 text-muted hover:border-accent hover:text-accent';

		/** Las fichas de todo el mundo, tal como vinieron la última vez. */
		let projects: Project[] = [];
		let filter = '';
		let loaded = false;
		let loading = false;
		/** Si alguien pidió cargar mientras ya se cargaba, se repite al acabar. */
		let again = false;
		let retry = 0;
		let retryTimer = 0;
		let sending = false;

		function field(name: string) {
			return form!.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-field="${name}"]`);
		}

		function fail(message: string) {
			if (errorOut) errorOut.textContent = message;
		}

		function aviso(message: string) {
			if (!statusOut) return;
			statusOut.textContent = message;
			statusOut.hidden = !message;
		}

		/** Con sesión, el formulario; sin ella, el enlace para entrar. */
		function setLogin(login: string | null) {
			form!.hidden = !login;
			if (loginOut) loginOut.hidden = Boolean(login);
		}

		function fecha(at: number) {
			return new Date(at).toLocaleDateString('es-ES', {
				day: 'numeric',
				month: 'short',
				year: 'numeric',
			});
		}

		async function quitar(project: Project, boton: HTMLButtonElement) {
			boton.disabled = true;
			aviso('');

			const res = await pedir(`/api/escaparate/${project.id}`, 'DELETE');
			// Si ya no estaba, el resultado es el mismo: fuera del escaparate.
			if (res.ok || res.status === 404) {
				projects = projects.filter((item) => item.id !== project.id);
				render();
				void cargar();
				return;
			}

			boton.disabled = false;
			if (res.status === 401) setLogin(null);
			aviso(mensaje(res.status));
		}

		function card(project: Project) {
			const node = template!.content.firstElementChild!.cloneNode(true) as HTMLElement;
			node.dataset.tag = project.tag;

			const link = node.querySelector<HTMLAnchorElement>('[data-link]')!;
			// fromApi ya ha cribado la URL: o es http(s) o viene vacía, y sin ella
			// no hay enlace.
			if (project.url) link.href = project.url;
			node.querySelector('[data-name]')!.textContent = project.name;
			node.querySelector('[data-tag-label]')!.textContent = project.tag;
			node.querySelector('[data-pitch]')!.textContent = project.pitch;
			node.querySelector('[data-host]')!.textContent = project.url ? hostOf(project.url) : 'sin enlace';
			node.querySelector('[data-at]')!.textContent = fecha(project.at);
			node.querySelector('[data-author]')!.textContent = project.mine
				? 'tuya'
				: `de ${project.author || 'alguien'}`;

			// Solo se quita lo que publicaste tú.
			const tools = node.querySelector<HTMLElement>('[data-tools]');
			if (tools) tools.hidden = !project.mine;
			if (project.mine) {
				const remove = node.querySelector<HTMLButtonElement>('[data-remove]')!;
				remove.addEventListener('click', () => void quitar(project, remove));
			}

			return node;
		}

		/** Los chips: «Todo» y las etiquetas que de verdad hay publicadas. */
		function renderFilters() {
			const tags = [...new Set(projects.map((project) => project.tag))].sort();

			// Con una etiqueta sola no hay nada que filtrar: fuera los chips y fuera
			// el filtro, no vaya a quedarse uno puesto sin forma de quitarlo.
			filters!.hidden = tags.length < 2;
			if (tags.length < 2) {
				filter = '';
				filters!.replaceChildren();
				return;
			}

			if (filter && !tags.includes(filter)) filter = '';

			filters!.replaceChildren(
				...['', ...tags].map((tag) => {
					const chip = document.createElement('button');
					chip.type = 'button';
					chip.dataset.filtro = tag;
					chip.className = CHIP;
					chip.setAttribute('aria-pressed', String(tag === filter));
					chip.textContent = tag
						? `${tag} (${projects.filter((project) => project.tag === tag).length})`
						: `Todo (${projects.length})`;
					chip.addEventListener('click', () => {
						filter = tag;
						render();
					});
					return chip;
				}),
			);
		}

		function render() {
			// Primero los chips, que son los que deciden si el filtro sigue en pie.
			renderFilters();

			const shown = filter ? projects.filter((project) => project.tag === filter) : projects;

			for (const old of list!.querySelectorAll('li:not([data-house])')) old.remove();
			list!.append(...shown.map(card));

			// La ficha de la casa está siempre, salvo cuando se filtra: entonces manda
			// la etiqueta y esta no tiene ninguna.
			if (house) house.hidden = Boolean(filter);

			const total = projects.length;
			const mias = projects.filter((project) => project.mine).length;
			countOut!.textContent = !loaded
				? 'Trayendo el escaparate…'
				: total === 0
					? 'Todavía no ha publicado nadie. Empieza por lo tuyo.'
					: `${total} ${total === 1 ? 'proyecto publicado' : 'proyectos publicados'} · ` +
						`${mias} de ${PER_PERSON} tuyos.`;
		}

		/** Las fichas de todo el mundo. Si falla, se avisa y se vuelve a probar cada vez más tarde. */
		async function cargar() {
			if (loading) {
				again = true;
				return;
			}
			loading = true;
			clearTimeout(retryTimer);

			const res = await pedir('/api/escaparate');
			const data = res.data;
			loading = false;

			if (!res.ok || !data || !Array.isArray(data.projects)) {
				retry = Math.min(retry ? retry * 2 : 5_000, 60_000);
				aviso(`No llega el escaparate. Se vuelve a probar en ${Math.round(retry / 1000)} s.`);
				retryTimer = window.setTimeout(() => void cargar(), retry);
				return;
			}

			retry = 0;
			aviso('');
			const filas: unknown[] = data.projects;
			projects = filas.map((item) => fromApi(item)).filter((item): item is Project => item !== null);
			loaded = true;
			setLogin(typeof data.login === 'string' ? data.login : null);
			render();

			if (again) {
				again = false;
				void cargar();
			}
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			fail('');
			if (sending) return;

			if (projects.filter((item) => item.mine).length >= PER_PERSON) {
				fail(`Ya tienes ${PER_PERSON} fichas publicadas. Quita alguna.`);
				return;
			}

			const project = toProject({
				name: field('name')?.value,
				url: field('url')?.value,
				pitch: field('pitch')?.value,
				tag: field('tag')?.value,
			});

			if (typeof project === 'string') {
				fail(project);
				return;
			}

			if (projects.some((item) => item.url === project.url)) {
				fail('Ese enlace ya está en el escaparate.');
				return;
			}

			const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			sending = true;
			if (submit) submit.disabled = true;

			const res = await pedir('/api/escaparate', 'POST', project);

			sending = false;
			if (submit) submit.disabled = false;

			if (!res.ok) {
				if (res.status === 401) setLogin(null);
				fail(mensaje(res.status));
				return;
			}

			// Lo último publicado sale primero, y sin filtro para que se vea.
			filter = '';
			form.reset();
			field('name')?.focus();
			await cargar();
		});

		render();
		void cargar();
	}
</script>
