---
/**
 * El problema algorítmico de la semana: enunciado, ejemplo y la entrada de esta
 * semana, que es la misma para todo el mundo. Lo resuelves con tu código y pegas
 * la respuesta; si acierta, medalla. La destacada —a la primera y pronto— sale
 * en tu perfil. Todo se calcula y se guarda en tu navegador.
 */
import Icon from './Icon.astro';
import { MEDALLAS } from '../lib/problemas';

const BOTON =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent disabled:pointer-events-none disabled:opacity-40';
const ENLACE = 'inline-flex items-center gap-2 text-sm text-muted hover:text-accent';
const PRE = 'overflow-x-auto border border-line bg-bg p-3 text-xs leading-relaxed';
---

<section id="problema" class="flex flex-col gap-4 border border-line bg-panel p-4" aria-labelledby="problema-titulo">
	<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
		<h2 id="problema-titulo" class="inline-flex items-center gap-2 font-pixel text-lg font-normal">
			<Icon name="binary-tree" class="size-5 shrink-0 text-accent" />
			Problema de la semana
		</h2>
		<p class="inline-flex items-center gap-2 text-sm text-muted">
			<Icon name="crown" class="size-4 shrink-0 text-mark" />
			<span data-oro aria-live="polite"></span>
		</p>
	</div>

	<div class="flex flex-col gap-2">
		<h3 data-titulo class="text-base"></h3>
		<p data-enunciado class="text-sm"></p>
		<p data-formato class="text-xs text-muted"></p>
	</div>

	<div class="grid gap-3 sm:grid-cols-2">
		<div class="flex flex-col gap-2">
			<span class="text-xs text-muted">Ejemplo de entrada</span>
			<pre data-ej-entrada class={PRE}></pre>
		</div>
		<div class="flex flex-col gap-2">
			<span class="text-xs text-muted">Su respuesta</span>
			<pre data-ej-salida class={PRE}></pre>
		</div>
	</div>

	<div class="flex flex-col gap-2">
		<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
			<span class="text-xs text-muted">Tu entrada de esta semana</span>
			<span class="flex flex-wrap gap-x-5 gap-y-2">
				<button type="button" data-copiar class={ENLACE}>
					<Icon name="copy" class="size-4 shrink-0" />
					<span data-copiar-label>Copiar</span>
				</button>
				<button type="button" data-bajar class={ENLACE}>
					<Icon name="download" class="size-4 shrink-0" />
					.txt
				</button>
			</span>
		</div>
		<pre data-entrada class={`${PRE} max-h-48 overflow-y-auto whitespace-pre-wrap break-all`}></pre>
	</div>

	<details class="text-sm">
		<summary class="cursor-pointer text-muted hover:text-accent">Pista</summary>
		<p data-pista class="mt-2 border-l-2 border-line pl-3 text-muted"></p>
	</details>

	<form data-form class="flex flex-wrap items-end gap-3">
		<label class="flex flex-col gap-2">
			<span class="text-sm text-muted">Tu respuesta</span>
			<input
				type="text"
				data-respuesta
				inputmode="numeric"
				autocomplete="off"
				maxlength="24"
				class="w-48 border border-line bg-bg px-3 py-2 text-sm tabular-nums outline-none focus-visible:border-accent"
			/>
		</label>
		<button type="submit" data-enviar class={BOTON}>
			<Icon name="check" class="size-4 shrink-0" />
			Comprobar
		</button>
		<p data-estado role="status" class="text-sm"></p>
	</form>

	<p data-medalla hidden class="inline-flex items-center gap-2 border border-mark p-3 text-sm">
		<span data-medalla-texto></span>
	</p>

	<ul class="flex flex-col gap-1 border-t border-line pt-3 text-xs text-muted">
		{
			(Object.keys(MEDALLAS) as (keyof typeof MEDALLAS)[]).map((id) => (
				<li class="inline-flex items-center gap-2">
					<Icon name={MEDALLAS[id].icon} class={`size-4 shrink-0 ${id === 'oro' ? 'text-mark' : ''}`} />
					<span class={id === 'oro' ? 'text-mark' : 'text-fg'}>{MEDALLAS[id].label}</span>
					{MEDALLAS[id].detail}
				</li>
			))
		}
		<li class="mt-1">
			Aquí no se ejecuta nada: resuélvelo en tu máquina, con el lenguaje que quieras, y pega el número.
			La destacada sale en tu <a href="/perfil" class="text-accent hover:underline">perfil</a>. El lunes,
			problema nuevo.
		</li>
	</ul>
</section>

<script>
	import {
		MEDALLAS,
		ORO_HORAS,
		entradaDe,
		intentar,
		lunesDe,
		medallaDe,
		problemaDe,
		readRegistro,
		saveRegistro,
	} from '../lib/problemas';
	import { spanText, weekIndex, weekStart } from '../lib/retos';

	const section = document.querySelector<HTMLElement>('#problema');
	const form = section?.querySelector<HTMLFormElement>('[data-form]');
	const input = section?.querySelector<HTMLInputElement>('[data-respuesta]');
	const enviar = section?.querySelector<HTMLButtonElement>('[data-enviar]');
	const estado = section?.querySelector<HTMLElement>('[data-estado]');

	if (section && form && input && enviar && estado) {
		const week = weekIndex(weekStart(Date.now()));
		const problema = problemaDe(week);
		const entrada = entradaDe(week);

		const poner = (attr: string, texto: string) => {
			const out = section.querySelector<HTMLElement>(`[data-${attr}]`);
			if (out) out.textContent = texto;
		};

		poner('titulo', problema.title);
		poner('enunciado', problema.enunciado);
		poner('formato', problema.formato);
		poner('ej-entrada', problema.ejemplo.entrada);
		poner('ej-salida', problema.ejemplo.salida);
		poner('pista', problema.pista);
		poner('entrada', entrada);

		function pintar() {
			const intento = readRegistro()[String(week)];
			const medalla = medallaDe(intento);
			const resta = lunesDe(week) + ORO_HORAS * 60 * 60 * 1000 - Date.now();

			// La destacada pide acertar a la primera: un fallo ya la deja fuera.
			if (medalla === 'oro') poner('oro', 'Destacada: tuya');
			else if (intento) poner('oro', 'Destacada: esta semana no');
			else if (resta > 0) poner('oro', `Destacada: quedan ${spanText(resta)}`);
			else poner('oro', 'Destacada: cerrada');

			input!.disabled = Boolean(intento?.ok);
			enviar!.disabled = Boolean(intento?.ok);
			const caja = section!.querySelector<HTMLElement>('[data-medalla]')!;
			caja.hidden = !medalla;
			if (medalla) {
				const veces = intento!.intentos === 1 ? 'a la primera' : `en ${intento!.intentos} intentos`;
				poner('medalla-texto', `Resuelto ${veces}. Medalla: ${MEDALLAS[medalla].label}.`);
				caja.classList.toggle('text-mark', medalla === 'oro');
			}
		}

		const llevas = (n: number) => `Llevas ${n} ${n === 1 ? 'intento' : 'intentos'}.`;

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			if (!input.value.trim()) {
				estado.className = 'text-sm text-heart';
				estado.textContent = 'Escribe un número.';
				return;
			}
			const { registro, ok } = intentar(readRegistro(), week, input.value, Date.now());
			saveRegistro(registro);
			estado.className = ok ? 'text-sm text-ok' : 'text-sm text-heart';
			estado.textContent = ok
				? 'Correcto.'
				: `No es esa. Revisa los bordes y vuelve a probar. ${llevas(registro[String(week)].intentos)}`;
			pintar();
		});

		const copiarLabel = section.querySelector<HTMLElement>('[data-copiar-label]');
		section.querySelector('[data-copiar]')?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(entrada);
				if (copiarLabel) copiarLabel.textContent = 'Copiada';
			} catch {
				if (copiarLabel) copiarLabel.textContent = 'No se pudo';
			}
			setTimeout(() => {
				if (copiarLabel) copiarLabel.textContent = 'Copiar';
			}, 1500);
		});

		section.querySelector('[data-bajar]')?.addEventListener('click', () => {
			const url = URL.createObjectURL(new Blob([`${entrada}\n`], { type: 'text/plain' }));
			const enlace = document.createElement('a');
			enlace.href = url;
			enlace.download = `problema-${problema.id}-${week}.txt`;
			enlace.click();
			setTimeout(() => URL.revokeObjectURL(url), 1000);
		});

		pintar();
		const previo = readRegistro()[String(week)];
		if (previo && !previo.ok) estado.textContent = llevas(previo.intentos);
		window.addEventListener('storage', (event) => {
			if (event.key === null || event.key === 'tuweb:problema-semana') pintar();
		});
	}
</script>
