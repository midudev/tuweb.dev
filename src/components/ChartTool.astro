---
/**
 * De datos a gráfico: se escriben en la tabla o se pega un CSV, se elige el
 * tipo y la plantilla y sale el SVG al momento, listo para bajar en SVG o PNG.
 * Todo se pinta en el navegador; no se guarda ni se envía nada.
 */
import { MAX_ROWS, MAX_SERIES, TEMPLATES, TYPES } from '../lib/chart';
import Icon from './Icon.astro';

const OPCION =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent';
const CAMPO = 'w-full border border-line bg-panel px-3 py-2 text-sm outline-none focus-visible:border-accent';

const TEXTOS = [
	{ id: 'title', label: 'Título' },
	{ id: 'subtitle', label: 'Subtítulo' },
	{ id: 'note', label: 'Nota al pie' },
];
---

<div
	role="tabpanel"
	id="graficos"
	aria-labelledby="tab-graficos"
	data-panel="graficos"
	hidden
	class="grid gap-7 md:grid-cols-2"
>
	<div class="flex min-w-0 flex-col gap-6">
		<div class="flex flex-col gap-3">
			<h3 id="graf-tipo" class="text-sm text-muted">Tipo</h3>
			<div role="group" aria-labelledby="graf-tipo" class="flex flex-wrap gap-2">
				{
					TYPES.map((type) => (
						<button type="button" data-graf-tipo={type.id} aria-pressed="false" class={OPCION}>
							<Icon name={type.icon} class="size-4 shrink-0" />
							{type.label}
						</button>
					))
				}
			</div>
		</div>

		<div class="flex flex-col gap-3">
			<h3 id="graf-plantilla" class="text-sm text-muted">Plantilla</h3>
			<div role="group" aria-labelledby="graf-plantilla" class="flex flex-wrap gap-2">
				{
					TEMPLATES.map((template) => (
						<button type="button" data-graf-plantilla={template.id} aria-pressed="false" class={OPCION}>
							{template.label}
						</button>
					))
				}
			</div>
		</div>

		<div class="flex flex-col gap-3">
			{
				TEXTOS.map((campo) => (
					<label class="flex flex-col gap-1">
						<span class="text-sm text-muted">{campo.label}</span>
						<input type="text" data-graf-texto={campo.id} maxlength="160" class={CAMPO} />
					</label>
				))
			}
		</div>

		<div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
			<label class="inline-flex items-center gap-2">
				<input type="checkbox" data-graf-check="showValues" class="size-4 accent-accent" />
				Valores
			</label>
			<label class="inline-flex items-center gap-2">
				<input type="checkbox" data-graf-check="showLegend" class="size-4 accent-accent" />
				Leyenda
			</label>
			<label class="inline-flex items-center gap-2">
				<input type="checkbox" data-graf-oscuro class="size-4 accent-accent" />
				Fondo oscuro
			</label>
		</div>

		<div class="flex flex-col gap-3">
			<h3 class="text-sm text-muted">Datos</h3>
			<div class="overflow-x-auto">
				<table data-graf-tabla class="border-separate border-spacing-1 text-sm"></table>
			</div>
			<div class="flex flex-wrap gap-2">
				<button type="button" data-graf-fila class={OPCION}>
					<Icon name="row-insert-bottom" class="size-4 shrink-0" />
					Fila
				</button>
				<button type="button" data-graf-serie class={OPCION}>
					<Icon name="column-insert-right" class="size-4 shrink-0" />
					Serie
				</button>
			</div>
			<p data-graf-pista class="text-sm text-muted empty:hidden"></p>
		</div>

		<div class="flex flex-col gap-2">
			<span class="flex flex-wrap items-center justify-between gap-2 text-sm text-muted">
				<label for="graf-csv">CSV (coma, punto y coma o tabulador)</label>
				<label class="inline-flex cursor-pointer items-center gap-2 text-accent hover:underline">
					<Icon name="file-upload" class="size-4 shrink-0" />
					Cargar fichero
					<input type="file" data-graf-fichero accept=".csv,.tsv,.txt,text/csv,text/plain" class="sr-only" />
				</label>
			</span>
			<textarea
				id="graf-csv"
				data-graf-csv
				rows="7"
				spellcheck="false"
				class="w-full resize-y border border-line bg-panel p-4 text-sm outline-none focus-visible:border-accent"
			></textarea>
			<p data-graf-aviso class="text-sm text-muted empty:hidden" aria-live="polite"></p>
		</div>
	</div>

	<div class="flex min-w-0 flex-col gap-4 md:sticky md:top-6 md:self-start">
		<span class="text-sm text-muted">Así queda</span>
		<div data-graf-previo class="border border-line [&>svg]:block [&>svg]:h-auto [&>svg]:w-full"></div>
		<div class="flex flex-wrap items-center gap-2">
			<button type="button" data-graf-baja="svg" class={OPCION}>
				<Icon name="file-type-svg" class="size-4 shrink-0" />
				Descargar .svg
			</button>
			<button type="button" data-graf-baja="png" class={OPCION}>
				<Icon name="file-type-png" class="size-4 shrink-0" />
				Descargar .png
			</button>
		</div>
		<p class="text-sm text-muted">
			Hasta {MAX_ROWS} filas y {MAX_SERIES} series. La tarta usa la primera serie. Pasa el ratón por
			encima para ver cada valor.
		</p>
	</div>

	<template data-graf-icono="x"><Icon name="x" class="size-4 shrink-0" /></template>
</div>

<script>
	import { DEFAULT_CHART, MAX_ROWS, MAX_SERIES, PALETTE, type Chart, type ChartType, type Template, type Theme, buildSvg, fromCsv, toCsv } from '../lib/chart';

	const previo = document.querySelector<HTMLElement>('[data-graf-previo]');
	const tabla = document.querySelector<HTMLTableElement>('[data-graf-tabla]');
	const csv = document.querySelector<HTMLTextAreaElement>('[data-graf-csv]');
	const aviso = document.querySelector<HTMLElement>('[data-graf-aviso]');
	const pista = document.querySelector<HTMLElement>('[data-graf-pista]');
	const oscuro = document.querySelector<HTMLInputElement>('[data-graf-oscuro]');
	const icono = document.querySelector<HTMLTemplateElement>('[data-graf-icono="x"]');

	const CAMPO = 'w-full min-w-20 border border-line bg-panel px-2 py-1 text-sm outline-none focus-visible:border-accent';
	const COLOR = 'h-8 w-9 shrink-0 cursor-pointer border border-line bg-panel p-0.5';
	const QUITAR = 'inline-flex shrink-0 items-center p-1 text-muted hover:text-accent disabled:opacity-30 disabled:hover:text-muted';

	type Texto = 'title' | 'subtitle' | 'note';
	type Check = 'showValues' | 'showLegend';

	// Arranca con el fondo de la web: quien la lee de noche, se lo encuentra oscuro.
	const deNoche = document.documentElement.dataset.modo === 'oscuro';
	let grafico: Chart = structuredClone(DEFAULT_CHART);
	if (deNoche) grafico = recolorea(grafico, 'oscuro');

	/** Al cambiar de fondo, los colores de la paleta pasan a su paso del otro modo; los elegidos a mano se quedan. */
	function recolorea(chart: Chart, theme: Theme): Chart {
		const paso = (color: string) => {
			const i = PALETTE[chart.theme].indexOf(color);
			return i >= 0 ? PALETTE[theme][i] : color;
		};
		return {
			...chart,
			theme,
			series: chart.series.map((s) => ({ ...s, color: paso(s.color) })),
			rows: chart.rows.map((r) => ({ ...r, color: paso(r.color) })),
		};
	}

	function campo(value: string, data: Record<string, string>, label: string, numerico = false) {
		const input = document.createElement('input');
		input.type = 'text';
		input.value = value;
		input.maxLength = 80;
		input.className = CAMPO;
		input.setAttribute('aria-label', label);
		if (numerico) {
			input.inputMode = 'decimal';
			input.classList.add('text-right');
		}
		Object.assign(input.dataset, data);
		return input;
	}

	function color(value: string, data: Record<string, string>, label: string) {
		const input = document.createElement('input');
		input.type = 'color';
		input.value = value;
		input.className = COLOR;
		input.setAttribute('aria-label', label);
		Object.assign(input.dataset, data);
		return input;
	}

	function quitar(data: Record<string, string>, label: string, disabled: boolean) {
		const button = document.createElement('button');
		button.type = 'button';
		button.className = QUITAR;
		button.disabled = disabled;
		button.setAttribute('aria-label', label);
		button.title = label;
		if (icono) button.append(icono.content.cloneNode(true));
		Object.assign(button.dataset, data);
		return button;
	}

	function celda(tag: 'th' | 'td', ...hijos: HTMLElement[]) {
		const cell = document.createElement(tag);
		cell.className = 'p-0 align-middle font-normal';
		const caja = document.createElement('div');
		caja.className = 'flex items-center gap-1';
		caja.append(...hijos);
		cell.append(caja);
		return cell;
	}

	/** La tabla se rehace solo cuando cambia su forma; al escribir, se toca el estado y ya. */
	function pintaTabla() {
		if (!tabla) return;
		const pie = grafico.type === 'tarta';
		const cabecera = document.createElement('tr');
		cabecera.append(celda('th', campo(grafico.labelHeader, { grafCabecera: '' }, 'Nombre de la columna de etiquetas')));
		grafico.series.forEach((serie, j) => {
			const hijos: HTMLElement[] = [];
			if (!pie) hijos.push(color(serie.color, { grafSerieColor: String(j) }, `Color de ${serie.name}`));
			hijos.push(campo(serie.name, { grafSerieNombre: String(j) }, `Nombre de la serie ${j + 1}`));
			hijos.push(quitar({ grafQuitaSerie: String(j) }, 'Quitar serie', grafico.series.length <= 1));
			cabecera.append(celda('th', ...hijos));
		});

		const filas = grafico.rows.map((row, i) => {
			const tr = document.createElement('tr');
			const hijos: HTMLElement[] = [];
			if (pie) hijos.push(color(row.color, { grafFilaColor: String(i) }, `Color de ${row.label || `la fila ${i + 1}`}`));
			hijos.push(campo(row.label, { grafEtiqueta: String(i) }, `Etiqueta de la fila ${i + 1}`));
			tr.append(celda('td', ...hijos));
			grafico.series.forEach((serie, j) => {
				tr.append(celda('td', campo(row.cells[j] ?? '', { grafCelda: `${i},${j}` }, `${row.label || `Fila ${i + 1}`}, ${serie.name}`, true)));
			});
			tr.append(celda('td', quitar({ grafQuitaFila: String(i) }, 'Quitar fila', grafico.rows.length <= 1)));
			return tr;
		});

		const thead = document.createElement('thead');
		thead.append(cabecera);
		const tbody = document.createElement('tbody');
		tbody.append(...filas);
		tabla.replaceChildren(thead, tbody);

		document.querySelector<HTMLButtonElement>('[data-graf-fila]')!.disabled = grafico.rows.length >= MAX_ROWS;
		document.querySelector<HTMLButtonElement>('[data-graf-serie]')!.disabled = grafico.series.length >= MAX_SERIES;
		if (pista) {
			pista.textContent =
				pie && grafico.series.length > 1
					? `La tarta solo dibuja «${grafico.series[0].name}». El color de cada trozo va en su fila.`
					: '';
		}
	}

	function pintaControles() {
		document.querySelectorAll<HTMLButtonElement>('[data-graf-tipo]').forEach((button) => {
			button.setAttribute('aria-pressed', String(button.dataset.grafTipo === grafico.type));
		});
		document.querySelectorAll<HTMLButtonElement>('[data-graf-plantilla]').forEach((button) => {
			button.setAttribute('aria-pressed', String(button.dataset.grafPlantilla === grafico.template));
		});
		document.querySelectorAll<HTMLInputElement>('[data-graf-texto]').forEach((input) => {
			input.value = grafico[input.dataset.grafTexto as Texto];
		});
		document.querySelectorAll<HTMLInputElement>('[data-graf-check]').forEach((input) => {
			input.checked = grafico[input.dataset.grafCheck as Check];
		});
		if (oscuro) oscuro.checked = grafico.theme === 'oscuro';
	}

	function pinta({ conCsv = true } = {}) {
		if (previo) previo.innerHTML = buildSvg(grafico).svg;
		if (conCsv && csv) csv.value = toCsv(grafico);
	}

	function todo() {
		pintaControles();
		pintaTabla();
		pinta();
	}

	document.querySelectorAll<HTMLButtonElement>('[data-graf-tipo]').forEach((button) => {
		button.addEventListener('click', () => {
			const antes = grafico.type;
			grafico.type = button.dataset.grafTipo as ChartType;
			pintaControles();
			// Los colores cambian de sitio (serie o fila) solo al entrar o salir de la tarta.
			if ((antes === 'tarta') !== (grafico.type === 'tarta')) pintaTabla();
			pinta({ conCsv: false });
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-graf-plantilla]').forEach((button) => {
		button.addEventListener('click', () => {
			grafico.template = button.dataset.grafPlantilla as Template;
			pintaControles();
			pinta({ conCsv: false });
		});
	});

	document.querySelectorAll<HTMLInputElement>('[data-graf-texto]').forEach((input) => {
		input.addEventListener('input', () => {
			grafico[input.dataset.grafTexto as Texto] = input.value;
			pinta({ conCsv: false });
		});
	});

	document.querySelectorAll<HTMLInputElement>('[data-graf-check]').forEach((input) => {
		input.addEventListener('change', () => {
			grafico[input.dataset.grafCheck as Check] = input.checked;
			pinta({ conCsv: false });
		});
	});

	oscuro?.addEventListener('change', () => {
		grafico = recolorea(grafico, oscuro.checked ? 'oscuro' : 'claro');
		pintaTabla();
		pinta({ conCsv: false });
	});

	tabla?.addEventListener('input', (event) => {
		const input = event.target as HTMLInputElement;
		const { grafCabecera, grafSerieNombre, grafSerieColor, grafFilaColor, grafEtiqueta, grafCelda } = input.dataset;
		if (grafCabecera !== undefined) grafico.labelHeader = input.value;
		else if (grafSerieNombre) grafico.series[Number(grafSerieNombre)].name = input.value;
		else if (grafSerieColor) grafico.series[Number(grafSerieColor)].color = input.value;
		else if (grafFilaColor) grafico.rows[Number(grafFilaColor)].color = input.value;
		else if (grafEtiqueta) grafico.rows[Number(grafEtiqueta)].label = input.value;
		else if (grafCelda) {
			const [i, j] = grafCelda.split(',').map(Number);
			grafico.rows[i].cells[j] = input.value;
		} else return;
		pinta();
	});

	tabla?.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
		if (!button || button.disabled) return;
		const { grafQuitaSerie, grafQuitaFila } = button.dataset;
		if (grafQuitaSerie) {
			const j = Number(grafQuitaSerie);
			grafico.series.splice(j, 1);
			grafico.rows.forEach((row) => row.cells.splice(j, 1));
		} else if (grafQuitaFila) {
			grafico.rows.splice(Number(grafQuitaFila), 1);
		} else return;
		pintaTabla();
		pinta();
	});

	/** El primer color de la paleta que no esté ya en uso: así nadie hereda el de otro. */
	function libre(usados: string[]) {
		const paleta = PALETTE[grafico.theme];
		return paleta.find((c) => !usados.includes(c)) ?? paleta[usados.length % paleta.length];
	}

	document.querySelector<HTMLButtonElement>('[data-graf-fila]')?.addEventListener('click', () => {
		if (grafico.rows.length >= MAX_ROWS) return;
		grafico.rows.push({
			label: `Fila ${grafico.rows.length + 1}`,
			color: libre(grafico.rows.map((r) => r.color)),
			cells: grafico.series.map(() => ''),
		});
		pintaTabla();
		pinta();
		tabla?.querySelector<HTMLInputElement>('tbody tr:last-child input[type="text"]')?.select();
	});

	document.querySelector<HTMLButtonElement>('[data-graf-serie]')?.addEventListener('click', () => {
		if (grafico.series.length >= MAX_SERIES) return;
		grafico.series.push({ name: `Serie ${grafico.series.length + 1}`, color: libre(grafico.series.map((s) => s.color)) });
		grafico.rows.forEach((row) => row.cells.push(''));
		pintaTabla();
		pinta();
	});

	function aplicaCsv(texto: string) {
		const resultado = fromCsv(texto, grafico);
		if ('error' in resultado) {
			if (aviso) aviso.textContent = resultado.error;
			return;
		}
		grafico = resultado.chart;
		if (aviso) aviso.textContent = resultado.aviso;
		pintaControles();
		pintaTabla();
		pinta({ conCsv: false });
	}

	csv?.addEventListener('input', () => aplicaCsv(csv.value));

	const fichero = document.querySelector<HTMLInputElement>('[data-graf-fichero]');
	fichero?.addEventListener('change', async () => {
		const file = fichero.files?.[0];
		fichero.value = '';
		if (!file) return;
		if (file.size > 1_000_000) {
			if (aviso) aviso.textContent = 'Ese fichero pasa de 1 MB: para un gráfico sobra.';
			return;
		}
		const texto = await file.text();
		if (csv) csv.value = texto;
		aplicaCsv(texto);
	});

	function nombre(extension: string) {
		const base = grafico.title
			.normalize('NFD')
			.replace(/[̀-ͯ]/g, '')
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-|-$/g, '')
			.slice(0, 40);
		return `${base || 'grafico'}.${extension}`;
	}

	function bajar(fichero: Blob, name: string) {
		const url = URL.createObjectURL(fichero);
		const enlace = document.createElement('a');
		enlace.href = url;
		enlace.download = name;
		enlace.click();
		// Soltar la URL en el mismo tick corta la descarga en algún navegador.
		setTimeout(() => URL.revokeObjectURL(url), 1000);
	}

	/*
	 * Un SVG pintado como imagen no ve las fuentes de la página, así que para el
	 * PNG van dentro. Son las mismas que sirve la web; se piden una vez y ya.
	 */
	const FUENTES = [
		['Geist Mono Variable', '/fonts/geist-mono-latin-wght-normal.woff2', '100 900'],
		['Geist Pixel', '/fonts/geist-pixel-latin-400-normal.woff2', '400'],
	];
	let fuentesCss: Promise<string> | null = null;

	function fuentes() {
		fuentesCss ??= Promise.all(
			FUENTES.map(async ([family, url, weight]) => {
				const blob = await (await fetch(url)).blob();
				const data = await new Promise<string>((resolve, reject) => {
					const lector = new FileReader();
					lector.onload = () => resolve(String(lector.result));
					lector.onerror = () => reject(lector.error);
					lector.readAsDataURL(blob);
				});
				return `@font-face{font-family:'${family}';font-weight:${weight};src:url(${data}) format('woff2');}`;
			}),
		)
			.then((reglas) => reglas.join(''))
			.catch(() => '');
		return fuentesCss;
	}

	async function png() {
		const { svg, width, height } = buildSvg(grafico, { fontCss: await fuentes() });
		const imagen = new Image();
		imagen.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
		await imagen.decode();
		// Al doble, para que se vea nítido en pantallas densas y al imprimir.
		const lienzo = document.createElement('canvas');
		lienzo.width = width * 2;
		lienzo.height = height * 2;
		lienzo.getContext('2d')?.drawImage(imagen, 0, 0, lienzo.width, lienzo.height);
		const blob = await new Promise<Blob | null>((resolve) => lienzo.toBlob(resolve, 'image/png'));
		if (!blob) throw new Error('sin PNG');
		bajar(blob, nombre('png'));
	}

	document.querySelectorAll<HTMLButtonElement>('[data-graf-baja]').forEach((button) => {
		button.addEventListener('click', async () => {
			if (button.dataset.grafBaja === 'svg') {
				bajar(new Blob([buildSvg(grafico).svg], { type: 'image/svg+xml' }), nombre('svg'));
				return;
			}
			button.disabled = true;
			try {
				await png();
				if (aviso) aviso.textContent = '';
			} catch {
				if (aviso) aviso.textContent = 'No se pudo sacar el PNG. Prueba con el SVG.';
			} finally {
				button.disabled = false;
			}
		});
	});

	todo();
</script>
