---
/**
 * Píxeles ASCII: un lienzo de 48 × 24 que se pinta a píxeles y se escribe solo
 * en ASCII, un carácter por tono, con el ratón o con comandos desde la consola. Va en directo entre las pestañas de tu
 * navegador con BroadcastChannel —cursores con firma y destello en lo que llega—
 * y, para sumar a otra gente, el dibujo viaja en
 * el enlace: quien lo abre lo junta con el suyo y sigue. Cada hora se queda una
 * copia del lienzo, las últimas 24, para volver a ella, y cada píxel se apunta
 * en un diario para repetir cómo se pintó la zona. No hay servidor.
 *
 * La obra no tiene bordes: el lienzo es una zona y al lado de cada zona hay
 * otra. Se cambia de zona con las flechas, el mapa o «ir x y», y cada zona se
 * guarda, viaja en el enlace y se comparte en directo como la primera.
 */
import Icon from './Icon.astro';

const TONOS = [' ', '.', ':', '+', '#', '@'];
const BOTON =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent';
---

<section id="pixeles-ascii" class="grid gap-6 lg:grid-cols-[3fr_2fr] lg:items-start">
	<div class="flex min-w-0 flex-col gap-4">
		<p data-pa-aviso class="text-sm text-mark" aria-live="polite" hidden></p>

		<div class="flex flex-wrap items-center gap-3">
			<span class="flex items-center gap-2 text-sm text-muted">
				<Icon name="map" class="size-4 shrink-0 text-accent" />
				<span data-pa-zona aria-live="polite">Zona 0 · 0</span>
			</span>
			<div role="group" aria-label="Moverse por la obra" class="ml-auto flex">
				{
					[
						['-1,0', 'arrow-left', 'Zona de la izquierda'],
						['0,-1', 'arrow-up', 'Zona de arriba'],
						['0,1', 'arrow-down', 'Zona de abajo'],
						['1,0', 'arrow-right', 'Zona de la derecha'],
					].map(([paso, icono, titulo], n) => (
						<button type="button" data-pa-paso={paso} title={titulo} aria-label={titulo} class={`${BOTON} ${n ? '-ml-px' : ''}`}>
							<Icon name={icono} class="size-4 shrink-0" />
						</button>
					))
				}
				<button type="button" data-pa-centro title="Volver a la zona 0 · 0" class={`${BOTON} -ml-px`}>
					<Icon name="home" class="size-4 shrink-0" />
					Centro
				</button>
			</div>
		</div>

		<div class="border border-line bg-panel p-4">
			<canvas
				data-pa-tela
				width="768"
				height="384"
				role="img"
				aria-label="El lienzo de píxeles"
				class="mx-auto block aspect-[2/1] w-full max-w-[768px] cursor-crosshair touch-none bg-bg [image-rendering:pixelated]"
			></canvas>
		</div>

		<div class="flex flex-wrap items-center gap-3">
			<div role="group" aria-label="Tono" class="flex flex-wrap gap-2">
				{
					TONOS.map((c, i) => (
						<button
							type="button"
							data-pa-tono={i}
							aria-pressed="false"
							title={i ? `Tono ${i}: ${c}` : 'Goma'}
							class="inline-flex size-10 items-center justify-center border border-line font-mono text-fg hover:border-accent aria-pressed:border-accent aria-pressed:text-accent"
						>
							{i ? c : <Icon name="eraser" class="size-4" />}
						</button>
					))
				}
			</div>
			<span data-pa-casilla class="font-mono text-sm text-muted">x — · y —</span>
			<div role="group" aria-label="Vista del lienzo" class="ml-auto flex">
				<button type="button" data-pa-vista="pixeles" aria-pressed="true" class={`${BOTON} aria-pressed:border-accent aria-pressed:text-accent`}>
					<Icon name="grid-dots" class="size-4 shrink-0" />
					Píxeles
				</button>
				<button type="button" data-pa-vista="texto" aria-pressed="false" class={`${BOTON} -ml-px aria-pressed:border-accent aria-pressed:text-accent`}>
					<Icon name="terminal-2" class="size-4 shrink-0" />
					Terminal
				</button>
			</div>
		</div>

		<div class="flex flex-col border border-line bg-bg">
			<div class="flex items-center gap-2 border-b border-line px-3 py-2 text-xs text-muted">
				<Icon name="terminal-2" class="size-4 shrink-0 text-accent" />
				Consola
			</div>
			<pre
				data-pa-salida
				aria-live="polite"
				class="m-0 h-36 overflow-y-auto px-3 py-2 font-mono text-xs leading-[1.4] whitespace-pre-wrap text-muted"></pre>
			<form data-pa-consola class="flex items-center gap-2 border-t border-line px-3 py-2">
				<label for="pa-comando" class="font-mono text-accent">$</label>
				<input
					id="pa-comando"
					type="text"
					data-pa-comando
					autocomplete="off"
					autocapitalize="off"
					spellcheck="false"
					maxlength="120"
					placeholder="pixel 10 5 @   ·   ayuda"
					class="min-w-0 flex-1 bg-transparent font-mono text-sm text-fg outline-none placeholder:text-muted"
				/>
			</form>
		</div>

		<div class="flex flex-wrap items-center gap-3">
			<button type="button" data-pa-enlace class={`${BOTON} border-accent text-accent`}>
				<Icon name="link" class="size-4 shrink-0" />
				Pasar el enlace
			</button>
			<button type="button" data-pa-txt class={BOTON}>
				<Icon name="file-download" class="size-4 shrink-0" />
				Descargar .txt
			</button>
			<button type="button" data-pa-obra class={BOTON}>
				<Icon name="world-download" class="size-4 shrink-0" />
				La obra entera .txt
			</button>
			<button type="button" data-pa-repe aria-pressed="false" class={`${BOTON} aria-pressed:border-accent aria-pressed:text-accent`}>
				<Icon name="player-play" class="size-4 shrink-0" />
				<span data-pa-repe-texto>Repetición</span>
			</button>
			<button type="button" data-pa-copiar class={BOTON}>
				<Icon name="copy" class="size-4 shrink-0" />
				Copiar texto
			</button>
			<button type="button" data-pa-limpiar class={BOTON}>
				<Icon name="trash" class="size-4 shrink-0" />
				Limpiar
			</button>
		</div>
	</div>

	<div class="flex flex-col gap-5 border border-line bg-panel p-5">
		<div class="flex flex-col gap-1">
			<span class="flex items-center gap-2 text-xs text-muted">
				<Icon name="broadcast" class="size-4 shrink-0 text-accent" />
				En directo
			</span>
			<p data-pa-pestanas class="text-sm text-fg">…</p>
		</div>

		<div class="flex flex-col gap-2">
			<span class="flex items-center gap-2 text-sm text-muted">
				<Icon name="map-2" class="size-4 shrink-0 text-accent" />
				El mapa de la obra
			</span>
			<canvas
				data-pa-mapa
				width="220"
				height="140"
				role="img"
				aria-label="Las zonas de alrededor: pulsa una para ir"
				class="block aspect-[11/7] w-full cursor-pointer border border-line bg-bg [image-rendering:pixelated]"
			></canvas>
			<span data-pa-mapa-texto class="text-xs text-muted"></span>
		</div>

		<div class="flex flex-col gap-2">
			<span class="flex justify-between gap-2 text-sm text-muted">
				<span>El .txt, tal cual</span>
				<span data-pa-cuenta class="text-xs"></span>
			</span>
			<div class="border border-line bg-bg font-mono">
				<div class="border-b border-line px-2 py-1 text-xs text-muted">
					<span class="text-accent">$</span> cat pixeles-ascii.txt
				</div>
				<pre data-pa-texto class="m-0 overflow-x-auto p-2 text-[9px] leading-[1.1] text-fg sm:text-[10px]"></pre>
				<div class="px-2 pb-2 text-xs text-muted">
					<span class="text-accent">$</span> <span class="pa-cursor text-fg">_</span>
				</div>
			</div>
			<span class="flex items-center gap-2 text-xs text-muted">
				<Icon name="device-floppy" class="size-4 shrink-0 text-accent" />
				<span data-pa-guardado aria-live="polite">Se guarda solo con cada trazo.</span>
			</span>
		</div>

		<label class="flex flex-col gap-2 text-sm text-muted">
			Tu firma
			<input
				type="text"
				data-pa-firma
				maxlength="20"
				placeholder="Cómo te llaman"
				class="border border-line bg-bg px-3 py-2 text-fg outline-none focus:border-accent"
			/>
			<span class="text-xs">Va en el enlace y al pie del .txt.</span>
		</label>

		<div class="flex flex-col gap-2">
			<span class="flex items-center gap-2 text-sm text-muted">
				<Icon name="users-group" class="size-4 shrink-0 text-accent" />
				Han pintado aquí
			</span>
			<p data-pa-firmas class="text-sm break-words text-fg"></p>
		</div>

		<div class="flex flex-col gap-2">
			<span class="flex items-center gap-2 text-sm text-muted">
				<Icon name="history" class="size-4 shrink-0 text-accent" />
				Copia de cada hora
			</span>
			<span data-pa-proxima class="text-xs text-muted"></span>
			<ol data-pa-horas class="flex max-h-56 flex-col overflow-y-auto border border-line bg-bg empty:hidden"></ol>
		</div>
	</div>
</section>

<script>
	const TONOS = [' ', '.', ':', '+', '#', '@'];
	const ANCHO = 48;
	const ALTO = 24;
	const TOTAL = ANCHO * ALTO;
	const ESCALA = 16;
	const CLAVE = 'tuweb:pixeles-ascii';
	const MAX_FIRMAS = 40;
	const YO = Math.random().toString(36).slice(2, 10);

	const raiz = document.querySelector<HTMLElement>('#pixeles-ascii');
	const tela = raiz?.querySelector<HTMLCanvasElement>('[data-pa-tela]');
	const ctx = tela?.getContext('2d');
	const aviso = raiz?.querySelector<HTMLElement>('[data-pa-aviso]');
	const casilla = raiz?.querySelector<HTMLElement>('[data-pa-casilla]');
	const firmaCampo = raiz?.querySelector<HTMLInputElement>('[data-pa-firma]');

	// --- Validación ---

	const textoValido = (t: unknown): t is string => typeof t === 'string' && t.length === TOTAL && /^[0-5]*$/.test(t);
	const limpiarFirma = (s: unknown) =>
		typeof s === 'string' ? s.replace(/[^\p{L}\p{N} ._-]/gu, '').trim().slice(0, 20) : '';
	// Lo que se dice por la consola: una línea, sin caracteres de control y corta.
	const MAX_DICHO = 100;
	const limpiarDicho = (s: unknown) =>
		typeof s === 'string' ? s.replace(/[\p{C}]/gu, '').replace(/\s+/g, ' ').trim().slice(0, MAX_DICHO) : '';
	const limpiarFirmas = (lista: unknown) =>
		Array.isArray(lista) ? [...new Set(lista.map(limpiarFirma).filter(Boolean))].slice(-MAX_FIRMAS) : [];

	// --- Lo guardado ---

	let celdas: number[] = Array(TOTAL).fill(0);
	let tono = 4;
	let firma = '';
	let firmas: string[] = [];
	let vista: 'pixeles' | 'texto' = 'pixeles';

	// La obra infinita: celdas es la zona en la que estás; zonas, todas las pintadas.
	type Zona = [number, number];
	const MAX_ZONA = 9999;
	const MAX_ZONAS = 400;
	let zona: Zona = [0, 0];
	let zonas: Record<string, string> = {};
	const claveZona = (z: Zona = zona) => `${z[0]},${z[1]}`;
	const zonaValida = (k: unknown): k is string => typeof k === 'string' && /^-?\d{1,4},-?\d{1,4}$/.test(k);
	const deClave = (k: string): Zona => k.split(',').map(Number) as Zona;

	function limpiarZonas(lista: unknown) {
		const limpias: Record<string, string> = {};
		if (!lista || typeof lista !== 'object') return limpias;
		Object.entries(lista)
			.slice(0, MAX_ZONAS)
			.forEach(([k, t]) => zonaValida(k) && textoValido(t) && /[1-5]/.test(t) && (limpias[k] = t));
		return limpias;
	}

	/** La zona en la que estás pasa a la lista; si queda en blanco, sale de ella. */
	function sincronizar() {
		const texto = celdas.join('');
		if (/[1-5]/.test(texto)) zonas[claveZona()] = texto;
		else delete zonas[claveZona()];
	}

	function leer() {
		try {
			const leido = JSON.parse(localStorage.getItem(CLAVE) ?? 'null');
			return leido && typeof leido === 'object' ? leido : null;
		} catch {
			return null;
		}
	}

	const guardado = leer();
	if (guardado) {
		if (textoValido(guardado.celdas)) celdas = [...guardado.celdas].map(Number);
		if (Number.isInteger(guardado.tono) && guardado.tono >= 0 && guardado.tono < TONOS.length) tono = guardado.tono;
		firma = limpiarFirma(guardado.firma);
		firmas = limpiarFirmas(guardado.firmas);
		if (guardado.vista === 'texto') vista = 'texto';
		zonas = limpiarZonas(guardado.zonas);
		if (zonaValida(guardado.zona)) zona = deClave(guardado.zona);
	}

	const hora = () => new Date().toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit', second: '2-digit' });

	function marcarGuardado(texto: string) {
		const nodo = raiz?.querySelector<HTMLElement>('[data-pa-guardado]');
		if (nodo) nodo.textContent = texto;
	}

	function guardar() {
		sincronizar();
		try {
			localStorage.setItem(
				CLAVE,
				JSON.stringify({ celdas: celdas.join(''), tono, firma, firmas, vista, zona: claveZona(), zonas }),
			);
			marcarGuardado(`Guardado solo a las ${hora()}. El .txt es el mismo para quien lo tenga.`);
		} catch {
			// Sin almacenamiento se pinta igual; solo que no se guarda.
			marcarGuardado('Tu navegador no deja guardar: bájate el .txt antes de irte.');
		}
	}

	// --- El diario de trazos ---

	// Cada píxel que se pinta, aquí o en otra pestaña, se apunta con su zona y su
	// firma: los últimos MAX_DIARIO. Con ellos se repite cómo se pintó cada zona.
	const CLAVE_DIARIO = `${CLAVE}:diario`;
	const MAX_DIARIO = 4000;
	type Apunte = [zona: string, i: number, t: number, quien: string];
	let diario: Apunte[] = [];
	let guardarDiario: number | undefined;

	try {
		const leido = JSON.parse(localStorage.getItem(CLAVE_DIARIO) ?? '[]');
		if (Array.isArray(leido)) {
			diario = leido
				.filter(
					(a) =>
						Array.isArray(a) &&
						zonaValida(a[0]) &&
						Number.isInteger(a[1]) &&
						a[1] >= 0 &&
						a[1] < TOTAL &&
						Number.isInteger(a[2]) &&
						a[2] >= 0 &&
						a[2] < TONOS.length,
				)
				.map((a): Apunte => [a[0], a[1], a[2], limpiarFirma(a[3])])
				.slice(-MAX_DIARIO);
		}
	} catch {
		diario = [];
	}

	function anotar(z: string, trazo: [number, number][], quien: string) {
		if (!Array.isArray(trazo) || !trazo.length) return;
		trazo.forEach(([i, t]) => diario.push([z, i, t, quien]));
		if (diario.length > MAX_DIARIO) diario = diario.slice(-MAX_DIARIO);
		clearTimeout(guardarDiario);
		guardarDiario = window.setTimeout(() => {
			try {
				localStorage.setItem(CLAVE_DIARIO, JSON.stringify(diario));
			} catch {
				// Sin almacenamiento, la repetición dura lo que dure la pestaña.
			}
		}, 1000);
	}

	// --- En directo entre pestañas ---

	const canal = 'BroadcastChannel' in window ? new BroadcastChannel(CLAVE) : null;
	const otras = new Map<string, number>();
	// Todo mensaje lleva la zona en la que está quien lo manda.
	function enviar(mensaje: Record<string, unknown>) {
		// Lo que pintas tú se apunta en el diario, aunque no haya otras pestañas.
		if (mensaje.tipo === 'trazo') anotar(claveZona(), mensaje.trazo as [number, number][], firma);
		canal?.postMessage({ zona: claveZona(), ...mensaje, de: YO });
	}
	const donde = new Map<string, string>();
	const enviarTodo = () => enviar({ tipo: 'todo', celdas: celdas.join(''), firmas });

	function pintarPestanas() {
		const nodo = raiz?.querySelector<HTMLElement>('[data-pa-pestanas]');
		if (!nodo) return;
		if (!canal) nodo.textContent = 'Tu navegador no deja.';
		else if (!otras.size) nodo.textContent = 'Solo esta pestaña. Lo que pintes sale al momento en las demás.';
		else nodo.textContent = `${otras.size + 1} pestañas pintando el mismo lienzo. Su cursor va con su firma y lo que pintan brilla un momento.`;
	}

	// Lo que llega de otras pestañas se ve: su cursor con su firma y un destello en
	// cada píxel que pintan, que se apaga en un segundo y medio.
	const BRILLO = 1500;
	const cursores = new Map<string, { i: number; firma: string; zona: string }>();
	const recientes = new Map<number, number>();
	let latido = 0;

	function animar() {
		if (latido) return;
		const paso = () => {
			const limite = Date.now() - BRILLO;
			recientes.forEach((t, i) => t < limite && recientes.delete(i));
			pintarTela();
			latido = recientes.size ? requestAnimationFrame(paso) : 0;
		};
		latido = requestAnimationFrame(paso);
	}

	const celdaValida = (i: unknown): i is number => Number.isInteger(i) && (i as number) >= 0 && (i as number) < TOTAL;

	canal?.addEventListener('message', ({ data }) => {
		if (!data || typeof data !== 'object' || typeof data.de !== 'string' || data.de === YO) return;
		// Las pestañas de antes no mandan zona: pintan en la del centro.
		const suya = zonaValida(data.zona) ? data.zona : '0,0';
		const aqui = suya === claveZona();
		if (data.tipo === 'adios') {
			otras.delete(data.de);
			cursores.delete(data.de);
			donde.delete(data.de);
			pintarTela();
		} else {
			otras.set(data.de, Date.now());
			donde.set(data.de, suya);
		}
		if (data.tipo === 'hola') enviar({ tipo: 'aqui' });
		if (data.tipo === 'cursor') {
			if (celdaValida(data.i)) cursores.set(data.de, { i: data.i, firma: limpiarFirma(data.firma), zona: suya });
			else cursores.delete(data.de);
			pintarTela();
		}
		if (data.tipo === 'trazo' && Array.isArray(data.trazo)) {
			let puestos = 0;
			const ahora = Date.now();
			const llegados: [number, number][] = [];
			// Lo de otra zona se apunta en la suya, aunque no la estés viendo.
			const destino = aqui ? celdas : [...(zonas[suya] ?? '0'.repeat(TOTAL))].map(Number);
			data.trazo.forEach((p: unknown) => {
				if (!Array.isArray(p)) return;
				const [i, t] = p;
				if (celdaValida(i) && Number.isInteger(t) && t >= 0 && t < TONOS.length) {
					destino[i] = t;
					if (aqui) recientes.set(i, ahora);
					llegados.push([i, t]);
					puestos++;
				}
			});
			anotar(suya, llegados, limpiarFirma(data.firma));
			if (!aqui && puestos) {
				if (destino.some(Boolean)) zonas[suya] = destino.join('');
				else delete zonas[suya];
			}
			if (aqui && puestos) animar();
			if (typeof data.firma === 'string' && data.firma) firmas = limpiarFirmas([...firmas, data.firma]);
			if (puestos) apuntar(`${limpiarFirma(data.firma) || 'otra pestaña'}${aqui ? '' : ` en la zona ${suya.replace(',', ' · ')}`}`, puestos);
			todo();
		}
		if (data.tipo === 'todo' && textoValido(data.celdas)) {
			if (aqui) celdas = [...data.celdas].map(Number);
			else if (/[1-5]/.test(data.celdas)) zonas[suya] = data.celdas;
			else delete zonas[suya];
			firmas = limpiarFirmas(data.firmas);
			if (aqui) decir(`[${hora()}] Esta zona entera llega de otra pestaña.`, 'text-accent');
			todo();
		}
		if (data.tipo === 'di') {
			const dicho = limpiarDicho(data.texto);
			if (dicho) decir(`[${hora()}] ${limpiarFirma(data.firma) || 'otra pestaña'}: ${dicho}`, 'text-fg');
		}
		if (data.tipo === 'obra') {
			zonas = limpiarZonas(data.zonas);
			celdas = [...(zonas[claveZona()] ?? '0'.repeat(TOTAL))].map(Number);
			firmas = limpiarFirmas(data.firmas);
			decir(`[${hora()}] La obra entera llega de otra pestaña.`, 'text-accent');
			todo();
		}
		pintarPestanas();
	});

	setInterval(() => {
		enviar({ tipo: 'aqui' });
		const limite = Date.now() - 10_000;
		otras.forEach((visto, id) => {
			if (visto >= limite) return;
			otras.delete(id);
			cursores.delete(id);
			donde.delete(id);
		});
		pintarPestanas();
		pintarTela();
	}, 4_000);

	window.addEventListener('pagehide', () => enviar({ tipo: 'adios' }));

	// Lo que pintan las demás sale en la consola, un apunte por firma y por trazo.
	const llegadas = new Map<string, number>();
	let apunte: number | undefined;

	function apuntar(quien: string, cuantos: number) {
		llegadas.set(quien, (llegadas.get(quien) ?? 0) + cuantos);
		clearTimeout(apunte);
		apunte = window.setTimeout(() => {
			llegadas.forEach((n, q) => decir(`[${hora()}] ${q} pinta ${n} ${n === 1 ? 'píxel' : 'píxeles'}.`, 'text-accent'));
			llegadas.clear();
		}, 700);
	}

	// --- El texto ---

	/** El dibujo en ASCII: una línea por fila, sin espacios al final. */
	function comoTexto(de = celdas) {
		const filas: string[] = [];
		for (let y = 0; y < ALTO; y++) {
			filas.push(
				de
					.slice(y * ANCHO, (y + 1) * ANCHO)
					.map((t) => TONOS[t])
					.join('')
					.trimEnd(),
			);
		}
		return filas.join('\n');
	}

	// --- Pintado ---

	let encima: number | null = null;
	let repeticion: number[] | null = null;

	function avisar(texto: string) {
		if (!aviso) return;
		aviso.textContent = texto;
		aviso.hidden = false;
	}

	const tinta = (nombre: string, otra: string) =>
		(tela && getComputedStyle(tela).getPropertyValue(nombre).trim()) || otra;

	function pintarTela() {
		if (!ctx || !tela) return;
		ctx.clearRect(0, 0, tela.width, tela.height);
		// Durante la repetición se ve el lienzo de la repetición, no el de ahora.
		const lienzo = repeticion ?? celdas;
		if (vista === 'texto') {
			// La vista de terminal: cada celda, su carácter, tal cual saldrá en el .txt.
			ctx.fillStyle = tinta('--color-fg', '#0f0f0f');
			ctx.font = `600 ${ESCALA}px ${tinta('--font-mono', 'monospace')}`;
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';
			lienzo.forEach((t, i) => {
				if (t) ctx.fillText(TONOS[t], (i % ANCHO) * ESCALA + ESCALA / 2, Math.floor(i / ANCHO) * ESCALA + ESCALA / 2 + 1);
			});
			if (encima !== null) {
				ctx.fillStyle = tinta('--color-accent', '#9a3412');
				ctx.fillRect((encima % ANCHO) * ESCALA + 2, Math.floor(encima / ANCHO) * ESCALA + ESCALA - 3, ESCALA - 4, 2);
			}
			pintarAjenos();
			return;
		}
		ctx.fillStyle = tinta('--color-line', '#e8d9c8');
		for (let x = 0; x <= ANCHO; x++) ctx.fillRect(x * ESCALA, 0, 1, tela.height);
		for (let y = 0; y <= ALTO; y++) ctx.fillRect(0, y * ESCALA, tela.width, 1);
		ctx.fillStyle = tinta('--color-fg', '#1c1917');
		lienzo.forEach((t, i) => {
			if (!t) return;
			ctx.globalAlpha = t / (TONOS.length - 1);
			ctx.fillRect((i % ANCHO) * ESCALA, Math.floor(i / ANCHO) * ESCALA, ESCALA, ESCALA);
		});
		ctx.globalAlpha = 1;
		if (encima !== null) {
			ctx.strokeStyle = tinta('--color-accent', '#c2410c');
			ctx.lineWidth = 2;
			ctx.strokeRect((encima % ANCHO) * ESCALA + 1, Math.floor(encima / ANCHO) * ESCALA + 1, ESCALA - 2, ESCALA - 2);
		}
		pintarAjenos();
	}

	/** Encima de todo, lo que llega de fuera: el destello de lo recién pintado y los cursores con su firma. */
	function pintarAjenos() {
		if (!ctx || !tela) return;
		const ahora = Date.now();
		const color = tinta('--color-accent', '#9a3412');
		ctx.fillStyle = color;
		recientes.forEach((t, i) => {
			ctx.globalAlpha = Math.max(0, 1 - (ahora - t) / BRILLO) * 0.5;
			ctx.fillRect((i % ANCHO) * ESCALA, Math.floor(i / ANCHO) * ESCALA, ESCALA, ESCALA);
		});
		ctx.globalAlpha = 1;
		ctx.strokeStyle = color;
		ctx.lineWidth = 2;
		ctx.setLineDash([3, 3]);
		ctx.font = `600 11px ${tinta('--font-mono', 'monospace')}`;
		ctx.textBaseline = 'bottom';
		cursores.forEach(({ i, firma: suya, zona: la }) => {
			if (la !== claveZona()) return;
			const x = (i % ANCHO) * ESCALA;
			const y = Math.floor(i / ANCHO) * ESCALA;
			ctx.strokeRect(x + 1, y + 1, ESCALA - 2, ESCALA - 2);
			const derecha = x > tela.width / 2;
			ctx.textAlign = derecha ? 'right' : 'left';
			ctx.fillText(suya || 'otra pestaña', derecha ? x + ESCALA : x, y > 12 ? y - 2 : y + ESCALA + 13);
		});
		ctx.setLineDash([]);
	}

	function pintarDatos() {
		const pre = raiz?.querySelector<HTMLElement>('[data-pa-texto]');
		if (pre) pre.textContent = comoTexto();
		const cuenta = raiz?.querySelector<HTMLElement>('[data-pa-cuenta]');
		if (cuenta) cuenta.textContent = `${celdas.filter(Boolean).length} de ${TOTAL} píxeles`;
		const lista = raiz?.querySelector<HTMLElement>('[data-pa-firmas]');
		if (lista) lista.textContent = firmas.length ? firmas.join(' · ') : 'Nadie aún.';
		raiz?.querySelectorAll<HTMLButtonElement>('[data-pa-tono]').forEach((b) => {
			b.setAttribute('aria-pressed', String(Number(b.dataset.paTono) === tono));
		});
		raiz?.querySelectorAll<HTMLButtonElement>('[data-pa-vista]').forEach((b) => {
			b.setAttribute('aria-pressed', String(b.dataset.paVista === vista));
		});
	}

	/** La galería de debajo lee el lienzo y la firma de aquí. */
	function exponer() {
		if (!raiz) return;
		raiz.dataset.paCeldas = celdas.join('');
		raiz.dataset.paFirma = firma;
	}

	function todo() {
		pintarTela();
		pintarDatos();
		pintarMapa();
		exponer();
	}

	// --- La obra infinita ---

	const mapa = raiz?.querySelector<HTMLCanvasElement>('[data-pa-mapa]');
	const MAPA_ANCHO = 11;
	const MAPA_ALTO = 7;

	/** Las zonas de alrededor: más oscuras cuanto más pintadas; con un punto, donde hay otra pestaña. */
	function pintarMapa() {
		sincronizar();
		const etiqueta = raiz?.querySelector<HTMLElement>('[data-pa-zona]');
		if (etiqueta) etiqueta.textContent = `Zona ${zona[0]} · ${zona[1]}`;
		const texto = raiz?.querySelector<HTMLElement>('[data-pa-mapa-texto]');
		const n = Object.keys(zonas).length;
		if (texto) texto.textContent = `${n} ${n === 1 ? 'zona pintada' : 'zonas pintadas'}. Pulsa una para ir.`;
		const m = mapa?.getContext('2d');
		if (!m || !mapa) return;
		const lado = mapa.width / MAPA_ANCHO;
		const ocupadas = new Set(donde.values());
		m.clearRect(0, 0, mapa.width, mapa.height);
		for (let fy = 0; fy < MAPA_ALTO; fy++) {
			for (let fx = 0; fx < MAPA_ANCHO; fx++) {
				const k = claveZona([zona[0] + fx - (MAPA_ANCHO >> 1), zona[1] + fy - (MAPA_ALTO >> 1)]);
				const x = fx * lado;
				const y = fy * lado;
				m.fillStyle = tinta('--color-line', '#e8d9c8');
				m.fillRect(x, y, lado, 1);
				m.fillRect(x, y, 1, lado);
				const pintada = zonas[k];
				if (pintada) {
					const llenos = pintada.replace(/0/g, '').length;
					m.fillStyle = tinta('--color-fg', '#1c1917');
					m.globalAlpha = 0.15 + 0.85 * Math.min(1, (llenos / TOTAL) * 3);
					m.fillRect(x + 2, y + 2, lado - 3, lado - 3);
					m.globalAlpha = 1;
				}
				if (k === '0,0') {
					m.fillStyle = tinta('--color-muted', '#78716c');
					m.fillRect(x + lado / 2 - 1, y + lado / 2 - 1, 2, 2);
				}
				if (ocupadas.has(k)) {
					m.fillStyle = tinta('--color-accent', '#c2410c');
					m.fillRect(x + lado - 7, y + 3, 4, 4);
				}
			}
		}
		m.strokeStyle = tinta('--color-accent', '#c2410c');
		m.lineWidth = 2;
		m.strokeRect((MAPA_ANCHO >> 1) * lado + 1, (MAPA_ALTO >> 1) * lado + 1, lado - 1, lado - 1);
	}

	/** Cambia de zona: la de ahora se guarda y se abre la otra, pintada o en blanco. */
	function ir(nueva: Zona) {
		if (nueva.some((n) => !Number.isInteger(n) || Math.abs(n) > MAX_ZONA)) return false;
		sincronizar();
		if (!zonas[claveZona(nueva)] && Object.keys(zonas).length >= MAX_ZONAS) return false;
		pararRepeticion();
		zona = nueva;
		celdas = [...(zonas[claveZona()] ?? '0'.repeat(TOTAL))].map(Number);
		recientes.clear();
		encima = null;
		guardar();
		enviar({ tipo: 'cursor', i: null });
		todo();
		return true;
	}

	raiz?.querySelectorAll<HTMLButtonElement>('[data-pa-paso]').forEach((b) => {
		b.addEventListener('click', () => {
			const [dx, dy] = (b.dataset.paPaso ?? '0,0').split(',').map(Number);
			ir([zona[0] + dx, zona[1] + dy]);
		});
	});

	raiz?.querySelector('[data-pa-centro]')?.addEventListener('click', () => ir([0, 0]));

	mapa?.addEventListener('click', (evento) => {
		const caja = mapa.getBoundingClientRect();
		if (!caja.width || !caja.height) return;
		const fx = Math.floor(((evento.clientX - caja.left) / caja.width) * MAPA_ANCHO);
		const fy = Math.floor(((evento.clientY - caja.top) / caja.height) * MAPA_ALTO);
		ir([zona[0] + fx - (MAPA_ANCHO >> 1), zona[1] + fy - (MAPA_ALTO >> 1)]);
	});

	// --- Pintar ---

	function celda(evento: PointerEvent) {
		if (!tela) return null;
		const caja = tela.getBoundingClientRect();
		if (!caja.width || !caja.height) return null;
		const x = Math.floor(((evento.clientX - caja.left) / caja.width) * ANCHO);
		const y = Math.floor(((evento.clientY - caja.top) / caja.height) * ALTO);
		return x < 0 || y < 0 || x >= ANCHO || y >= ALTO ? null : y * ANCHO + x;
	}

	const SIN_CASILLA = 'x — · y —';
	let pintando = false;
	let trazo: [number, number][] = [];

	function poner(i: number) {
		if (celdas[i] === tono) return;
		celdas[i] = tono;
		trazo.push([i, tono]);
		todo();
	}

	/** Al soltar, el trazo entero sale a las demás pestañas y se guarda. */
	function soltar() {
		if (!pintando) return;
		pintando = false;
		if (!trazo.length) return;
		if (firma) firmas = limpiarFirmas([...firmas, firma]);
		enviar({ tipo: 'trazo', trazo, firma });
		trazo = [];
		guardar();
		pintarDatos();
	}

	tela?.addEventListener('pointerdown', (evento) => {
		const i = celda(evento);
		if (i === null) return;
		if (repeticion) return avisar('Se está repitiendo la zona: espera a que acabe o dale a parar.');
		evento.preventDefault();
		tela?.setPointerCapture(evento.pointerId);
		pintando = true;
		poner(i);
	});

	tela?.addEventListener('pointermove', (evento) => {
		const i = celda(evento);
		if (pintando && i !== null) poner(i);
		// Mientras pintas, cada celda sale también en directo, sin esperar a soltar.
		if (pintando && trazo.length > 16) {
			enviar({ tipo: 'trazo', trazo, firma });
			trazo = [];
		}
		if (i === encima) return;
		encima = i;
		// Solo sale al cambiar de casilla: las demás pestañas ven dónde estás.
		enviar({ tipo: 'cursor', i, firma });
		if (casilla) {
			// En la obra entera: la zona más la casilla.
			casilla.textContent =
				i === null ? SIN_CASILLA : `x ${zona[0] * ANCHO + (i % ANCHO)} · y ${zona[1] * ALTO + Math.floor(i / ANCHO)}`;
		}
		pintarTela();
	});

	tela?.addEventListener('pointerup', soltar);
	tela?.addEventListener('pointercancel', soltar);
	tela?.addEventListener('pointerleave', () => {
		encima = null;
		enviar({ tipo: 'cursor', i: null });
		if (casilla) casilla.textContent = SIN_CASILLA;
		pintarTela();
	});

	raiz?.querySelectorAll<HTMLButtonElement>('[data-pa-tono]').forEach((b) => {
		b.addEventListener('click', () => {
			const t = Number(b.dataset.paTono);
			if (!Number.isInteger(t) || t < 0 || t >= TONOS.length) return;
			tono = t;
			guardar();
			pintarDatos();
		});
	});

	raiz?.querySelectorAll<HTMLButtonElement>('[data-pa-vista]').forEach((b) => {
		b.addEventListener('click', () => {
			vista = b.dataset.paVista === 'texto' ? 'texto' : 'pixeles';
			guardar();
			todo();
		});
	});

	if (firmaCampo) {
		firmaCampo.value = firma;
		firmaCampo.addEventListener('input', () => {
			firma = limpiarFirma(firmaCampo.value);
			guardar();
			exponer();
		});
	}

	// Un diseño de la galería entra en el lienzo, con sus firmas.
	raiz?.addEventListener('pa:cargar', (evento) => {
		const detalle = (evento as CustomEvent).detail;
		if (!detalle || !textoValido(detalle.celdas)) return;
		celdas = [...detalle.celdas].map(Number);
		firmas = limpiarFirmas([...firmas, ...limpiarFirmas(detalle.firmas)]);
		guardar();
		enviarTodo();
		avisar(`«${limpiarFirma(detalle.nombre) || 'Diseño'}» abierto en el lienzo.`);
		todo();
		raiz?.scrollIntoView({ block: 'start' });
	});

	raiz?.querySelector('[data-pa-limpiar]')?.addEventListener('click', () => {
		if (!celdas.some(Boolean)) return;
		if (!confirm('¿Borrar esta zona entera? También se borra en las demás pestañas. Las otras zonas se quedan.')) return;
		celdas = Array(TOTAL).fill(0);
		guardar();
		enviarTodo();
		avisar('Zona en blanco.');
		todo();
	});

	// --- La repetición ---

	// Pinta otra vez la zona desde blanco, píxel a píxel y en el orden en que llegó,
	// con la firma de quien pinta cada tramo. Dura unos seis segundos sea cual sea.
	const REPE_FOTOGRAMAS = 360;
	const repeBoton = raiz?.querySelector<HTMLButtonElement>('[data-pa-repe]');
	const repeTexto = raiz?.querySelector<HTMLElement>('[data-pa-repe-texto]');
	let repeLatido = 0;

	function marcarRepeticion() {
		repeBoton?.setAttribute('aria-pressed', String(Boolean(repeticion)));
		if (repeTexto) repeTexto.textContent = repeticion ? 'Parar' : 'Repetición';
	}

	function pararRepeticion(mensaje?: string) {
		if (!repeticion) return;
		cancelAnimationFrame(repeLatido);
		repeticion = null;
		marcarRepeticion();
		if (mensaje) avisar(mensaje);
		pintarTela();
	}

	function repetir() {
		const pasos = diario.filter((a) => a[0] === claveZona());
		if (!pasos.length) return avisar('Aún no hay trazos apuntados en esta zona: pinta algo y vuelve a darle.');
		repeticion = Array(TOTAL).fill(0);
		marcarRepeticion();
		const porFotograma = Math.max(1, Math.ceil(pasos.length / REPE_FOTOGRAMAS));
		let n = 0;
		let quien = '';
		const paso = () => {
			if (!repeticion) return;
			const ahora = Date.now();
			for (const [, i, t, suya] of pasos.slice(n, n + porFotograma)) {
				repeticion[i] = t;
				recientes.set(i, ahora);
				if ((suya || 'sin firma') !== quien) {
					quien = suya || 'sin firma';
					avisar(`Repetición: pinta ${quien}.`);
				}
			}
			n += porFotograma;
			const limite = ahora - BRILLO;
			recientes.forEach((t, i) => t < limite && recientes.delete(i));
			pintarTela();
			if (n < pasos.length) {
				repeLatido = requestAnimationFrame(paso);
				return;
			}
			const cuantos = `${pasos.length} ${pasos.length === 1 ? 'píxel' : 'píxeles'}`;
			pararRepeticion(`Repetición de ${cuantos}${pasos.length >= MAX_DIARIO ? ', los últimos que se guardan' : ''}.`);
			// Lo último que se repitió se apaga despacio sobre el lienzo de ahora.
			animar();
		};
		repeLatido = requestAnimationFrame(paso);
	}

	repeBoton?.addEventListener('click', () => (repeticion ? pararRepeticion('Repetición parada.') : repetir()));

	// --- Llevárselo ---

	function archivo(de = celdas, quienes = firmas) {
		const pie = quienes.length ? `\n\n-- ${quienes.join(', ')} · tuweb.dev/pixeles-ascii` : '\n\n-- tuweb.dev/pixeles-ascii';
		return `${comoTexto(de)}${pie}\n`;
	}

	function descargar(texto: string, nombre: string) {
		const url = URL.createObjectURL(new Blob([texto], { type: 'text/plain;charset=utf-8' }));
		const enlace = document.createElement('a');
		enlace.href = url;
		enlace.download = nombre;
		enlace.click();
		setTimeout(() => URL.revokeObjectURL(url), 1000);
	}

	raiz?.querySelector('[data-pa-txt]')?.addEventListener('click', () => descargar(archivo(), 'pixeles-ascii.txt'));

	/** Todas las zonas pintadas, cosidas en su sitio; los huecos entre ellas, en blanco. */
	function obraComoTexto() {
		sincronizar();
		const claves = Object.keys(zonas).map(deClave);
		if (!claves.length) return '';
		const xs = claves.map((z) => z[0]);
		const ys = claves.map((z) => z[1]);
		const [x0, x1, y0, y1] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];
		if (x1 - x0 >= 40 || y1 - y0 >= 40) return null;
		const filas: string[] = [];
		for (let zy = y0; zy <= y1; zy++) {
			for (let y = 0; y < ALTO; y++) {
				let fila = '';
				for (let zx = x0; zx <= x1; zx++) {
					const t = zonas[claveZona([zx, zy])];
					fila += t ? [...t.slice(y * ANCHO, (y + 1) * ANCHO)].map((c) => TONOS[Number(c)]).join('') : ' '.repeat(ANCHO);
				}
				filas.push(fila.trimEnd());
			}
		}
		return filas.join('\n').replace(/^\n+|\n+$/g, '');
	}

	raiz?.querySelector('[data-pa-obra]')?.addEventListener('click', () => {
		const texto = obraComoTexto();
		if (texto === null) return avisar('La obra es demasiado ancha para un .txt: bájala zona a zona.');
		if (!texto) return avisar('Aún no hay nada pintado.');
		const pie = firmas.length ? `\n\n-- ${firmas.join(', ')} · tuweb.dev/pixeles-ascii` : '\n\n-- tuweb.dev/pixeles-ascii';
		descargar(`${texto}${pie}\n`, 'pixeles-ascii-obra.txt');
	});

	// --- La copia de cada hora ---

	// Al cambiar la hora se guarda el lienzo tal cual, una copia por hora y
	// las últimas 24. Las pestañas comparten la lista: la primera que llega la hace.
	const CLAVE_HORAS = `${CLAVE}:horas`;
	const MAX_HORAS = 24;
	const UNA_HORA = 3_600_000;
	type Copia = { hora: number; celdas: string; firmas: string[]; zona: string };

	const horaDe = (ms: number) => Math.floor(ms / UNA_HORA);
	const aLas = (hora: number, dia = false) =>
		new Date(hora * UNA_HORA).toLocaleString('es', {
			...(dia ? { weekday: 'short' as const } : {}),
			hour: '2-digit',
			minute: '2-digit',
		});

	function leerHoras(): Copia[] {
		try {
			const lista = JSON.parse(localStorage.getItem(CLAVE_HORAS) ?? '[]');
			if (!Array.isArray(lista)) return [];
			return lista
				.filter((c) => c && Number.isInteger(c.hora) && textoValido(c.celdas))
				.map((c) => ({
					hora: c.hora,
					celdas: c.celdas,
					firmas: limpiarFirmas(c.firmas),
					zona: zonaValida(c.zona) ? c.zona : '0,0',
				}))
				.slice(-MAX_HORAS);
		} catch {
			return [];
		}
	}

	function copiarHora() {
		const ahora = horaDe(Date.now());
		const horas = leerHoras();
		const ultima = horas.at(-1);
		const texto = celdas.join('');
		// Ya hay copia de esta hora, el lienzo está en blanco o no ha cambiado desde la última.
		if (ultima && ultima.hora >= ahora) return;
		if (!celdas.some(Boolean) || (ultima?.celdas === texto && ultima.zona === claveZona())) return;
		horas.push({ hora: ahora, celdas: texto, firmas, zona: claveZona() });
		try {
			localStorage.setItem(CLAVE_HORAS, JSON.stringify(horas.slice(-MAX_HORAS)));
		} catch {
			return;
		}
		decir(`[${hora()}] Copia de las ${aLas(ahora)} guardada.`, 'text-accent');
		pintarHoras();
	}

	function boton(texto: string, accion: () => void) {
		const b = document.createElement('button');
		b.type = 'button';
		b.textContent = texto;
		b.className = 'border border-line px-2 py-1 text-xs text-muted hover:border-accent hover:text-accent';
		b.addEventListener('click', accion);
		return b;
	}

	function pintarHoras() {
		const proxima = raiz?.querySelector<HTMLElement>('[data-pa-proxima]');
		if (proxima) proxima.textContent = `La próxima, a las ${aLas(horaDe(Date.now()) + 1)}. Si no cambia nada, no se repite.`;
		const lista = raiz?.querySelector<HTMLElement>('[data-pa-horas]');
		if (!lista) return;
		lista.replaceChildren(
			...leerHoras()
				.reverse()
				.map((copia) => {
					const fila = document.createElement('li');
					fila.className = 'flex items-center gap-2 border-b border-line px-2 py-1 last:border-b-0';
					const cuando = document.createElement('span');
					cuando.className = 'flex-1 font-mono text-xs text-fg';
					const llenos = [...copia.celdas].filter((c) => c !== '0').length;
					cuando.textContent = `${aLas(copia.hora, true)} · zona ${copia.zona.replace(',', ' · ')} · ${llenos} px`;
					const volver = boton('Volver', () => {
						if (!confirm(`¿Volver a la copia de las ${aLas(copia.hora)}? También cambia en las demás pestañas.`)) return;
						if (copia.zona !== claveZona() && !ir(deClave(copia.zona))) return;
						celdas = [...copia.celdas].map(Number);
						firmas = limpiarFirmas([...firmas, ...copia.firmas]);
						guardar();
						enviarTodo();
						avisar(`Lienzo de vuelta a las ${aLas(copia.hora)}.`);
						todo();
					});
					const txt = boton('.txt', () =>
						descargar(
							archivo([...copia.celdas].map(Number), copia.firmas),
							`pixeles-ascii-${new Date(copia.hora * UNA_HORA).toLocaleString('sv').slice(0, 13).replace(' ', '-')}h.txt`,
						),
					);
					fila.append(cuando, volver, txt);
					return fila;
				}),
		);
	}

	window.addEventListener('storage', (evento) => evento.key === CLAVE_HORAS && pintarHoras());
	setInterval(() => {
		copiarHora();
		pintarHoras();
	}, 30_000);

	raiz?.querySelector('[data-pa-copiar]')?.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(comoTexto());
			avisar('Texto copiado.');
		} catch {
			avisar('No se pudo copiar. Tu navegador no deja usar el portapapeles.');
		}
	});

	// --- El enlace ---

	/** Tiradas de un carácter: el carácter, cuántas veces en base 36 y una coma. */
	function comprimir(texto: string) {
		let salida = '';
		for (let i = 0; i < texto.length; ) {
			let j = i;
			while (j < texto.length && texto[j] === texto[i]) j++;
			salida += `${texto[i]}${(j - i).toString(36)},`;
			i = j;
		}
		return salida;
	}

	function descomprimir(tiradas: string) {
		let texto = '';
		let i = 0;
		while (i < tiradas.length) {
			const fin = tiradas.indexOf(',', i + 1);
			const veces = tiradas.slice(i + 1, fin);
			if (fin < 0 || !/^[0-9a-z]+$/.test(veces)) return null;
			const n = parseInt(veces, 36);
			if (n < 1 || texto.length + n > TOTAL) return null;
			texto += tiradas[i].repeat(n);
			i = fin + 1;
		}
		return textoValido(texto) ? texto : null;
	}

	function aBase64(datos: unknown) {
		let binario = '';
		new TextEncoder().encode(JSON.stringify(datos)).forEach((b) => (binario += String.fromCharCode(b)));
		return btoa(binario).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
	}

	function deBase64(texto: string) {
		try {
			const binario = atob(texto.replace(/-/g, '+').replace(/_/g, '/'));
			return JSON.parse(new TextDecoder().decode(Uint8Array.from(binario, (c) => c.charCodeAt(0))));
		} catch {
			return null;
		}
	}

	raiz?.querySelector('[data-pa-enlace]')?.addEventListener('click', async () => {
		// La obra entera va dentro, zona a zona, y quien lo abre aparece en la tuya.
		sincronizar();
		const z: Record<string, string> = {};
		Object.entries(zonas).forEach(([k, t]) => (z[k] = comprimir(t)));
		const url = `${location.origin}/pixeles-ascii#a=${aBase64({ z, p: claveZona(), f: firmas })}`;
		try {
			await navigator.clipboard.writeText(url);
			avisar('Enlace copiado. Quien lo abra junta la obra entera con la suya y sigue pintando.');
		} catch {
			avisar('No se pudo copiar. Tu navegador no deja usar el portapapeles.');
		}
	});

	// --- Consola ---

	const salida = raiz?.querySelector<HTMLElement>('[data-pa-salida]');
	const comando = raiz?.querySelector<HTMLInputElement>('[data-pa-comando]');
	const MAX_LINEAS = 200;

	const AYUDA = [
		`x va de 0 a ${ANCHO - 1} y y de 0 a ${ALTO - 1}, desde arriba a la izquierda.`,
		'El tono va de 1 a 5 o con su carácter (. : + # @); si no lo pones, va el elegido.',
		'  pixel x y [tono]',
		'  linea x1 y1 x2 y2 [tono]',
		'  caja x y ancho alto [tono]      solo el borde',
		'  rellenar x y ancho alto [tono]',
		'  circulo x y radio [tono]',
		'  borrar x y ancho alto',
		'  ir zx zy                         a otra zona de la obra; ir 0 0, al centro',
		'  di mensaje                       lo leen las demás pestañas, con tu firma',
		'  repeticion                       la zona pintada otra vez, píxel a píxel',
		'  tono t · firma nombre · enlace · ver · vaciar · limpiar',
		'Flechas arriba y abajo: los comandos de antes.',
	];

	function decir(texto: string, color = 'text-muted') {
		if (!salida) return;
		const fila = document.createElement('span');
		fila.className = `block ${color}`;
		fila.textContent = texto;
		salida.append(fila);
		while (salida.childElementCount > MAX_LINEAS) salida.firstElementChild?.remove();
		salida.scrollTop = salida.scrollHeight;
	}

	/** Un tono escrito como número o como su carácter. */
	function leerTono(texto: string | undefined) {
		if (texto === undefined) return tono;
		if (/^[0-5]$/.test(texto)) return Number(texto);
		const i = TONOS.indexOf(texto);
		return i > 0 ? i : null;
	}

	/** Todo un comando sale como un solo trazo a las demás pestañas, con tu firma. */
	function dibujar(trazar: (pon: (x: number, y: number, t: number) => void) => void) {
		const cambios: [number, number][] = [];
		trazar((x, y, t) => {
			if (x < 0 || y < 0 || x >= ANCHO || y >= ALTO) return;
			const i = y * ANCHO + x;
			if (celdas[i] === t) return;
			celdas[i] = t;
			cambios.push([i, t]);
		});
		if (!cambios.length) return 0;
		if (firma) firmas = limpiarFirmas([...firmas, firma]);
		enviar({ tipo: 'trazo', trazo: cambios, firma });
		guardar();
		todo();
		return cambios.length;
	}

	function linea(x0: number, y0: number, x1: number, y1: number, t: number, pon: (x: number, y: number, t: number) => void) {
		const dx = Math.abs(x1 - x0);
		const dy = -Math.abs(y1 - y0);
		const sx = x0 < x1 ? 1 : -1;
		const sy = y0 < y1 ? 1 : -1;
		let error = dx + dy;
		for (;;) {
			pon(x0, y0, t);
			if (x0 === x1 && y0 === y1) return;
			const doble = 2 * error;
			if (doble >= dy) {
				error += dy;
				x0 += sx;
			}
			if (doble <= dx) {
				error += dx;
				y0 += sy;
			}
		}
	}

	const USOS = new Map<string, [number, string]>([
		['pixel', [2, 'pixel x y [tono]']],
		['linea', [4, 'linea x1 y1 x2 y2 [tono]']],
		['caja', [4, 'caja x y ancho alto [tono]']],
		['rellenar', [4, 'rellenar x y ancho alto [tono]']],
		['circulo', [3, 'circulo x y radio [tono]']],
		['borrar', [4, 'borrar x y ancho alto']],
	]);

	function ejecutar(entrada: string) {
		const partes = entrada.split(/\s+/);
		const orden = (partes.shift() ?? '')
			.toLowerCase()
			.normalize('NFD')
			.replace(/[̀-ͯ]/g, '');

		if (orden === 'ayuda' || orden === 'help') return AYUDA.forEach((l) => decir(l));
		if (orden === 'limpiar' || orden === 'clear') {
			if (salida) salida.textContent = '';
			return;
		}
		if (orden === 'ver') return comoTexto().split('\n').forEach((l) => decir(l || ' ', 'text-fg'));
		if (orden === 'enlace') return raiz?.querySelector<HTMLButtonElement>('[data-pa-enlace]')?.click();
		if (orden === 'repeticion') return repeBoton?.click();
		if (orden === 'vaciar') {
			raiz?.querySelector<HTMLButtonElement>('[data-pa-limpiar]')?.click();
			return decir(celdas.some(Boolean) ? 'Sigue como estaba.' : 'Lienzo en blanco.');
		}
		if (orden === 'tono') {
			const t = partes.length === 1 ? leerTono(partes[0]) : null;
			if (t === null || t === 0) return decir('Uso: tono 1-5 o tono @', 'text-mark');
			tono = t;
			guardar();
			pintarDatos();
			return decir(`Tono ${t}: ${TONOS[t]}`);
		}
		if (orden === 'ir') {
			if (partes.length !== 2 || !partes.every((n) => /^-?\d{1,4}$/.test(n))) return decir('Uso: ir zx zy', 'text-mark');
			const [zx, zy] = partes.map(Number);
			if (!ir([zx, zy])) return decir(`No se puede: la obra llega hasta ${MAX_ZONAS} zonas pintadas.`, 'text-mark');
			return decir(`Zona ${zx} · ${zy}${zonas[claveZona()] ? '' : ', en blanco'}.`);
		}
		if (orden === 'di') {
			const dicho = limpiarDicho(partes.join(' '));
			if (!dicho) return decir('Uso: di mensaje', 'text-mark');
			if (!canal) return decir('Tu navegador no deja hablar con las demás pestañas.', 'text-mark');
			enviar({ tipo: 'di', texto: dicho, firma });
			decir(`[${hora()}] ${firma || 'tú'}: ${dicho}`, 'text-accent');
			if (!otras.size) decir('No hay otras pestañas abiertas: no lo lee nadie aún.');
			return;
		}
		if (orden === 'firma') {
			firma = limpiarFirma(partes.join(' '));
			if (firmaCampo) firmaCampo.value = firma;
			guardar();
			return decir(firma ? `Firmas como ${firma}.` : 'Sin firma.');
		}

		const uso = USOS.get(orden);
		if (!uso) return decir(`No conozco «${orden}». Escribe ayuda.`, 'text-mark');
		const numeros = partes.slice(0, uso[0]);
		const resto = partes.slice(uso[0]);
		const t = orden === 'borrar' ? 0 : leerTono(resto[0]);
		if (
			numeros.length < uso[0] ||
			!numeros.every((n) => /^-?\d{1,3}$/.test(n)) ||
			resto.length > (orden === 'borrar' ? 0 : 1) ||
			t === null
		) {
			return decir(`Uso: ${uso[1]}`, 'text-mark');
		}
		const n = numeros.map(Number);
		const medidas = orden === 'pixel' || orden === 'linea' ? [] : n.slice(2);
		if (medidas.some((m) => m < 1 || m > ANCHO)) return decir(`Las medidas van de 1 a ${ANCHO}.`, 'text-mark');

		const cuantos = dibujar((pon) => {
			if (orden === 'pixel') pon(n[0], n[1], t);
			else if (orden === 'linea') linea(n[0], n[1], n[2], n[3], t, pon);
			else if (orden === 'circulo') {
				for (let y = -n[2]; y <= n[2]; y++) {
					for (let x = -n[2]; x <= n[2]; x++) {
						if (Math.abs(Math.hypot(x, y) - n[2]) < 0.5) pon(n[0] + x, n[1] + y, t);
					}
				}
			} else {
				for (let y = 0; y < n[3]; y++) {
					for (let x = 0; x < n[2]; x++) {
						const borde = x === 0 || y === 0 || x === n[2] - 1 || y === n[3] - 1;
						if (orden !== 'caja' || borde) pon(n[0] + x, n[1] + y, t);
					}
				}
			}
		});
		decir(cuantos ? `Hecho: ${cuantos} píxeles.` : 'No cambia nada: fuera del lienzo o ya estaba.');
	}

	const anteriores: string[] = [];
	let vuelta = 0;

	raiz?.querySelector<HTMLFormElement>('[data-pa-consola]')?.addEventListener('submit', (evento) => {
		evento.preventDefault();
		if (!comando) return;
		const entrada = comando.value.trim();
		comando.value = '';
		if (!entrada) return;
		if (anteriores.at(-1) !== entrada) anteriores.push(entrada);
		if (anteriores.length > 50) anteriores.shift();
		vuelta = anteriores.length;
		decir(`$ ${entrada}`, 'text-fg');
		ejecutar(entrada);
	});

	comando?.addEventListener('keydown', (evento) => {
		if (evento.key !== 'ArrowUp' && evento.key !== 'ArrowDown') return;
		evento.preventDefault();
		vuelta = Math.min(anteriores.length, Math.max(0, vuelta + (evento.key === 'ArrowUp' ? -1 : 1)));
		comando.value = anteriores[vuelta] ?? '';
	});

	// --- Arranque ---

	// Un dibujo que llega en el enlace se junta con el tuyo: donde trae píxel, manda el suyo.
	const recibido = /^#a=([A-Za-z0-9_-]+)$/.exec(location.hash);
	if (recibido) {
		const datos = deBase64(recibido[1]);
		// Los enlaces de antes traen un solo dibujo (c), que se junta con la zona en la que estés.
		const traidas: Record<string, string> = {};
		if (datos && typeof datos.c === 'string') {
			const texto = descomprimir(datos.c);
			if (texto) traidas[claveZona()] = texto;
		}
		if (datos && datos.z && typeof datos.z === 'object') {
			Object.entries(datos.z)
				.slice(0, MAX_ZONAS)
				.forEach(([k, c]) => {
					const texto = zonaValida(k) && typeof c === 'string' ? descomprimir(c) : null;
					if (texto) traidas[k] = texto;
				});
		}
		if (Object.keys(traidas).length) {
			sincronizar();
			Object.entries(traidas).forEach(([k, texto]) => {
				if (!zonas[k] && Object.keys(zonas).length >= MAX_ZONAS) return;
				const base = zonas[k] ?? '0'.repeat(TOTAL);
				const junta = [...texto].map((c, i) => (c !== '0' ? c : base[i])).join('');
				if (/[1-5]/.test(junta)) zonas[k] = junta;
			});
			if (zonaValida(datos.p)) zona = deClave(datos.p);
			celdas = [...(zonas[claveZona()] ?? '0'.repeat(TOTAL))].map(Number);
			firmas = limpiarFirmas([...firmas, ...limpiarFirmas(datos.f)]);
			guardar();
			enviar({ tipo: 'obra', zonas, firmas });
			avisar('La obra del enlace, juntada con la tuya. Sigue pintando y pásala.');
		} else avisar('El enlace está roto: sigue el dibujo que tenías.');
		history.replaceState(null, '', '/pixeles-ascii');
	}

	// El tema puede cambiar de claro a oscuro: la rejilla y la tinta siguen sus colores.
	new MutationObserver(() => {
		pintarTela();
		pintarMapa();
	}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-modo'] });

	// La vista de terminal escribe con Geist Mono: se repinta cuando acaba de cargar.
	document.fonts?.ready.then(pintarTela);

	decir('Escribe ayuda para ver los comandos.');
	copiarHora();
	pintarHoras();
	enviar({ tipo: 'hola' });
	pintarPestanas();
	todo();
</script>

<style>
	.pa-cursor {
		animation: pa-parpadeo 1s steps(1) infinite;
	}

	@keyframes pa-parpadeo {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pa-cursor {
			animation: none;
		}
	}
</style>
