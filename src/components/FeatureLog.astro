---
import type { Feature, Release } from '../lib/db/schema';
import type { SiteState } from '../lib/releases';
import Icon from './Icon.astro';

interface Props {
	version: number;
	lastShipped: Feature | null;
	next: Feature | null;
	lastRelease: Release | null;
	state: SiteState;
}

const { version, lastShipped, next, lastRelease, state } = Astro.props;

/** Cuando algo va mal se cuenta aquí, con el motivo tal cual salió. */
const AVISOS: Partial<Record<SiteState, { icon: string; text: string }>> = {
	repairing: {
		icon: 'tool',
		text: 'La última actualización falló y la IA la está arreglando sola. La web sigue en la versión anterior.',
	},
	reverted: {
		icon: 'alert-triangle',
		text: 'La última actualización rompía algo y la web volvió sola a la versión anterior.',
	},
	broken: {
		icon: 'alert-triangle',
		text: 'La última actualización falló y hace falta mirarla a mano.',
	},
};

const aviso = AVISOS[state];
---

<div class="flex flex-col gap-5">
	{
		aviso && (
			<p class="flex items-start gap-2.5 text-sm text-mark">
				<Icon name={aviso.icon} class="mt-0.5 size-4 shrink-0" />
				<span>
					{aviso.text}
					{lastRelease?.error && <span class="text-muted"> {lastRelease.error}</span>}
				</span>
			</p>
		)
	}

	<div class="grid gap-6 sm:grid-cols-2 sm:gap-10">
		{
			lastShipped && (
				<div class="flex flex-col gap-2">
					<p class="flex items-center gap-2 font-pixel text-xs tracking-wide text-accent">
						<Icon name="check" class="size-3.5 shrink-0" />
						ÚLTIMO CAMBIO
					</p>
					<p class="text-sm text-pretty">
						<span class="font-pixel text-accent">v{version}</span>
						<span class="text-muted"> · </span>
						{lastShipped.title}
					</p>
				</div>
			)
		}

		{
			next && (
				<div class="flex flex-col gap-2 sm:border-l sm:border-line sm:pl-10">
					<p class="flex items-center gap-2 font-pixel text-xs tracking-wide text-muted">
						<Icon name="hammer" class="size-3.5 shrink-0" />
						EN CONSTRUCCIÓN
					</p>
					<p class="text-sm text-pretty">{next.title}</p>
				</div>
			)
		}
	</div>
</div>
