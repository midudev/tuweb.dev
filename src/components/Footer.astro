---
import CopyLink from './CopyLink.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<footer data-canvas class="border-t border-line bg-panel">
	<div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-4 px-5 py-7 text-sm text-muted sm:px-6 lg:px-8">
		<p class="inline-flex items-center gap-1.5">
			Desarrollado con
			<Icon name="heart-filled" class="size-4 shrink-0 text-heart" />
			con <a href="https://midu.dev" class="text-accent hover:underline">@midudev</a>
		</p>
		<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
			<!-- La zona la pone el navegador: sin JavaScript esta línea no sale. -->
			<p data-zona class="hidden items-center gap-2">
				<Icon name="clock" class="size-4 shrink-0 text-accent" />
				Horas en tu zona: <span data-zona-nombre class="text-fg"></span>
			</p>
			<CopyLink />
			<a href="/todo" class="text-accent hover:underline">Todo</a>
			<a href="/creditos" class="text-accent hover:underline">Créditos</a>
			<a href="/changelog" class="text-accent hover:underline">Changelog</a>
			<a href="/historial" class="text-accent hover:underline">Historial</a>
			<a
				href="https://github.com/midudev/tuweb.dev"
				class="inline-flex items-center gap-2 text-accent hover:underline"
			>
				<Icon name="brand-github" class="size-4 shrink-0" />
				El código de esta web
			</a>
			<ThemeToggle />
		</div>
	</div>
</footer>

<script>
	import { zonaDelDispositivo } from '../lib/hora';

	// Si el navegador no sabe decir la zona, la línea se queda escondida.
	const zona = zonaDelDispositivo();
	const aviso = document.querySelector<HTMLElement>('[data-zona]');
	const nombre = aviso?.querySelector<HTMLElement>('[data-zona-nombre]');

	if (zona && aviso && nombre) {
		nombre.textContent = zona;
		aviso.classList.replace('hidden', 'inline-flex');
	}
</script>
