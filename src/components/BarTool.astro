---
/**
 * Diseñador de barras: cada barra con su etiqueta, su valor y su color, y unos
 * mandos para la forma. El SVG se rehace a cada tecla y se baja en SVG o PNG.
 * Todo se pinta en el navegador; no se guarda ni se envía nada.
 */
import { MAX_BARS } from '../lib/bars';
import Icon from './Icon.astro';

const OPCION =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:text-accent disabled:opacity-40';
const CAMPO = 'w-full border border-line bg-panel px-3 py-2 text-sm outline-none focus-visible:border-accent';

const ORIENTACIONES = [
	{ id: 'vertical', label: 'Vertical', icon: 'chart-bar' },
	{ id: 'horizontal', label: 'Horizontal', icon: 'chart-bar-popular' },
];
const ORDENES = [
	{ id: 'libre', label: 'Como las escribo', icon: 'arrows-sort' },
	{ id: 'mayor', label: 'De mayor a menor', icon: 'sort-descending' },
	{ id: 'menor', label: 'De menor a mayor', icon: 'sort-ascending' },
];
---

<div role="tabpanel" id="barras" aria-labelledby="tab-barras" data-panel="barras" hidden class="grid gap-7 md:grid-cols-2">
	<div class="flex min-w-0 flex-col gap-6">
		<div class="grid gap-3 sm:grid-cols-[1fr_8rem]">
			<label class="flex flex-col gap-1">
				<span class="text-sm text-muted">Título</span>
				<input type="text" data-bar-texto="title" maxlength="80" class={CAMPO} />
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm text-muted">Unidad</span>
				<input type="text" data-bar-texto="unit" maxlength="8" placeholder="€, %, kg…" class={CAMPO} />
			</label>
		</div>

		<div class="flex flex-col gap-3">
			<h3 id="bar-orientacion" class="text-sm text-muted">Orientación</h3>
			<div role="group" aria-labelledby="bar-orientacion" class="flex flex-wrap gap-2">
				{
					ORIENTACIONES.map((o) => (
						<button type="button" data-bar-orientacion={o.id} aria-pressed="false" class={OPCION}>
							<Icon name={o.icon} class="size-4 shrink-0" />
							{o.label}
						</button>
					))
				}
			</div>
		</div>

		<div class="flex flex-col gap-3">
			<h3 id="bar-orden" class="text-sm text-muted">Orden</h3>
			<div role="group" aria-labelledby="bar-orden" class="flex flex-wrap gap-2">
				{
					ORDENES.map((o) => (
						<button type="button" data-bar-orden={o.id} aria-pressed="false" class={OPCION}>
							<Icon name={o.icon} class="size-4 shrink-0" />
							{o.label}
						</button>
					))
				}
			</div>
		</div>

		<label class="flex flex-col gap-2">
			<span class="flex justify-between text-sm text-muted">
				Hueco entre barras
				<output data-bar-hueco-valor class="text-mark"></output>
			</span>
			<input type="range" data-bar-hueco min="0" max="80" step="5" class="w-full accent-accent" />
		</label>

		<div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
			<label class="inline-flex items-center gap-2">
				<input type="checkbox" data-bar-check="showValues" class="size-4 accent-accent" />
				Valores
			</label>
			<label class="inline-flex items-center gap-2">
				<input type="checkbox" data-bar-check="showGrid" class="size-4 accent-accent" />
				Rejilla
			</label>
			<label class="inline-flex items-center gap-2">
				<input type="checkbox" data-bar-oscuro class="size-4 accent-accent" />
				Fondo oscuro
			</label>
		</div>

		<div class="flex flex-col gap-3">
			<h3 class="text-sm text-muted">Barras</h3>
			<ol data-bar-lista class="flex flex-col gap-2"></ol>
			<div class="flex flex-wrap items-center gap-2">
				<button type="button" data-bar-nueva class={OPCION}>
					<Icon name="plus" class="size-4 shrink-0" />
					Barra
				</button>
				<span class="inline-flex items-center gap-2 text-sm text-muted">
					<input
						type="color"
						data-bar-todas-color
						aria-label="Color para todas las barras"
						class="h-9 w-10 shrink-0 cursor-pointer border border-line bg-panel p-0.5"
					/>
					<button type="button" data-bar-todas class={OPCION}>Todas de este color</button>
				</span>
				<button type="button" data-bar-paleta class={OPCION}>
					<Icon name="palette" class="size-4 shrink-0" />
					Paleta
				</button>
			</div>
		</div>
	</div>

	<div class="flex min-w-0 flex-col gap-4 md:sticky md:top-6 md:self-start">
		<span class="text-sm text-muted">Así queda</span>
		<div data-bar-previo class="border border-line [&>svg]:block [&>svg]:h-auto [&>svg]:w-full"></div>
		<div class="flex flex-wrap items-center gap-2">
			<button type="button" data-bar-baja="svg" class={OPCION}>
				<Icon name="file-type-svg" class="size-4 shrink-0" />
				Descargar .svg
			</button>
			<button type="button" data-bar-baja="png" class={OPCION}>
				<Icon name="file-type-png" class="size-4 shrink-0" />
				Descargar .png
			</button>
		</div>
		<p data-bar-aviso class="text-sm text-muted empty:hidden" aria-live="polite"></p>
		<p class="text-sm text-muted">
			Hasta {MAX_BARS} barras. Admite negativos y decimales con coma. Pasa el ratón por encima para ver cada valor.
		</p>
	</div>

	<template data-bar-icono><Icon name="x" class="size-4 shrink-0" /></template>
</div>

<script>
	import { DEFAULT_DISENO, MAX_BARS, buildBars, type Diseno, type Order, type Orientation } from '../lib/bars';
	import { PALETTE, type Theme } from '../lib/chart';

	const previo = document.querySelector<HTMLElement>('[data-bar-previo]');
	const lista = document.querySelector<HTMLOListElement>('[data-bar-lista]');
	const aviso = document.querySelector<HTMLElement>('[data-bar-aviso]');
	const hueco = document.querySelector<HTMLInputElement>('[data-bar-hueco]');
	const huecoValor = document.querySelector<HTMLOutputElement>('[data-bar-hueco-valor]');
	const oscuro = document.querySelector<HTMLInputElement>('[data-bar-oscuro]');
	const nueva = document.querySelector<HTMLButtonElement>('[data-bar-nueva]');
	const todasColor = document.querySelector<HTMLInputElement>('[data-bar-todas-color]');
	const icono = document.querySelector<HTMLTemplateElement>('[data-bar-icono]');

	const CAMPO = 'min-w-0 border border-line bg-panel px-2 py-1 text-sm outline-none focus-visible:border-accent';

	type Texto = 'title' | 'unit';
	type Check = 'showValues' | 'showGrid';

	let diseno: Diseno = structuredClone(DEFAULT_DISENO);
	// Arranca con el fondo de la web: quien la lee de noche, se lo encuentra oscuro.
	if (document.documentElement.dataset.modo === 'oscuro') diseno = recolorea(diseno, 'oscuro');

	/** Los colores de la paleta pasan a su paso del otro fondo; los elegidos a mano se quedan. */
	function recolorea(d: Diseno, theme: Theme): Diseno {
		const paso = (color: string) => {
			const i = PALETTE[d.theme].indexOf(color);
			return i >= 0 ? PALETTE[theme][i] : color;
		};
		return { ...d, theme, bars: d.bars.map((b) => ({ ...b, color: paso(b.color) })) };
	}

	function campo(type: string, value: string, data: Record<string, string>, label: string) {
		const input = document.createElement('input');
		input.type = type;
		input.value = value;
		input.setAttribute('aria-label', label);
		Object.assign(input.dataset, data);
		return input;
	}

	/** La lista se rehace solo cuando cambia su forma; al escribir, se toca el estado y ya. */
	function pintaLista() {
		if (!lista) return;
		lista.replaceChildren(
			...diseno.bars.map((barra, i) => {
				const li = document.createElement('li');
				li.className = 'flex items-center gap-2';
				const color = campo('color', barra.color, { barColor: String(i) }, `Color de la barra ${i + 1}`);
				color.className = 'h-8 w-9 shrink-0 cursor-pointer border border-line bg-panel p-0.5';
				const etiqueta = campo('text', barra.label, { barEtiqueta: String(i) }, `Etiqueta de la barra ${i + 1}`);
				etiqueta.maxLength = 40;
				etiqueta.className = `${CAMPO} flex-1`;
				const valor = campo('text', barra.value, { barValor: String(i) }, `Valor de la barra ${i + 1}`);
				valor.maxLength = 20;
				valor.inputMode = 'decimal';
				valor.className = `${CAMPO} w-24 text-right`;
				const quitar = document.createElement('button');
				quitar.type = 'button';
				quitar.className = 'inline-flex shrink-0 items-center p-1 text-muted hover:text-accent disabled:opacity-30';
				quitar.disabled = diseno.bars.length <= 1;
				quitar.title = 'Quitar barra';
				quitar.setAttribute('aria-label', 'Quitar barra');
				quitar.dataset.barQuita = String(i);
				if (icono) quitar.append(icono.content.cloneNode(true));
				li.append(color, etiqueta, valor, quitar);
				return li;
			}),
		);
		if (nueva) nueva.disabled = diseno.bars.length >= MAX_BARS;
	}

	function pintaControles() {
		document.querySelectorAll<HTMLButtonElement>('[data-bar-orientacion]').forEach((b) => {
			b.setAttribute('aria-pressed', String(b.dataset.barOrientacion === diseno.orientation));
		});
		document.querySelectorAll<HTMLButtonElement>('[data-bar-orden]').forEach((b) => {
			b.setAttribute('aria-pressed', String(b.dataset.barOrden === diseno.order));
		});
		document.querySelectorAll<HTMLInputElement>('[data-bar-texto]').forEach((input) => {
			input.value = diseno[input.dataset.barTexto as Texto];
		});
		document.querySelectorAll<HTMLInputElement>('[data-bar-check]').forEach((input) => {
			input.checked = diseno[input.dataset.barCheck as Check];
		});
		if (hueco) hueco.value = String(diseno.gap);
		if (huecoValor) huecoValor.value = `${diseno.gap} %`;
		if (oscuro) oscuro.checked = diseno.theme === 'oscuro';
		if (todasColor) todasColor.value = PALETTE[diseno.theme][0];
	}

	function pinta() {
		if (previo) previo.innerHTML = buildBars(diseno).svg;
	}

	document.querySelectorAll<HTMLButtonElement>('[data-bar-orientacion]').forEach((b) => {
		b.addEventListener('click', () => {
			diseno.orientation = b.dataset.barOrientacion as Orientation;
			pintaControles();
			pinta();
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-bar-orden]').forEach((b) => {
		b.addEventListener('click', () => {
			diseno.order = b.dataset.barOrden as Order;
			pintaControles();
			pinta();
		});
	});

	document.querySelectorAll<HTMLInputElement>('[data-bar-texto]').forEach((input) => {
		input.addEventListener('input', () => {
			diseno[input.dataset.barTexto as Texto] = input.value;
			pinta();
		});
	});

	document.querySelectorAll<HTMLInputElement>('[data-bar-check]').forEach((input) => {
		input.addEventListener('change', () => {
			diseno[input.dataset.barCheck as Check] = input.checked;
			pinta();
		});
	});

	hueco?.addEventListener('input', () => {
		diseno.gap = Number(hueco.value);
		if (huecoValor) huecoValor.value = `${diseno.gap} %`;
		pinta();
	});

	oscuro?.addEventListener('change', () => {
		diseno = recolorea(diseno, oscuro.checked ? 'oscuro' : 'claro');
		pintaControles();
		pintaLista();
		pinta();
	});

	lista?.addEventListener('input', (event) => {
		const input = event.target as HTMLInputElement;
		const { barColor, barEtiqueta, barValor } = input.dataset;
		if (barColor) diseno.bars[Number(barColor)].color = input.value;
		else if (barEtiqueta) diseno.bars[Number(barEtiqueta)].label = input.value;
		else if (barValor) diseno.bars[Number(barValor)].value = input.value;
		else return;
		pinta();
	});

	lista?.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-bar-quita]');
		if (!button || button.disabled) return;
		diseno.bars.splice(Number(button.dataset.barQuita), 1);
		pintaLista();
		pinta();
	});

	nueva?.addEventListener('click', () => {
		if (diseno.bars.length >= MAX_BARS) return;
		const paleta = PALETTE[diseno.theme];
		const usados = diseno.bars.map((b) => b.color);
		const color = paleta.find((c) => !usados.includes(c)) ?? paleta[diseno.bars.length % paleta.length];
		diseno.bars.push({ label: `Barra ${diseno.bars.length + 1}`, value: '', color });
		pintaLista();
		pinta();
		lista?.querySelector<HTMLInputElement>('li:last-child input[type="text"]')?.select();
	});

	document.querySelector('[data-bar-todas]')?.addEventListener('click', () => {
		if (!todasColor) return;
		diseno.bars.forEach((b) => (b.color = todasColor.value));
		pintaLista();
		pinta();
	});

	document.querySelector('[data-bar-paleta]')?.addEventListener('click', () => {
		const paleta = PALETTE[diseno.theme];
		diseno.bars.forEach((b, i) => (b.color = paleta[i % paleta.length]));
		pintaLista();
		pinta();
	});

	function nombre(extension: string) {
		const base = diseno.title
			.normalize('NFD')
			.replace(/[̀-ͯ]/g, '')
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-|-$/g, '')
			.slice(0, 40);
		return `${base || 'barras'}.${extension}`;
	}

	function bajar(fichero: Blob, name: string) {
		const url = URL.createObjectURL(fichero);
		const enlace = document.createElement('a');
		enlace.href = url;
		enlace.download = name;
		enlace.click();
		// Soltar la URL en el mismo tick corta la descarga en algún navegador.
		setTimeout(() => URL.revokeObjectURL(url), 1000);
	}

	/* Un SVG pintado como imagen no ve las fuentes de la página: para el PNG van dentro. */
	const FUENTES = [
		['Geist Mono Variable', '/fonts/geist-mono-latin-wght-normal.woff2', '100 900'],
		['Geist Pixel', '/fonts/geist-pixel-latin-400-normal.woff2', '400'],
	];
	let fuentesCss: Promise<string> | null = null;

	function fuentes() {
		fuentesCss ??= Promise.all(
			FUENTES.map(async ([family, url, weight]) => {
				const blob = await (await fetch(url)).blob();
				const data = await new Promise<string>((resolve, reject) => {
					const lector = new FileReader();
					lector.onload = () => resolve(String(lector.result));
					lector.onerror = () => reject(lector.error);
					lector.readAsDataURL(blob);
				});
				return `@font-face{font-family:'${family}';font-weight:${weight};src:url(${data}) format('woff2');}`;
			}),
		)
			.then((reglas) => reglas.join(''))
			.catch(() => '');
		return fuentesCss;
	}

	async function png() {
		const { svg, width, height } = buildBars(diseno, { fontCss: await fuentes() });
		const imagen = new Image();
		imagen.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
		await imagen.decode();
		// Al doble, para que se vea nítido en pantallas densas.
		const lienzo = document.createElement('canvas');
		lienzo.width = width * 2;
		lienzo.height = height * 2;
		lienzo.getContext('2d')?.drawImage(imagen, 0, 0, lienzo.width, lienzo.height);
		const blob = await new Promise<Blob | null>((resolve) => lienzo.toBlob(resolve, 'image/png'));
		if (!blob) throw new Error('sin PNG');
		bajar(blob, nombre('png'));
	}

	document.querySelectorAll<HTMLButtonElement>('[data-bar-baja]').forEach((button) => {
		button.addEventListener('click', async () => {
			if (button.dataset.barBaja === 'svg') {
				bajar(new Blob([buildBars(diseno).svg], { type: 'image/svg+xml' }), nombre('svg'));
				return;
			}
			button.disabled = true;
			try {
				await png();
				if (aviso) aviso.textContent = '';
			} catch {
				if (aviso) aviso.textContent = 'No se pudo sacar el PNG. Prueba con el SVG.';
			} finally {
				button.disabled = false;
			}
		});
	});

	pintaControles();
	pintaLista();
	pinta();
</script>
