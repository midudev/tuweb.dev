---
/**
 * Generador de gradientes CSS: dos o más colores con su posición, lineal o
 * radial, con ángulo o con centro. La vista previa es el propio CSS aplicado a
 * una caja, y debajo a un elemento de prueba (botón, tarjeta o texto) para verlo
 * en uso. A la muestra se le cambia el texto, el tamaño, el color de la letra
 * y el fondo sobre el que se ve. Se exporta como CSS, variable, SCSS, estilo de React, clase de
 * Tailwind, SVG o PNG; el SVG y el PNG
 * usan la misma geometría que el navegador para el CSS, así lo que se baja es
 * lo que se ve. Todo pasa en el navegador y
 * lo único que se guarda es el estado, en localStorage.
 *
 * Para compartir, el gradiente cabe en un código corto que viaja en la URL
 * (?gradiente=l135-c2410c.0-2563eb.100#gradientes): quien abre el enlace ve
 * ese mismo gradiente. Los ejemplos usan el mismo código. Un radial con el
 * centro movido lo lleva detrás de la forma: rc@30.40-….
 *
 * La vista previa se toca: en lineal, arrastrar gira el ángulo hacia el
 * puntero; en radial, mueve el centro. También con las flechas del teclado.
 *
 * Encima de la lista de colores hay una barra con el gradiente de izquierda a
 * derecha: se pulsa para añadir un color en ese punto y se arrastran las marcas.
 *
 * Debajo va la galería de la comunidad (GradientGallery): lee el gradiente de
 * data-gr-codigo y pide abrir uno con el evento gr:cargar.
 */
import GradientGallery from './GradientGallery.astro';
import Icon from './Icon.astro';

// Código: l<ángulo> o r<c|e>, y luego -<hex sin #>.<posición> por color.
const EJEMPLOS = [
	{ nombre: 'Atardecer', codigo: 'l135-ff5f6d.0-ffc371.100' },
	{ nombre: 'Océano', codigo: 'l180-0f2027.0-203a43.50-2c5364.100' },
	{ nombre: 'Lima', codigo: 'l90-a8e063.0-56ab2f.100' },
	{ nombre: 'Neón', codigo: 'l45-f72585.0-7209b7.50-3a0ca3.100' },
	{ nombre: 'Brasa', codigo: 'rc-f5c542.0-c2410c.60-1a0a00.100' },
	{ nombre: 'Niebla', codigo: 're-e0e0e0.0-6b7280.100' },
];

function aCss(codigo: string) {
	const [cabeza, ...colores] = codigo.split('-');
	const paradas = colores.map((c) => `#${c.replace('.', ' ')}%`).join(', ');
	if (cabeza.startsWith('l')) return `linear-gradient(${cabeza.slice(1)}deg, ${paradas})`;
	return `radial-gradient(${cabeza === 're' ? 'ellipse' : 'circle'}, ${paradas})`;
}

const CAMPO = 'w-full border border-line bg-panel px-3 py-2 text-sm outline-none focus-visible:border-accent';
const BOTON =
	'inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent';
const OPCION =
	'border border-line px-3 py-2 text-sm text-muted hover:text-fg aria-pressed:border-accent aria-pressed:text-accent';

const ANGULOS = [0, 45, 90, 135, 180, 225, 270, 315];

const TAMANOS = [
	{ id: '1200x630', label: '1200×630 (redes)' },
	{ id: '1920x1080', label: '1920×1080 (fondo)' },
	{ id: '1080x1080', label: '1080×1080 (cuadrado)' },
	{ id: '1080x1920', label: '1080×1920 (vertical)' },
];

// Elementos de prueba: el gradiente aplicado a algo real, no solo a una caja.
const PRUEBAS = [
	{ id: 'boton', label: 'Botón', icon: 'click' },
	{ id: 'tarjeta', label: 'Tarjeta', icon: 'layout-cards' },
	{ id: 'texto', label: 'Texto', icon: 'typography' },
];

// Sobre qué fondo se ve la muestra: los colores de la propia web.
const ESCENARIOS = [
	{ id: 'panel', label: 'Panel' },
	{ id: 'bg', label: 'Fondo' },
	{ id: 'fg', label: 'Contraste' },
];

const FORMATOS = [
	{ id: 'css', label: 'CSS', icon: 'file-type-css' },
	{ id: 'variable', label: 'Variable', icon: 'variable' },
	{ id: 'scss', label: 'SCSS', icon: 'brand-sass' },
	{ id: 'react', label: 'React', icon: 'brand-react' },
	{ id: 'tailwind', label: 'Tailwind', icon: 'brand-tailwind' },
	{ id: 'svg', label: 'SVG', icon: 'file-type-svg' },
];
---

<div
	role="tabpanel"
	id="gradientes"
	aria-labelledby="tab-gradientes"
	data-panel="gradientes"
	hidden
	class="flex flex-col gap-6"
>
	<div class="flex flex-col gap-2">
		<span class="text-sm text-muted">Para empezar</span>
		<div class="flex flex-wrap gap-2">
			{
				EJEMPLOS.map((ejemplo) => (
					<button
						type="button"
						data-gr-ejemplo={ejemplo.codigo}
						class="inline-flex items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent"
					>
						<span class="size-4 shrink-0 border border-line" style={`background: ${aCss(ejemplo.codigo)};`} />
						{ejemplo.nombre}
					</button>
				))
			}
		</div>
	</div>

	<div class="grid gap-6 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]">
		<div class="flex flex-col gap-5">
			<div class="flex flex-col gap-2">
				<span class="text-sm text-muted">Tipo</span>
				<div class="flex flex-wrap gap-2">
					<button type="button" data-gr-tipo="linear" aria-pressed="true" class={OPCION}>Lineal</button>
					<button type="button" data-gr-tipo="radial" aria-pressed="false" class={OPCION}>Radial</button>
				</div>
			</div>

			<div data-gr-lineal class="flex flex-col gap-2">
				<label class="flex items-center justify-between gap-3 text-sm text-muted" for="gr-angulo">
					Ángulo
					<span class="inline-flex items-center gap-1">
						<input
							type="number"
							min="0"
							max="360"
							step="1"
							data-gr-angulo-num
							aria-label="Ángulo en grados"
							class="w-20 border border-line bg-panel px-2 py-1 text-right text-sm text-fg outline-none focus-visible:border-accent"
						/>
						deg
					</span>
				</label>
				<input id="gr-angulo" type="range" min="0" max="360" step="1" data-gr-angulo class="w-full accent-accent" />
				<div class="flex flex-wrap gap-1">
					{
						ANGULOS.map((angulo) => (
							<button
								type="button"
								data-gr-angulo-rapido={angulo}
								class="border border-line px-2 py-1 text-xs text-muted hover:border-accent hover:text-accent"
							>
								{angulo}°
							</button>
						))
					}
				</div>
			</div>

			<div data-gr-radial hidden class="flex flex-col gap-2">
				<span class="text-sm text-muted">Forma</span>
				<div class="flex flex-wrap gap-2">
					<button type="button" data-gr-forma="circle" aria-pressed="true" class={OPCION}>Círculo</button>
					<button type="button" data-gr-forma="ellipse" aria-pressed="false" class={OPCION}>Elipse</button>
				</div>
				<span class="mt-2 text-sm text-muted">Centro</span>
				{
					[
						{ eje: 'x', label: 'Horizontal' },
						{ eje: 'y', label: 'Vertical' },
					].map((campo) => (
						<label class="flex items-center gap-3 text-xs text-muted">
							<span class="w-20 shrink-0">{campo.label}</span>
							<input type="range" min="0" max="100" step="1" data-gr-centro={campo.eje} class="min-w-0 flex-1 accent-accent" />
							<span data-gr-centro-texto={campo.eje} class="w-10 shrink-0 text-right"></span>
						</label>
					))
				}
				<div class="flex flex-wrap items-center gap-2">
					<button type="button" data-gr-centrar class="inline-flex items-center gap-2 border border-line px-2 py-1 text-xs text-muted hover:border-accent hover:text-accent">
						<Icon name="current-location" class="size-4 shrink-0" />
						Al medio
					</button>
					<span class="text-xs text-muted">O pulsa en la vista previa.</span>
				</div>
			</div>

			<div class="flex flex-col gap-3">
				<span class="text-sm text-muted">Colores</span>
				<div
					data-gr-barra
					aria-hidden="true"
					class="relative h-8 cursor-copy touch-none border border-line select-none"
				></div>
				<span class="text-xs text-muted">Pulsa en la barra para poner un color ahí. Arrastra las marcas para moverlos.</span>
				<div data-gr-lista class="flex flex-col gap-3"></div>
				<div class="flex flex-wrap gap-2">
					<button type="button" data-gr-nuevo class={`${BOTON} disabled:opacity-40`}>
						<Icon name="plus" class="size-4 shrink-0" />
						Otro color
					</button>
					<button type="button" data-gr-repartir class={BOTON}>
						<Icon name="line-dashed" class="size-4 shrink-0" />
						Repartir
					</button>
					<button type="button" data-gr-azar class={BOTON}>
						<Icon name="arrows-shuffle" class="size-4 shrink-0" />
						Al azar
					</button>
					<button type="button" data-gr-reset class={BOTON}>
						<Icon name="refresh" class="size-4 shrink-0" />
						Restablecer
					</button>
				</div>
			</div>
		</div>

		<div class="flex min-w-0 flex-col gap-4">
			<div class="flex flex-col gap-2">
				<div
					data-gr-vista
					tabindex="0"
					role="group"
					aria-label="Vista previa del gradiente"
					aria-describedby="gr-vista-ayuda"
					class="relative w-full overflow-hidden border border-line outline-none select-none focus-visible:border-accent"
					style="aspect-ratio: 1200 / 630;"
				>
					<span
						data-gr-guia="lineal"
						aria-hidden="true"
						class="pointer-events-none absolute bottom-1/2 left-1/2 h-[35%] w-0.5 -translate-x-1/2 bg-fg outline outline-1 outline-bg"
						style="transform-origin: 50% 100%;"
					>
						<span class="absolute -top-1 left-1/2 size-2.5 -translate-x-1/2 bg-fg outline outline-1 outline-bg"></span>
					</span>
					<span
						data-gr-guia="radial"
						aria-hidden="true"
						class="pointer-events-none absolute size-3 -translate-x-1/2 -translate-y-1/2 border-2 border-bg outline outline-1 outline-fg"
					></span>
				</div>
				<p id="gr-vista-ayuda" data-gr-vista-ayuda class="text-xs text-muted"></p>
			</div>

			<div class="flex flex-col gap-2">
				<span class="text-sm text-muted">Probar sobre</span>
				<div class="flex flex-wrap gap-2">
					{
						PRUEBAS.map((prueba) => (
							<button
								type="button"
								data-gr-prueba={prueba.id}
								aria-pressed={prueba.id === 'boton' ? 'true' : 'false'}
								class={`${OPCION} inline-flex items-center gap-2`}
							>
								<Icon name={prueba.icon} class="size-4 shrink-0" />
								{prueba.label}
							</button>
						))
					}
				</div>
				<div class="grid gap-3 sm:grid-cols-2">
					<label class="flex flex-col gap-1 text-xs text-muted">
						Texto
						<input type="text" data-gr-m-texto maxlength="40" placeholder="El de cada elemento" spellcheck="false" autocomplete="off" class={CAMPO} />
					</label>
					<label class="flex flex-col gap-1 text-xs text-muted">
						<span class="flex justify-between">Tamaño <span data-gr-m-escala-texto></span></span>
						<input type="range" min="50" max="200" step="10" data-gr-m-escala class="w-full accent-accent" />
					</label>
					<label class="flex items-center gap-2 text-xs text-muted">
						<input
							type="color"
							data-gr-m-letra
							aria-label="Color de la letra"
							class="h-10 w-10 shrink-0 cursor-pointer border border-line bg-panel p-1"
						/>
						Color de la letra
					</label>
					<div class="flex flex-col gap-1 text-xs text-muted">
						Fondo de la muestra
						<div class="flex flex-wrap gap-1">
							{
								ESCENARIOS.map((escenario) => (
									<button
										type="button"
										data-gr-m-fondo={escenario.id}
										aria-pressed="false"
										class="border border-line px-2 py-1 text-xs text-muted hover:text-fg aria-pressed:border-accent aria-pressed:text-accent"
									>
										{escenario.label}
									</button>
								))
							}
						</div>
					</div>
				</div>
				<div data-gr-escenario class="flex min-h-40 items-center justify-center overflow-hidden border border-line bg-panel p-6">
					<span data-gr-muestra="boton" class="inline-flex px-6 py-3 text-sm">
						<span data-gr-rotulo="Enviar idea">Enviar idea</span>
					</span>
					<article data-gr-muestra="tarjeta" hidden class="flex w-full max-w-xs flex-col border border-line bg-bg">
						<div data-gr-fondo class="h-24"></div>
						<div class="flex flex-col gap-1 p-4">
							<strong data-gr-rotulo="Tarjeta de prueba" class="font-pixel text-lg">Tarjeta de prueba</strong>
							<span class="text-sm text-muted">Así queda el gradiente de cabecera.</span>
						</div>
					</article>
					<p data-gr-muestra="texto" hidden data-gr-texto data-gr-rotulo="tuweb.dev" class="font-pixel text-center text-5xl leading-tight break-all">
						tuweb.dev
					</p>
				</div>
			</div>

			<div class="flex flex-col gap-2">
				<span class="text-sm text-muted">Exportar como</span>
				<div class="flex flex-wrap gap-2">
					{
						FORMATOS.map((formato) => (
							<button
								type="button"
								data-gr-formato={formato.id}
								aria-pressed={formato.id === 'css' ? 'true' : 'false'}
								class={`${OPCION} inline-flex items-center gap-2`}
							>
								<Icon name={formato.icon} class="size-4 shrink-0" />
								{formato.label}
							</button>
						))
					}
				</div>
				<pre data-gr-css class="max-h-72 overflow-auto border border-line bg-panel p-4 text-sm break-words whitespace-pre-wrap text-mark"></pre>
			</div>

			<div class="flex flex-wrap items-center gap-2">
				<button type="button" data-gr-copiar class={BOTON}>
					<span data-icon="copy" class="inline-flex"><Icon name="copy" class="size-4 shrink-0" /></span>
					<span data-icon="check" class="inline-flex"><Icon name="check" class="size-4 shrink-0" /></span>
					<span data-gr-copiar-texto aria-live="polite">Copiar</span>
				</button>
				<button type="button" data-gr-enlace class={BOTON}>
					<span data-icon="copy" class="inline-flex"><Icon name="link" class="size-4 shrink-0" /></span>
					<span data-icon="check" class="inline-flex"><Icon name="check" class="size-4 shrink-0" /></span>
					<span data-gr-enlace-texto aria-live="polite">Copiar enlace</span>
				</button>
				<button type="button" data-gr-bajar="css" class={BOTON}>
					<Icon name="file-type-css" class="size-4 shrink-0" />
					Descargar .css
				</button>
				<button type="button" data-gr-bajar="svg" class={BOTON}>
					<Icon name="file-type-svg" class="size-4 shrink-0" />
					Descargar .svg
				</button>
				<label class="inline-flex items-center gap-2 text-sm text-muted">
					<span class="sr-only">Tamaño del PNG</span>
					<select data-gr-tamano class={`${CAMPO} w-auto`}>
						{TAMANOS.map((tamano) => <option value={tamano.id}>{tamano.label}</option>)}
					</select>
				</label>
				<button type="button" data-gr-png class={BOTON}>
					<Icon name="download" class="size-4 shrink-0" />
					Descargar .png
				</button>
			</div>
		</div>
	</div>

	<GradientGallery />

	<template data-gr-plantilla>
		<div data-gr-fila class="flex items-center gap-2">
			<input
				type="color"
				data-gr-color
				aria-label="Color"
				class="h-10 w-10 shrink-0 cursor-pointer border border-line bg-panel p-1"
			/>
			<input
				type="text"
				data-gr-hex
				spellcheck="false"
				autocomplete="off"
				maxlength="7"
				aria-label="Color en hexadecimal"
				class="w-24 shrink-0 border border-line bg-panel px-2 py-2 text-sm outline-none focus-visible:border-accent"
			/>
			<input type="range" min="0" max="100" step="1" data-gr-pos aria-label="Posición" class="min-w-0 flex-1 accent-accent" />
			<span data-gr-pos-texto class="w-10 shrink-0 text-right text-xs text-muted"></span>
			<button
				type="button"
				data-gr-quitar
				aria-label="Quitar el color"
				class="shrink-0 border border-line p-2 text-muted hover:border-accent hover:text-accent disabled:opacity-40 disabled:hover:border-line disabled:hover:text-muted"
			>
				<Icon name="trash" class="size-4 shrink-0" />
			</button>
		</div>
	</template>
</div>

<style>
	[data-gr-color]::-webkit-color-swatch-wrapper {
		padding: 0;
	}
	[data-gr-color]::-webkit-color-swatch {
		border: none;
		border-radius: 0;
	}
	[data-gr-color]::-moz-color-swatch {
		border: none;
		border-radius: 0;
	}
	/* El check solo sale cuando la copia ha ido bien. */
	:is([data-gr-copiar], [data-gr-enlace]) [data-icon='check'] {
		display: none;
	}
	:is([data-gr-copiar], [data-gr-enlace])[data-state='done'] {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
	:is([data-gr-copiar], [data-gr-enlace])[data-state='done'] [data-icon='copy'] {
		display: none;
	}
	:is([data-gr-copiar], [data-gr-enlace])[data-state='done'] [data-icon='check'] {
		display: inline-flex;
	}
	:is([data-gr-copiar], [data-gr-enlace])[data-state='error'] {
		color: var(--color-heart);
	}
	/* Las guías de la vista previa solo salen al usarla. */
	[data-gr-guia] {
		opacity: 0;
		transition: opacity 0.15s;
	}
	[data-gr-vista]:is(:hover, :focus-visible, [data-arrastrando]) [data-gr-guia] {
		opacity: 1;
	}
	/* El texto de prueba se rellena con el gradiente. */
	[data-gr-texto] {
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
</style>

<script>
	type Parada = { color: string; pos: number };
	type Formato = 'css' | 'variable' | 'scss' | 'react' | 'tailwind' | 'svg';
	type Estado = {
		tipo: 'linear' | 'radial';
		angulo: number;
		forma: 'circle' | 'ellipse';
		// El centro del radial, en % del ancho y del alto.
		centroX: number;
		centroY: number;
		paradas: Parada[];
		tamano: string;
		formato: Formato;
		prueba: Prueba;
		// La muestra: texto (vacío es el de siempre), tamaño en %, color de letra
		// del botón y fondo sobre el que se ve.
		muestra: { texto: string; escala: number; letra: string; fondo: Escenario };
	};
	type Prueba = 'boton' | 'tarjeta' | 'texto';
	type Escenario = 'panel' | 'bg' | 'fg';

	const FORMATOS: Formato[] = ['css', 'variable', 'scss', 'react', 'tailwind', 'svg'];
	const PRUEBAS: Prueba[] = ['boton', 'tarjeta', 'texto'];
	const ESCENARIOS: Escenario[] = ['panel', 'bg', 'fg'];

	const CLAVE = 'tuweb:gradientes';
	const MAX_PARADAS = 8;
	const HEX = /^#[0-9a-f]{6}$/i;
	const INICIAL: Estado = {
		tipo: 'linear',
		angulo: 135,
		forma: 'circle',
		centroX: 50,
		centroY: 50,
		paradas: [
			{ color: '#c2410c', pos: 0 },
			{ color: '#f5c542', pos: 50 },
			{ color: '#2563eb', pos: 100 },
		],
		tamano: '1200x630',
		formato: 'css',
		prueba: 'boton',
		muestra: { texto: '', escala: 100, letra: '#ffffff', fondo: 'panel' },
	};

	const panel = document.querySelector<HTMLElement>('[data-panel="gradientes"]');
	const lista = panel?.querySelector<HTMLElement>('[data-gr-lista]');
	const plantilla = panel?.querySelector<HTMLTemplateElement>('[data-gr-plantilla]');
	const vista = panel?.querySelector<HTMLElement>('[data-gr-vista]');
	const vistaAyuda = panel?.querySelector<HTMLElement>('[data-gr-vista-ayuda]');
	const guiaLineal = panel?.querySelector<HTMLElement>('[data-gr-guia="lineal"]');
	const guiaRadial = panel?.querySelector<HTMLElement>('[data-gr-guia="radial"]');
	const barra = panel?.querySelector<HTMLElement>('[data-gr-barra]');
	const salida = panel?.querySelector<HTMLElement>('[data-gr-css]');
	const bloqueLineal = panel?.querySelector<HTMLElement>('[data-gr-lineal]');
	const bloqueRadial = panel?.querySelector<HTMLElement>('[data-gr-radial]');
	const angulo = panel?.querySelector<HTMLInputElement>('[data-gr-angulo]');
	const anguloNum = panel?.querySelector<HTMLInputElement>('[data-gr-angulo-num]');
	const tamano = panel?.querySelector<HTMLSelectElement>('[data-gr-tamano]');
	const copiar = panel?.querySelector<HTMLButtonElement>('[data-gr-copiar]');
	const copiarTexto = copiar?.querySelector<HTMLElement>('[data-gr-copiar-texto]');
	const tipos = panel?.querySelectorAll<HTMLButtonElement>('[data-gr-tipo]') ?? [];
	const formas = panel?.querySelectorAll<HTMLButtonElement>('[data-gr-forma]') ?? [];
	const formatos = panel?.querySelectorAll<HTMLButtonElement>('[data-gr-formato]') ?? [];
	const pruebas = panel?.querySelectorAll<HTMLButtonElement>('[data-gr-prueba]') ?? [];
	const muestras = panel?.querySelectorAll<HTMLElement>('[data-gr-muestra]') ?? [];
	const centros = panel?.querySelectorAll<HTMLInputElement>('[data-gr-centro]') ?? [];
	const centrosTexto = panel?.querySelectorAll<HTMLElement>('[data-gr-centro-texto]') ?? [];
	const pintables = panel?.querySelectorAll<HTMLElement>('[data-gr-muestra="boton"], [data-gr-fondo], [data-gr-texto]') ?? [];
	const escenario = panel?.querySelector<HTMLElement>('[data-gr-escenario]');
	const rotulos = panel?.querySelectorAll<HTMLElement>('[data-gr-rotulo]') ?? [];
	const mTexto = panel?.querySelector<HTMLInputElement>('[data-gr-m-texto]');
	const mEscala = panel?.querySelector<HTMLInputElement>('[data-gr-m-escala]');
	const mEscalaTexto = panel?.querySelector<HTMLElement>('[data-gr-m-escala-texto]');
	const mLetra = panel?.querySelector<HTMLInputElement>('[data-gr-m-letra]');
	const mFondos = panel?.querySelectorAll<HTMLButtonElement>('[data-gr-m-fondo]') ?? [];

	const limitar = (v: number, min: number, max: number) => Math.min(Math.max(Math.round(v), min), max);

	function cargar(): Estado {
		try {
			const guardado = JSON.parse(localStorage.getItem(CLAVE) ?? 'null');
			if (guardado && Array.isArray(guardado.paradas) && guardado.paradas.length >= 2) {
				const num = (v: unknown, d: number) => (typeof v === 'number' && Number.isFinite(v) ? v : d);
				return {
					tipo: guardado.tipo === 'radial' ? 'radial' : 'linear',
					angulo: limitar(num(guardado.angulo, INICIAL.angulo), 0, 360),
					forma: guardado.forma === 'ellipse' ? 'ellipse' : 'circle',
					centroX: limitar(num(guardado.centroX, 50), 0, 100),
					centroY: limitar(num(guardado.centroY, 50), 0, 100),
					paradas: guardado.paradas.slice(0, MAX_PARADAS).map((p: Partial<Parada>) => ({
						color: HEX.test(String(p.color)) ? String(p.color).toLowerCase() : '#000000',
						pos: limitar(num(p.pos, 0), 0, 100),
					})),
					tamano: typeof guardado.tamano === 'string' ? guardado.tamano : INICIAL.tamano,
					formato: FORMATOS.includes(guardado.formato) ? guardado.formato : INICIAL.formato,
					prueba: PRUEBAS.includes(guardado.prueba) ? guardado.prueba : INICIAL.prueba,
					muestra: {
						texto: typeof guardado.muestra?.texto === 'string' ? guardado.muestra.texto.slice(0, 40) : '',
						escala: limitar(num(guardado.muestra?.escala, 100), 50, 200),
						letra: HEX.test(String(guardado.muestra?.letra)) ? String(guardado.muestra.letra).toLowerCase() : INICIAL.muestra.letra,
						fondo: ESCENARIOS.includes(guardado.muestra?.fondo) ? guardado.muestra.fondo : INICIAL.muestra.fondo,
					},
				};
			}
		} catch {
			// Si lo guardado está roto, se empieza de cero.
		}
		return structuredClone(INICIAL);
	}

	// ——— El código para compartir ———
	// l135-c2410c.0-2563eb.100 es lineal a 135deg; rc-… y re-… son radiales en
	// círculo o elipse, con @x.y si el centro no está en medio. Lo que no encaje
	// se ignora sin tocar nada.
	const CODIGO = /^(?:l(\d{1,3})|r([ce])(?:@(\d{1,3})\.(\d{1,3}))?)((?:-[0-9a-f]{6}\.\d{1,3}){2,8})$/i;

	function leer(texto: string, base: Estado): Estado | null {
		const m = texto.trim().match(CODIGO);
		if (!m) return null;
		const radial = m[1] === undefined;
		const paradas = m[5]
			.slice(1)
			.split('-')
			.map((trozo) => {
				const [hex, pos] = trozo.split('.');
				return { color: `#${hex.toLowerCase()}`, pos: limitar(Number(pos), 0, 100) };
			});
		return {
			...base,
			tipo: radial ? 'radial' : 'linear',
			angulo: radial ? base.angulo : limitar(Number(m[1]), 0, 360),
			forma: m[2]?.toLowerCase() === 'e' ? 'ellipse' : m[2] ? 'circle' : base.forma,
			// Un radial sin @ va en medio; uno lineal deja el centro como estaba.
			centroX: radial ? limitar(Number(m[3] ?? 50), 0, 100) : base.centroX,
			centroY: radial ? limitar(Number(m[4] ?? 50), 0, 100) : base.centroY,
			paradas,
		};
	}

	const enMedio = () => estado.centroX === 50 && estado.centroY === 50;

	function codigo() {
		const centro = enMedio() ? '' : `@${estado.centroX}.${estado.centroY}`;
		const cabeza = estado.tipo === 'linear' ? `l${estado.angulo}` : `r${estado.forma === 'ellipse' ? 'e' : 'c'}${centro}`;
		return cabeza + ordenadas().map((p) => `-${p.color.slice(1)}.${p.pos}`).join('');
	}

	let estado = cargar();

	function guardar() {
		try {
			localStorage.setItem(CLAVE, JSON.stringify(estado));
		} catch {
			// Sin almacenamiento (modo privado, cuota): la herramienta sigue igual.
		}
	}

	// Un enlace compartido manda sobre lo guardado. Luego se quita de la URL
	// para que recargar no deshaga lo que hayas cambiado encima.
	const compartido = new URLSearchParams(location.search).get('gradiente');
	if (compartido !== null) {
		const desdeEnlace = leer(compartido, estado);
		if (desdeEnlace) {
			estado = desdeEnlace;
			guardar();
		}
		history.replaceState(null, '', `${location.pathname}${location.hash}`);
	}

	// Ordenadas por posición: el CSS y el canvas las leen así, y si no se
	// ordenan, una parada «atrasada» se pega a la anterior y no se ve.
	const ordenadas = () => [...estado.paradas].sort((a, b) => a.pos - b.pos);

	const paradasCss = () =>
		ordenadas()
			.map((p) => `${p.color} ${p.pos}%`)
			.join(', ');

	function gradiente() {
		const paradas = paradasCss();
		return estado.tipo === 'linear'
			? `linear-gradient(${estado.angulo}deg, ${paradas})`
			: `radial-gradient(${estado.forma}${enMedio() ? '' : ` at ${estado.centroX}% ${estado.centroY}%`}, ${paradas})`;
	}

	function medidas() {
		const [ancho, alto] = (estado.tamano.match(/^(\d+)x(\d+)$/)?.slice(1) ?? ['1200', '630']).map(Number);
		return { ancho, alto };
	}

	// ——— Exportar ———
	// Cada formato sale del mismo gradiente. El CSS lleva delante el primer color
	// como fondo liso, por si el navegador no entiende el gradiente.
	function svg() {
		const { ancho, alto } = medidas();
		const paradas = ordenadas()
			.map((p) => `    <stop offset="${p.pos}%" stop-color="${p.color}"/>`)
			.join('\n');
		const g = geometria();
		const r = (n: number) => Math.round(n * 100) / 100;
		const abre =
			g.tipo === 'lineal'
				? `<linearGradient id="g" gradientUnits="userSpaceOnUse" x1="${r(g.x1)}" y1="${r(g.y1)}" x2="${r(g.x2)}" y2="${r(g.y2)}">`
				: `<radialGradient id="g" gradientUnits="userSpaceOnUse" cx="${r(g.cx)}" cy="${r(g.cy)}" r="${r(g.rx)}"${
						g.rx === g.ry ? '' : ` gradientTransform="translate(${r(g.cx)} ${r(g.cy)}) scale(1 ${r(g.ry / g.rx)}) translate(${r(-g.cx)} ${r(-g.cy)})"`
					}>`;
		const cierra = g.tipo === 'lineal' ? '</linearGradient>' : '</radialGradient>';
		return [
			`<svg xmlns="http://www.w3.org/2000/svg" width="${ancho}" height="${alto}" viewBox="0 0 ${ancho} ${alto}">`,
			'  <defs>',
			`  ${abre}`,
			paradas,
			`  ${cierra}`,
			'  </defs>',
			`  <rect width="${ancho}" height="${alto}" fill="url(#g)"/>`,
			'</svg>',
		].join('\n');
	}

	function exportar(formato: Formato) {
		const css = gradiente();
		const liso = ordenadas()[0]?.color ?? '#000000';
		if (formato === 'variable') {
			return `:root {\n  --gradiente: ${css};\n}\n\n.fondo {\n  background: ${liso};\n  background: var(--gradiente);\n}`;
		}
		if (formato === 'scss') {
			return `$gradiente: ${css};\n\n@mixin fondo-gradiente {\n  background: ${liso};\n  background: $gradiente;\n}\n\n.fondo {\n  @include fondo-gradiente;\n}`;
		}
		// En JSX el estilo es un objeto y el valor va entre comillas.
		if (formato === 'react') {
			const estilo =
				estado.prueba === 'texto'
					? `  backgroundImage: '${css}',\n  WebkitBackgroundClip: 'text',\n  backgroundClip: 'text',\n  color: 'transparent',`
					: `  background: '${css}',`;
			return `const gradiente = {\n${estilo}\n};\n\n<div style={gradiente} />`;
		}
		// En los valores arbitrarios de Tailwind el espacio se escribe con _.
		if (formato === 'tailwind') return `bg-[${css.replace(/,\s+/g, ',').replace(/\s+/g, '_')}]`;
		if (formato === 'svg') return svg();
		// Probando sobre texto, el CSS ya lleva lo que hace falta para rellenar letras.
		if (estado.prueba === 'texto') {
			return `background: ${css};\n-webkit-background-clip: text;\nbackground-clip: text;\ncolor: transparent;`;
		}
		return `background: ${liso};\nbackground: ${css};`;
	}

	function pintar() {
		const css = gradiente();
		// backgroundImage y no background: el atajo pisaría el background-clip del texto.
		pintables.forEach((el) => {
			el.style.backgroundImage = css;
		});
		if (vista) {
			vista.style.background = css;
			const { ancho, alto } = medidas();
			vista.style.aspectRatio = `${ancho} / ${alto}`;
		}
		if (salida) salida.textContent = exportar(estado.formato);
		// La galería lee de aquí qué gradiente hay en pantalla.
		if (panel) panel.dataset.grCodigo = codigo();
		pintarBarra();
		pintarGuias();
	}

	// La flecha marca hacia dónde va el lineal; el punto, el centro del radial.
	function pintarGuias() {
		if (guiaLineal) {
			guiaLineal.hidden = estado.tipo !== 'linear';
			guiaLineal.style.rotate = `${estado.angulo}deg`;
		}
		if (guiaRadial) {
			guiaRadial.hidden = estado.tipo !== 'radial';
			guiaRadial.style.left = `${estado.centroX}%`;
			guiaRadial.style.top = `${estado.centroY}%`;
		}
	}

	// ——— La barra de paradas ———
	// Siempre de izquierda a derecha, sea cual sea el tipo: es el mapa de colores.
	// Las marcas se rehacen en cada pintado; el arrastre lo captura la barra, así
	// que rehacerlas no lo corta.
	function pintarBarra() {
		if (!barra) return;
		barra.style.backgroundImage = `linear-gradient(90deg, ${paradasCss()})`;
		barra.replaceChildren(
			...estado.paradas.map((p, i) => {
				const marca = document.createElement('span');
				marca.dataset.grMarca = String(i);
				marca.className = 'absolute -top-1.5 -bottom-1.5 w-3 -translate-x-1/2 cursor-ew-resize border-2 border-bg outline outline-1 outline-fg';
				marca.style.left = `${p.pos}%`;
				marca.style.background = p.color;
				return marca;
			}),
		);
	}

	// El color que ya hay en una posición, para que añadir no cambie lo que se ve.
	function colorEn(pos: number) {
		const orden = ordenadas();
		const despues = orden.findIndex((p) => p.pos >= pos);
		if (despues === -1) return orden[orden.length - 1].color;
		if (despues === 0) return orden[0].color;
		const a = orden[despues - 1];
		const b = orden[despues];
		return mezclar(a.color, b.color, b.pos === a.pos ? 0 : (pos - a.pos) / (b.pos - a.pos));
	}

	let arrastrada: Parada | null = null;

	function posEn(e: PointerEvent) {
		const caja = barra!.getBoundingClientRect();
		return limitar(((e.clientX - caja.left) / caja.width) * 100, 0, 100);
	}

	// Mover una marca solo cambia su fila; rehacer toda la lista en cada
	// movimiento sobra.
	function moverFila(parada: Parada) {
		const fila = lista?.children[estado.paradas.indexOf(parada)];
		const pos = fila?.querySelector<HTMLInputElement>('[data-gr-pos]');
		const texto = fila?.querySelector<HTMLElement>('[data-gr-pos-texto]');
		if (pos) pos.value = String(parada.pos);
		if (texto) texto.textContent = `${parada.pos}%`;
	}

	barra?.addEventListener('pointerdown', (e) => {
		if (e.button !== 0) return;
		const marca = (e.target as HTMLElement).closest<HTMLElement>('[data-gr-marca]');
		if (marca) {
			arrastrada = estado.paradas[Number(marca.dataset.grMarca)] ?? null;
		} else if (estado.paradas.length < MAX_PARADAS) {
			const pos = posEn(e);
			arrastrada = { color: colorEn(pos), pos };
			estado.paradas.push(arrastrada);
			pintarFilas();
			actualizar();
		}
		if (!arrastrada) return;
		e.preventDefault();
		barra.setPointerCapture(e.pointerId);
	});

	barra?.addEventListener('pointermove', (e) => {
		if (!arrastrada) return;
		const pos = posEn(e);
		if (pos === arrastrada.pos) return;
		arrastrada.pos = pos;
		moverFila(arrastrada);
		actualizar();
	});

	const soltar = () => {
		arrastrada = null;
	};
	barra?.addEventListener('pointerup', soltar);
	barra?.addEventListener('pointercancel', soltar);

	function bajar(contenido: Blob, nombre: string) {
		const url = URL.createObjectURL(contenido);
		const enlace = document.createElement('a');
		enlace.href = url;
		enlace.download = nombre;
		enlace.click();
		// Soltar la URL en el mismo tick corta la descarga en algún navegador.
		setTimeout(() => URL.revokeObjectURL(url), 1000);
	}

	const nombre = () => `gradiente-${estado.tipo === 'linear' ? 'lineal' : 'radial'}`;

	panel?.querySelectorAll<HTMLButtonElement>('[data-gr-bajar]').forEach((boton) => {
		boton.addEventListener('click', () => {
			if (boton.dataset.grBajar === 'svg') {
				bajar(new Blob([svg()], { type: 'image/svg+xml' }), `${nombre()}-${estado.tamano}.svg`);
			} else {
				bajar(new Blob([`${exportar('variable')}\n`], { type: 'text/css' }), `${nombre()}.css`);
			}
		});
	});

	function actualizar() {
		pintar();
		guardar();
	}

	function pintarControles() {
		tipos.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.grTipo === estado.tipo)));
		formas.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.grForma === estado.forma)));
		formatos.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.grFormato === estado.formato)));
		pruebas.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.grPrueba === estado.prueba)));
		muestras.forEach((m) => {
			m.hidden = m.dataset.grMuestra !== estado.prueba;
		});
		if (bloqueLineal) bloqueLineal.hidden = estado.tipo !== 'linear';
		if (bloqueRadial) bloqueRadial.hidden = estado.tipo !== 'radial';
		if (angulo) angulo.value = String(estado.angulo);
		if (anguloNum) anguloNum.value = String(estado.angulo);
		pintarCentro();
		pintarMuestra();
		// La vista previa se arrastra, así que en el móvil no hace scroll.
		if (vista) {
			vista.style.cursor = estado.tipo === 'radial' ? 'crosshair' : 'grab';
			vista.style.touchAction = 'none';
		}
		if (vistaAyuda) {
			vistaAyuda.textContent =
				estado.tipo === 'radial'
					? 'Pulsa o arrastra en la vista previa para mover el centro. Con el teclado, flechas (Mayús para ir de 10 en 10).'
					: 'Arrastra en la vista previa para girar el ángulo hacia donde apuntes. Con el teclado, flechas (Mayús para ir de 15 en 15).';
		}
		if (tamano) {
			if (![...tamano.options].some((o) => o.value === estado.tamano)) estado.tamano = INICIAL.tamano;
			tamano.value = estado.tamano;
		}
	}

	function pintarFilas() {
		if (!lista || !plantilla) return;
		lista.replaceChildren();
		estado.paradas.forEach((parada, i) => {
			const fila = plantilla.content.firstElementChild?.cloneNode(true) as HTMLElement;
			const color = fila.querySelector<HTMLInputElement>('[data-gr-color]')!;
			const hex = fila.querySelector<HTMLInputElement>('[data-gr-hex]')!;
			const pos = fila.querySelector<HTMLInputElement>('[data-gr-pos]')!;
			const posTexto = fila.querySelector<HTMLElement>('[data-gr-pos-texto]')!;
			const quitar = fila.querySelector<HTMLButtonElement>('[data-gr-quitar]')!;

			color.value = parada.color;
			hex.value = parada.color;
			pos.value = String(parada.pos);
			posTexto.textContent = `${parada.pos}%`;
			// Un gradiente con un solo color no es un gradiente.
			quitar.disabled = estado.paradas.length <= 2;

			color.addEventListener('input', () => {
				parada.color = color.value.toLowerCase();
				hex.value = parada.color;
				actualizar();
			});
			hex.addEventListener('input', () => {
				let valor = hex.value.trim();
				if (!valor.startsWith('#')) valor = `#${valor}`;
				// #abc vale como #aabbcc, igual que en CSS.
				if (/^#[0-9a-f]{3}$/i.test(valor)) valor = `#${[...valor.slice(1)].map((c) => c + c).join('')}`;
				if (!HEX.test(valor)) return;
				parada.color = valor.toLowerCase();
				color.value = parada.color;
				actualizar();
			});
			hex.addEventListener('blur', () => {
				hex.value = parada.color;
			});
			pos.addEventListener('input', () => {
				parada.pos = limitar(Number(pos.value), 0, 100);
				posTexto.textContent = `${parada.pos}%`;
				actualizar();
			});
			quitar.addEventListener('click', () => {
				if (estado.paradas.length <= 2) return;
				estado.paradas.splice(i, 1);
				pintarFilas();
				actualizar();
			});
			lista.append(fila);
		});
		const nuevo = panel?.querySelector<HTMLButtonElement>('[data-gr-nuevo]');
		if (nuevo) nuevo.disabled = estado.paradas.length >= MAX_PARADAS;
	}

	// t es cuánto de b: 0 es a, 1 es b, 0.5 el de en medio.
	function mezclar(a: string, b: string, t = 0.5) {
		const canal = (hex: string, k: number) => parseInt(hex.slice(1 + k * 2, 3 + k * 2), 16);
		return `#${[0, 1, 2]
			.map((k) => Math.round(canal(a, k) + (canal(b, k) - canal(a, k)) * t).toString(16).padStart(2, '0'))
			.join('')}`;
	}

	function anadir() {
		if (estado.paradas.length >= MAX_PARADAS) return;
		// El nuevo va en el hueco más grande, con el color de en medio.
		const orden = ordenadas();
		let mejor = 0;
		for (let i = 1; i < orden.length - 1; i++) {
			if (orden[i + 1].pos - orden[i].pos > orden[mejor + 1].pos - orden[mejor].pos) mejor = i;
		}
		const a = orden[mejor];
		const b = orden[mejor + 1] ?? a;
		estado.paradas.push({ color: mezclar(a.color, b.color), pos: Math.round((a.pos + b.pos) / 2) });
		pintarFilas();
		actualizar();
	}

	function repartir() {
		const n = estado.paradas.length;
		ordenadas().forEach((p, i) => {
			p.pos = Math.round((i / (n - 1)) * 100);
		});
		pintarFilas();
		actualizar();
	}

	function hsl(h: number, s: number, l: number) {
		const f = (n: number) => {
			const k = (n + h / 30) % 12;
			const v = l - s * Math.min(l, 1 - l) * Math.max(-1, Math.min(k - 3, 9 - k, 1));
			return Math.round(v * 255).toString(16).padStart(2, '0');
		};
		return `#${f(0)}${f(8)}${f(4)}`;
	}

	function alAzar() {
		// Tonos repartidos alrededor de uno al azar: suelen casar mejor que tres sueltos.
		const base = Math.random() * 360;
		const salto = 30 + Math.random() * 90;
		const n = estado.paradas.length;
		estado.paradas = Array.from({ length: n }, (_, i) => ({
			color: hsl((base + salto * i) % 360, 0.6 + Math.random() * 0.3, 0.45 + Math.random() * 0.2),
			pos: Math.round((i / (n - 1)) * 100),
		}));
		if (estado.tipo === 'linear') estado.angulo = Math.round(Math.random() * 8) * 45;
		pintarControles();
		pintarFilas();
		actualizar();
	}

	// ——— El PNG ———
	// La misma geometría que usa el navegador para el CSS. Lineal: la línea del
	// gradiente pasa por el centro con el ángulo dado (0deg es hacia arriba y gira
	// como el reloj) y mide lo justo para que las esquinas caigan en el 0% y el
	// 100%. Radial: desde su centro hasta la esquina más lejana, que es lo que
	// hace CSS cuando no se le dice tamaño.
	// El SVG usa las mismas cuentas, así que salen de aquí.
	function geometria() {
		const { ancho, alto } = medidas();
		const cx = ancho / 2;
		const cy = alto / 2;
		if (estado.tipo === 'linear') {
			const rad = (estado.angulo * Math.PI) / 180;
			const dx = Math.sin(rad);
			const dy = -Math.cos(rad);
			const medio = (Math.abs(ancho * dx) + Math.abs(alto * dy)) / 2;
			return {
				tipo: 'lineal' as const,
				x1: cx - dx * medio,
				y1: cy - dy * medio,
				x2: cx + dx * medio,
				y2: cy + dy * medio,
			};
		}
		// La elipse guarda la proporción de los lados más lejanos y toca la
		// esquina más lejana: esas distancias por raíz de dos.
		const px = (ancho * estado.centroX) / 100;
		const py = (alto * estado.centroY) / 100;
		const lejosX = Math.max(px, ancho - px);
		const lejosY = Math.max(py, alto - py);
		const circulo = estado.forma === 'circle';
		const rx = circulo ? Math.hypot(lejosX, lejosY) : lejosX * Math.SQRT2;
		const ry = circulo ? rx : lejosY * Math.SQRT2;
		return { tipo: 'radial' as const, cx: px, cy: py, rx, ry };
	}

	function lienzo() {
		const { ancho, alto } = medidas();
		const canvas = document.createElement('canvas');
		canvas.width = ancho;
		canvas.height = alto;
		const ctx = canvas.getContext('2d');
		if (!ctx) return null;
		const poner = (g: CanvasGradient) => ordenadas().forEach((p) => g.addColorStop(p.pos / 100, p.color));
		const geo = geometria();

		if (geo.tipo === 'lineal') {
			const g = ctx.createLinearGradient(geo.x1, geo.y1, geo.x2, geo.y2);
			poner(g);
			ctx.fillStyle = g;
			ctx.fillRect(0, 0, ancho, alto);
		} else if (geo.rx === geo.ry) {
			const g = ctx.createRadialGradient(geo.cx, geo.cy, 0, geo.cx, geo.cy, geo.rx);
			poner(g);
			ctx.fillStyle = g;
			ctx.fillRect(0, 0, ancho, alto);
		} else {
			// Se pinta un círculo aplastado.
			const { cx, cy, rx, ry } = geo;
			const g = ctx.createRadialGradient(0, 0, 0, 0, 0, rx);
			poner(g);
			ctx.translate(cx, cy);
			ctx.scale(1, ry / rx);
			ctx.fillStyle = g;
			ctx.fillRect(-cx, (-cy * rx) / ry, ancho, (alto * rx) / ry);
		}
		return canvas;
	}

	panel?.querySelector('[data-gr-png]')?.addEventListener('click', () => {
		const canvas = lienzo();
		if (!canvas) return;
		canvas.toBlob((blob) => {
			if (blob) bajar(blob, `${nombre()}-${estado.tamano}.png`);
		}, 'image/png');
	});

	const relojes = new Map<HTMLElement, number>();

	async function copiarCon(boton: HTMLButtonElement, etiqueta: HTMLElement | null | undefined, reposo: string, texto: string) {
		let hecho = false;
		try {
			await navigator.clipboard.writeText(texto);
			hecho = true;
		} catch {
			// Sin portapapeles o sin permiso: el CSS sigue ahí para seleccionarlo.
		}
		boton.dataset.state = hecho ? 'done' : 'error';
		if (etiqueta) etiqueta.textContent = hecho ? 'Copiado' : 'No se pudo copiar';
		clearTimeout(relojes.get(boton));
		relojes.set(
			boton,
			window.setTimeout(() => {
				boton.removeAttribute('data-state');
				if (etiqueta) etiqueta.textContent = reposo;
			}, 2000),
		);
	}

	copiar?.addEventListener('click', () => copiarCon(copiar, copiarTexto, 'Copiar', salida?.textContent ?? ''));

	const enlace = panel?.querySelector<HTMLButtonElement>('[data-gr-enlace]');
	const enlaceTexto = enlace?.querySelector<HTMLElement>('[data-gr-enlace-texto]');
	enlace?.addEventListener('click', () =>
		copiarCon(enlace, enlaceTexto, 'Copiar enlace', `${location.origin}${location.pathname}?gradiente=${codigo()}#gradientes`),
	);

	function cargarCodigo(texto: string) {
		const elegido = leer(texto, estado);
		if (!elegido) return;
		estado = elegido;
		pintarControles();
		pintarFilas();
		actualizar();
	}

	panel?.querySelectorAll<HTMLButtonElement>('[data-gr-ejemplo]').forEach((boton) => {
		boton.addEventListener('click', () => cargarCodigo(boton.dataset.grEjemplo ?? ''));
	});

	// La galería pide abrir un diseño en el editor.
	panel?.addEventListener('gr:cargar', (e) => {
		const detalle = (e as CustomEvent<unknown>).detail;
		if (typeof detalle === 'string') cargarCodigo(detalle);
	});

	function ponerAngulo(valor: number) {
		if (!Number.isFinite(valor)) return;
		estado.angulo = limitar(valor, 0, 360);
		if (angulo) angulo.value = String(estado.angulo);
		if (anguloNum && document.activeElement !== anguloNum) anguloNum.value = String(estado.angulo);
		actualizar();
	}

	angulo?.addEventListener('input', () => ponerAngulo(Number(angulo.value)));
	anguloNum?.addEventListener('input', () => {
		if (anguloNum.value.trim() !== '') ponerAngulo(Number(anguloNum.value));
	});
	anguloNum?.addEventListener('blur', () => {
		anguloNum.value = String(estado.angulo);
	});
	panel?.querySelectorAll<HTMLButtonElement>('[data-gr-angulo-rapido]').forEach((boton) => {
		boton.addEventListener('click', () => {
			ponerAngulo(Number(boton.dataset.grAnguloRapido));
			if (anguloNum) anguloNum.value = String(estado.angulo);
		});
	});

	// ——— El centro del radial ———
	const centroDe = (eje: string | undefined) => (eje === 'y' ? estado.centroY : estado.centroX);

	function pintarCentro() {
		centros.forEach((c) => {
			c.value = String(centroDe(c.dataset.grCentro));
		});
		centrosTexto.forEach((t) => {
			t.textContent = `${centroDe(t.dataset.grCentroTexto)}%`;
		});
	}

	function ponerCentro(x: number, y: number) {
		estado.centroX = limitar(x, 0, 100);
		estado.centroY = limitar(y, 0, 100);
		pintarCentro();
		actualizar();
	}

	centros.forEach((campo) => {
		campo.addEventListener('input', () => {
			const valor = Number(campo.value);
			if (campo.dataset.grCentro === 'y') ponerCentro(estado.centroX, valor);
			else ponerCentro(valor, estado.centroY);
		});
	});

	panel?.querySelector('[data-gr-centrar]')?.addEventListener('click', () => ponerCentro(50, 50));

	// Pulsar (o arrastrar) sobre la vista previa: en radial mueve el centro; en
	// lineal gira el ángulo hacia el puntero, con 0deg arriba como en CSS.
	let moviendoCentro = false;

	function centroEn(e: PointerEvent) {
		const caja = vista!.getBoundingClientRect();
		ponerCentro(((e.clientX - caja.left) / caja.width) * 100, ((e.clientY - caja.top) / caja.height) * 100);
	}

	function anguloEn(e: PointerEvent) {
		const caja = vista!.getBoundingClientRect();
		const dx = e.clientX - (caja.left + caja.width / 2);
		const dy = e.clientY - (caja.top + caja.height / 2);
		if (dx === 0 && dy === 0) return;
		const grados = ((Math.atan2(dx, -dy) * 180) / Math.PI + 360) % 360;
		// Con Mayús salta de 15 en 15.
		const paso = e.shiftKey ? 15 : 1;
		ponerAngulo((Math.round(grados / paso) * paso) % 360);
		if (anguloNum) anguloNum.value = String(estado.angulo);
	}

	const usarVista = (e: PointerEvent) => (estado.tipo === 'radial' ? centroEn(e) : anguloEn(e));

	vista?.addEventListener('pointerdown', (e) => {
		if (e.button !== 0) return;
		moviendoCentro = true;
		vista.dataset.arrastrando = '';
		vista.style.cursor = estado.tipo === 'radial' ? 'crosshair' : 'grabbing';
		e.preventDefault();
		vista.focus({ preventScroll: true });
		vista.setPointerCapture(e.pointerId);
		usarVista(e);
	});
	vista?.addEventListener('pointermove', (e) => {
		if (moviendoCentro) usarVista(e);
	});
	const soltarCentro = () => {
		moviendoCentro = false;
		if (!vista) return;
		delete vista.dataset.arrastrando;
		vista.style.cursor = estado.tipo === 'radial' ? 'crosshair' : 'grab';
	};

	// Con el teclado: flechas para girar o para mover el centro.
	const FLECHAS: Record<string, [number, number]> = {
		ArrowLeft: [-1, 0],
		ArrowRight: [1, 0],
		ArrowUp: [0, -1],
		ArrowDown: [0, 1],
	};
	vista?.addEventListener('keydown', (e) => {
		const flecha = FLECHAS[e.key];
		if (!flecha) return;
		e.preventDefault();
		const [x, y] = flecha;
		if (estado.tipo === 'radial') {
			const paso = e.shiftKey ? 10 : 1;
			ponerCentro(estado.centroX + x * paso, estado.centroY + y * paso);
			return;
		}
		// Derecha y arriba giran como el reloj; izquierda y abajo, al revés.
		const paso = (x || -y) * (e.shiftKey ? 15 : 1);
		ponerAngulo((((estado.angulo + paso) % 360) + 360) % 360);
		if (anguloNum) anguloNum.value = String(estado.angulo);
	});
	vista?.addEventListener('pointerup', soltarCentro);
	vista?.addEventListener('pointercancel', soltarCentro);

	tipos.forEach((boton) => {
		boton.addEventListener('click', () => {
			estado.tipo = boton.dataset.grTipo === 'radial' ? 'radial' : 'linear';
			pintarControles();
			actualizar();
		});
	});

	formas.forEach((boton) => {
		boton.addEventListener('click', () => {
			estado.forma = boton.dataset.grForma === 'ellipse' ? 'ellipse' : 'circle';
			pintarControles();
			actualizar();
		});
	});

	formatos.forEach((boton) => {
		boton.addEventListener('click', () => {
			const elegido = FORMATOS.find((f) => f === boton.dataset.grFormato);
			if (!elegido) return;
			estado.formato = elegido;
			pintarControles();
			actualizar();
		});
	});

	pruebas.forEach((boton) => {
		boton.addEventListener('click', () => {
			const elegida = PRUEBAS.find((p) => p === boton.dataset.grPrueba);
			if (!elegida) return;
			estado.prueba = elegida;
			pintarControles();
			actualizar();
		});
	});

	// ——— La muestra ———
	// Cada elemento tiene su texto de siempre; si escribes uno, vale para todos.
	function pintarMuestra() {
		const { texto, escala, letra, fondo } = estado.muestra;
		rotulos.forEach((r) => {
			r.textContent = texto.trim() || (r.dataset.grRotulo ?? '');
		});
		muestras.forEach((m) => m.style.setProperty('zoom', String(escala / 100)));
		const boton = panel?.querySelector<HTMLElement>('[data-gr-muestra="boton"]');
		if (boton) boton.style.color = letra;
		if (escenario) escenario.style.background = `var(--color-${fondo})`;
		if (mTexto && document.activeElement !== mTexto) mTexto.value = texto;
		if (mEscala) mEscala.value = String(escala);
		if (mEscalaTexto) mEscalaTexto.textContent = `${escala}%`;
		if (mLetra) mLetra.value = letra;
		mFondos.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.grMFondo === fondo)));
	}

	function cambiarMuestra(cambio: Partial<Estado['muestra']>) {
		estado.muestra = { ...estado.muestra, ...cambio };
		pintarMuestra();
		guardar();
	}

	mTexto?.addEventListener('input', () => cambiarMuestra({ texto: mTexto.value.slice(0, 40) }));
	mEscala?.addEventListener('input', () => cambiarMuestra({ escala: limitar(Number(mEscala.value), 50, 200) }));
	mLetra?.addEventListener('input', () => cambiarMuestra({ letra: mLetra.value.toLowerCase() }));
	mFondos.forEach((boton) => {
		boton.addEventListener('click', () => {
			const elegido = ESCENARIOS.find((f) => f === boton.dataset.grMFondo);
			if (elegido) cambiarMuestra({ fondo: elegido });
		});
	});

	tamano?.addEventListener('change', () => {
		estado.tamano = tamano.value;
		actualizar();
	});

	panel?.querySelector('[data-gr-nuevo]')?.addEventListener('click', anadir);
	panel?.querySelector('[data-gr-repartir]')?.addEventListener('click', repartir);
	panel?.querySelector('[data-gr-azar]')?.addEventListener('click', alAzar);
	panel?.querySelector('[data-gr-reset]')?.addEventListener('click', () => {
		estado = structuredClone(INICIAL);
		pintarControles();
		pintarFilas();
		actualizar();
	});

	pintarControles();
	pintarFilas();
	pintar();
</script>
