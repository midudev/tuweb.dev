---
/**
 * Un canal de chat a la vieja usanza, con pinta de IRC. Los mensajes pasan por
 * el servidor y se guardan un día: la página pregunta cada pocos segundos por
 * lo nuevo. Leer es libre; para escribir hay que entrar con GitHub y el nick es
 * el de GitHub, que el servidor impone.
 */
import Icon from './Icon.astro';

interface Props {
	login: string | null;
	version: number;
}

const { login, version } = Astro.props;
---

<section id="chat" class="flex flex-col gap-7" data-nick={login} data-version={version}>
	<div class="flex flex-col border border-line bg-panel">
		<div
			class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-line px-4 py-3"
		>
			<span class="flex items-center gap-1 font-pixel text-accent">
				<Icon name="hash" class="size-4 shrink-0" />
				tuweb
			</span>
			<span class="text-xs text-muted">
				tema: esta web la cambias tú · v{version} · las ideas se proponen en la portada
			</span>
		</div>

		<div class="flex flex-col md:flex-row">
			<div
				data-log
				role="log"
				aria-live="polite"
				aria-label="Mensajes del canal"
				class="flex h-80 min-w-0 grow flex-col gap-1 overflow-y-auto px-4 py-3 text-sm"
			>
			</div>

			<ul
				data-users
				aria-label="Quién hay en el canal"
				class="flex shrink-0 flex-wrap gap-x-4 gap-y-1 border-t border-line px-4 py-3 text-sm md:w-44 md:flex-col md:border-t-0 md:border-l"
			>
			</ul>
		</div>

		<form data-form hidden={!login} class="flex items-center gap-3 border-t border-line px-4 py-3">
			<span data-nick-label aria-hidden="true" class="shrink-0 text-sm text-mark">&lt;{login ?? 'tú'}&gt;</span>
			<input
				id="chat-input"
				data-input
				type="text"
				maxlength="400"
				autocomplete="off"
				spellcheck="false"
				aria-label="Mensaje para el canal #tuweb"
				placeholder="Escribe y pulsa enter"
				class="min-w-0 grow bg-transparent text-sm"
			/>
			<button
				type="submit"
				class="inline-flex shrink-0 items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent"
			>
				<Icon name="send" class="size-4 shrink-0" />
				Enviar
			</button>
		</form>

		<p
			data-entrar
			hidden={Boolean(login)}
			class="flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-line px-4 py-3 text-sm text-muted"
		>
			Leer es libre; para escribir, entra con GitHub y tu nick será el tuyo.
			<a href="/api/auth/github" class="inline-flex items-center gap-2 text-accent hover:underline">
				<Icon name="brand-github" class="size-4 shrink-0" />
				Entrar con GitHub
			</a>
		</p>
	</div>
</section>

<style is:global>
	/*
	 * El color del nick sale de su nombre, siempre de la paleta de la casa. Va
	 * global porque estas líneas las pinta el script y no llevan la marca del
	 * componente; por eso todas cuelgan de #chat.
	 */
	#chat [data-c='0'] {
		color: var(--color-accent);
	}
	#chat [data-c='1'] {
		color: var(--color-mark);
	}
	#chat [data-c='2'] {
		color: var(--color-ok);
	}
	#chat [data-c='3'] {
		color: var(--color-building);
	}
	#chat [data-c='4'] {
		color: var(--color-heart);
	}
	#chat [data-c='5'] {
		color: var(--color-fg);
	}
</style>

<script>
	const section = document.querySelector<HTMLElement>('#chat');
	const log = section?.querySelector<HTMLElement>('[data-log]');
	const lista = section?.querySelector<HTMLElement>('[data-users]');
	const form = section?.querySelector<HTMLFormElement>('[data-form]');
	const input = section?.querySelector<HTMLInputElement>('[data-input]');
	const etiqueta = section?.querySelector<HTMLElement>('[data-nick-label]');
	const entrar = section?.querySelector<HTMLElement>('[data-entrar]');

	if (section && log && lista && form && input && etiqueta && entrar) {
		const CANAL = '#tuweb';
		const API = '/api/chat/irc';
		const MAX_LINEAS = 200;
		const MAX_TEXTO = 400;
		const SONDEO_MS = 3_000;
		const SONDEO_MAX_MS = 30_000;
		// Quien ha hablado hace poco sale en la lista, como si siguiera dentro.
		const RECIENTE_MS = 15 * 60_000;

		type Mensaje = { id: number; author: string; body: string; at: number; mine?: boolean };

		// El nick lo pone el servidor: el login de GitHub, o nada si no hay sesión.
		let nick: string | null = section.dataset.nick || null;
		let ultimo = 0;
		let online = 1;
		const hablaron = new Map<string, number>();

		function color(quien: string) {
			let suma = 0;
			for (const letra of quien) suma = (suma * 31 + letra.charCodeAt(0)) % 997;
			return String(suma % 6);
		}

		function hora(at: number) {
			return new Date(at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
		}

		function abajo() {
			// Solo se sigue el hilo si ya se estaba mirando el final.
			return log.scrollHeight - log.scrollTop - log.clientHeight < 40;
		}

		function pintar(at: number, trozos: (Node | string)[]) {
			const seguir = abajo();
			const linea = document.createElement('p');
			linea.className = 'flex gap-2';

			const marca = document.createElement('span');
			marca.className = 'shrink-0 text-muted';
			marca.textContent = `[${hora(at)}]`;

			const cuerpo = document.createElement('span');
			cuerpo.className = 'min-w-0';
			cuerpo.append(...trozos);

			linea.append(marca, cuerpo);
			log.append(linea);
			while (log.childElementCount > MAX_LINEAS) log.firstElementChild?.remove();
			if (seguir) log.scrollTop = log.scrollHeight;
		}

		function nickEl(quien: string) {
			const span = document.createElement('span');
			span.dataset.c = color(quien);
			span.textContent = `<${quien}>`;
			return span;
		}

		function sistema(texto: string, at = Date.now()) {
			const span = document.createElement('span');
			span.className = 'text-muted';
			span.textContent = `-!- ${texto}`;
			pintar(at, [span]);
		}

		function pintarMensaje(mensaje: Mensaje) {
			// /me viaja como texto normal y aquí se pinta como acción.
			if (mensaje.body.startsWith('/me ')) {
				const span = document.createElement('span');
				span.className = 'text-mark';
				span.textContent = `* ${mensaje.author} ${mensaje.body.slice(4)}`;
				pintar(mensaje.at, [span]);
				return;
			}
			pintar(mensaje.at, [nickEl(mensaje.author), ' ', mensaje.body]);
		}

		function presentes() {
			const ahora = Date.now();
			return [...hablaron]
				.filter(([quien, at]) => quien !== nick && ahora - at <= RECIENTE_MS)
				.sort((a, b) => b[1] - a[1])
				.map(([quien]) => quien);
		}

		function pintarUsuarios() {
			const cuantos = document.createElement('li');
			cuantos.className = 'text-muted';
			cuantos.textContent = `${online} mirando`;

			const nicks = [nick, ...presentes()].filter((quien): quien is string => Boolean(quien));
			lista.replaceChildren(
				cuantos,
				...nicks.map((quien) => {
					const item = document.createElement('li');
					const span = document.createElement('span');
					span.dataset.c = color(quien);
					span.textContent = quien;
					item.append(span);
					if (quien === nick) {
						const tuyo = document.createElement('span');
						tuyo.className = 'text-muted';
						tuyo.textContent = ' (tú)';
						item.append(tuyo);
					}
					return item;
				}),
			);
		}

		function sesion(login: string | null) {
			nick = login;
			form.hidden = !login;
			entrar.hidden = Boolean(login);
			if (login) etiqueta.textContent = `<${login}>`;
		}

		// --- Sondeo: se pregunta por lo posterior al último id visto ---

		let temporizador = 0;
		let enCurso = false;
		let otraVez = false;
		let fallos = 0;

		function programar() {
			clearTimeout(temporizador);
			if (document.visibilityState !== 'visible') return;
			// Ante errores se espera cada vez más, hasta medio minuto.
			const espera = fallos ? Math.min(SONDEO_MAX_MS, SONDEO_MS * 2 ** fallos) : SONDEO_MS;
			temporizador = window.setTimeout(sondear, espera);
		}

		async function sondear() {
			clearTimeout(temporizador);
			if (enCurso) {
				// No se solapan: la que está en marcha pedirá otra al terminar.
				otraVez = true;
				return;
			}
			if (document.visibilityState !== 'visible') return;
			enCurso = true;
			try {
				const respuesta = await fetch(`${API}?since=${ultimo}`);
				if (!respuesta.ok) throw new Error(String(respuesta.status));
				const datos = (await respuesta.json()) as {
					messages: Mensaje[];
					online: number;
					login: string | null;
				};

				if (fallos) sistema('De vuelta en el canal.');
				fallos = 0;
				if (datos.login !== nick) sesion(datos.login);
				online = datos.online;

				for (const mensaje of datos.messages) {
					if (mensaje.id <= ultimo) continue;
					ultimo = mensaje.id;
					hablaron.set(mensaje.author, Math.max(hablaron.get(mensaje.author) ?? 0, mensaje.at));
					pintarMensaje(mensaje);
				}
				pintarUsuarios();
			} catch {
				if (!fallos) sistema('Sin conexión con el servidor. Reintentando…');
				fallos += 1;
			} finally {
				enCurso = false;
				if (otraVez) {
					otraVez = false;
					void sondear();
				} else {
					programar();
				}
			}
		}

		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible') void sondear();
			else clearTimeout(temporizador);
		});

		// --- Enviar ---

		const ERRORES: Record<number, string> = {
			400: 'Mensaje vacío o demasiado largo.',
			403: 'Ese envío no viene de esta web.',
			422: 'Eso parece spam. No se ha enviado.',
			429: 'Vas muy rápido. Espera un momento.',
		};

		async function enviar(texto: string) {
			try {
				const respuesta = await fetch(API, {
					headers: { 'Content-Type': 'application/json' },
					method: 'POST',
					body: JSON.stringify({ body: texto }),
				});
				if (respuesta.status === 401) {
					sesion(null);
					sistema('Tu sesión ha caducado. Entra con GitHub para escribir.');
					return;
				}
				if (!respuesta.ok) {
					sistema(ERRORES[respuesta.status] ?? 'No se ha podido enviar. Prueba otra vez.');
					if (!input.value) input.value = texto;
					return;
				}
				void sondear();
			} catch {
				sistema('No se ha podido enviar: sin conexión. Prueba otra vez.');
				if (!input.value) input.value = texto;
			}
		}

		// --- Comandos ---

		const AYUDA = [
			'/help — esta lista',
			'/me <acción> — hablar en tercera persona',
			'/names — quién hay en el canal',
			'/topic — el tema del canal',
			'/clear — limpiar la pantalla',
		];

		function comando(linea: string) {
			const [orden, ...resto] = linea.slice(1).split(' ');
			const argumento = resto.join(' ').trim();

			switch (orden.toLowerCase()) {
				case 'help':
				case 'ayuda':
					for (const fila of AYUDA) sistema(fila);
					return;

				case 'nick':
					sistema('Tu nick es el de GitHub y no se cambia.');
					return;

				case 'me':
					if (!argumento) {
						sistema('Uso: /me <acción>.');
						return;
					}
					void enviar(`/me ${argumento}`.slice(0, MAX_TEXTO));
					return;

				case 'names':
				case 'users': {
					const nombres = [nick, ...presentes()].filter(Boolean).join(', ');
					sistema(
						`En ${CANAL}: ${online} mirando${nombres ? `; han hablado hace poco ${nombres}` : ''}.`,
					);
					return;
				}

				case 'topic':
					sistema(`Tema de ${CANAL}: esta web la cambias tú. Vamos por la v${section.dataset.version ?? '0'}.`);
					return;

				case 'clear':
					log.replaceChildren();
					sistema('Pantalla limpia. El canal sigue igual para los demás.');
					return;

				default:
					sistema(`No conozco /${orden}. Prueba /help.`);
			}
		}

		// Lo escrito se recuerda para poder repetirlo con las flechas, como en
		// cualquier cliente de IRC.
		const escrito: string[] = [];
		let cursor = 0;

		input.addEventListener('keydown', (evento) => {
			if (evento.key !== 'ArrowUp' && evento.key !== 'ArrowDown') return;
			if (!escrito.length) return;
			evento.preventDefault();

			cursor = Math.min(escrito.length, Math.max(0, cursor + (evento.key === 'ArrowUp' ? -1 : 1)));
			input.value = escrito[cursor] ?? '';
			input.setSelectionRange(input.value.length, input.value.length);
		});

		form.addEventListener('submit', (evento) => {
			evento.preventDefault();
			const texto = input.value.trim().slice(0, MAX_TEXTO);
			if (!texto) return;
			input.value = '';

			if (escrito.at(-1) !== texto) escrito.push(texto);
			cursor = escrito.length;

			if (texto.startsWith('/')) {
				comando(texto);
				return;
			}
			void enviar(texto);
		});

		// --- Arranque ---

		sistema(nick ? `Bienvenido a ${CANAL}, ${nick}` : `Bienvenido a ${CANAL}`);
		sistema(`Tema: esta web la cambias tú · v${section.dataset.version ?? '0'}`);
		sistema(
			nick
				? 'Escribe /help para ver los comandos. Lo que digas lo lee todo el canal y dura un día.'
				: 'Puedes leer sin entrar. Para escribir, entra con GitHub.',
		);

		pintarUsuarios();
		void sondear();
	}
</script>
