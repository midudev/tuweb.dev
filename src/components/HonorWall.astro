---
/**
 * El muro de honor de los retos: las soluciones que la comunidad ha coronado o
 * votado por creativas, semana a semana, también las de semanas pasadas. Sale
 * de lo que guarda tu navegador, así que el servidor lo pinta vacío.
 */
import Icon from './Icon.astro';
---

<section id="honor" class="flex flex-col gap-4 border border-line bg-panel p-4" aria-labelledby="honor-titulo">
	<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
		<h2 id="honor-titulo" class="inline-flex items-center gap-2 font-pixel text-lg font-normal">
			<Icon name="trophy" class="size-5 shrink-0 text-mark" />
			Muro de honor
		</h2>
		<span data-honor-total class="text-sm tabular-nums text-muted"></span>
	</div>

	<ol data-honor class="flex flex-col gap-5"></ol>

	<p data-honor-vacio class="text-sm text-muted">
		Aún no hay nadie en el muro. Publica soluciones en los retos, vota las más creativas y corona
		la mejor de cada uno: se quedan aquí semana a semana.
	</p>

	<template data-honor-semana>
		<li data-honor-li class="flex flex-col gap-3 border-t border-line pt-3">
			<span data-honor-label class="font-pixel text-xs tracking-wide text-muted"></span>
			<ul data-honor-items class="grid gap-3 sm:grid-cols-2"></ul>
		</li>
	</template>

	<template data-honor-item>
		<li data-honor-sol class="flex flex-col gap-2 border border-line border-l-2 bg-bg p-3">
			<span class="flex items-center gap-2 text-xs text-mark">
				<span data-honor-corona class="inline-flex items-center gap-1">
					<Icon name="crown" class="size-4 shrink-0" />
					Mejor solución
				</span>
				<span data-honor-creativa class="inline-flex items-center gap-1">
					<Icon name="star" class="size-4 shrink-0" />
					Creativa
				</span>
			</span>
			<span data-honor-reto class="text-xs text-muted"></span>
			<p data-honor-texto class="whitespace-pre-line break-words text-sm"></p>
			<span data-honor-autor class="mt-auto text-xs text-muted"></span>
		</li>
	</template>
</section>

<style is:global>
	/* Las pinta el script, sin la marca del componente: todo cuelga de #honor. */
	#honor [data-honor-sol] {
		border-left-color: var(--color-mark);
	}
	#honor [data-honor-sol][data-mejor='si'] {
		border-color: var(--color-mark);
	}
	#honor [data-honor-sol][data-mejor='si'] [data-honor-creativa],
	#honor [data-honor-sol]:not([data-mejor='si']) [data-honor-corona] {
		display: none;
	}
	#honor [data-honor-li][data-actual='si'] {
		border-top-color: var(--color-mark);
	}
</style>

<script>
	import { houseRetos, weekIndex, weekLabel, weekStart } from '../lib/retos';
	import { CAMBIO, honorOf, readSoluciones } from '../lib/soluciones';

	const DAY = 24 * 60 * 60 * 1000;

	const section = document.querySelector<HTMLElement>('#honor');
	const list = section?.querySelector<HTMLElement>('[data-honor]');
	const vacio = section?.querySelector<HTMLElement>('[data-honor-vacio]');
	const total = section?.querySelector<HTMLElement>('[data-honor-total]');
	const semanaTemplate = section?.querySelector<HTMLTemplateElement>('[data-honor-semana]');
	const itemTemplate = section?.querySelector<HTMLTemplateElement>('[data-honor-item]');

	/** El lunes de una semana por su número: el jueves en UTC siempre cae dentro. */
	const lunesDe = (week: number) => weekStart(Date.UTC(1970, 0, 5) + week * 7 * DAY + 3 * DAY);

	function pintar() {
		if (!list || !semanaTemplate || !itemTemplate) return;
		const week = weekIndex(weekStart(Date.now()));
		const semanas = honorOf(readSoluciones(), week);

		list.replaceChildren(
			...semanas.map((semana) => {
				const node = semanaTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
				node.dataset.actual = semana.week === week ? 'si' : 'no';
				node.querySelector('[data-honor-label]')!.textContent =
					(semana.week === week ? 'ESTA SEMANA · ' : '') + weekLabel(lunesDe(semana.week)).toUpperCase();

				const casa = new Map(houseRetos(semana.week).map((reto) => [reto.id, reto.title]));
				node.querySelector('[data-honor-items]')!.replaceChildren(
					...semana.items.map(({ reto, solucion }) => {
						const item = itemTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
						item.dataset.mejor = solucion.mejor ? 'si' : 'no';
						item.querySelector('[data-honor-reto]')!.textContent =
							solucion.reto || casa.get(reto) || 'Un reto de la gente';
						item.querySelector('[data-honor-texto]')!.textContent = solucion.text;
						item.querySelector('[data-honor-autor]')!.textContent = solucion.firma
							? `De ${solucion.firma}`
							: 'Sin firma';
						return item;
					}),
				);
				return node;
			}),
		);

		const coronas = semanas.reduce(
			(suma, semana) => suma + semana.items.filter(({ solucion }) => solucion.mejor).length,
			0,
		);
		const elegidas = semanas.reduce((suma, semana) => suma + semana.items.length, 0);
		if (vacio) vacio.hidden = semanas.length > 0;
		if (total)
			total.textContent =
				elegidas === 0
					? ''
					: `${coronas} ${coronas === 1 ? 'coronada' : 'coronadas'} · ${elegidas - coronas} ${elegidas - coronas === 1 ? 'creativa' : 'creativas'}`;
	}

	pintar();
	window.addEventListener(CAMBIO, pintar);
	// Si votas en otra pestaña, el muro se entera sin recargar.
	window.addEventListener('storage', (event) => {
		if (event.key === null || event.key === 'tuweb:retos-soluciones') pintar();
	});
</script>
