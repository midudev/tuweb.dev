---
/**
 * Chat anónimo. Al lado del canal de IRC, que tiene nicks y memoria, este es lo
 * contrario: no se pide nombre ni cuenta, el alias es un número que cambia
 * cuando quieras y solo vive en la memoria de la pestaña. Los mensajes pasan
 * por el servidor, que los borra solos a los diez minutos.
 */
import Icon from './Icon.astro';
---

<section id="anonimo" class="flex flex-col gap-7">
	<div class="flex flex-col border border-line bg-panel">
		<div
			class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-line px-4 py-3"
		>
			<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
				<span class="flex items-center gap-1 font-pixel text-accent">
					<Icon name="hash" class="size-4 shrink-0" />
					anónimo
				</span>
				<span class="text-sm text-muted">eres <span data-alias>…</span></span>
				<button
					type="button"
					data-rotar
					class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-accent"
				>
					<Icon name="refresh" class="size-4 shrink-0" />
					Cambiar de alias
				</button>
			</div>
			<span class="flex items-center gap-3 text-xs text-muted">
				<span data-aqui aria-live="polite">1 aquí</span>
				<span class="flex items-center gap-1">
					<Icon name="hourglass" class="size-3.5 shrink-0" />
					se borra a los 10 min
				</span>
			</span>
		</div>

		<ul
			data-log
			role="log"
			aria-live="polite"
			aria-label="Mensajes anónimos"
			class="flex h-80 min-w-0 flex-col gap-3 overflow-y-auto px-4 py-3"
		>
		</ul>

		<p data-vacio class="border-t border-line px-4 py-3 text-sm text-muted">
			Aquí no hay nada. Lo de antes ya se ha borrado y lo que escribas se borrará también.
		</p>

		<form data-form class="flex items-center gap-3 border-t border-line px-4 py-3">
			<input
				id="anonimo-input"
				data-input
				type="text"
				maxlength="400"
				autocomplete="off"
				spellcheck="false"
				aria-label="Mensaje anónimo"
				placeholder="Di lo que quieras, nadie sabe quién eres"
				class="min-w-0 grow bg-transparent text-sm"
			/>
			<button
				type="submit"
				class="inline-flex shrink-0 items-center gap-2 border border-line px-3 py-2 text-sm text-muted hover:border-accent hover:text-accent"
			>
				<Icon name="send" class="size-4 shrink-0" />
				Enviar
			</button>
		</form>
	</div>

	<p data-nota class="text-sm text-muted" role="status"></p>
</section>

<style is:global>
	/*
	 * El color del alias sale de su número, siempre de la paleta de la casa. Va
	 * global porque estas líneas las pinta el script y no llevan la marca del
	 * componente; por eso todas cuelgan de #anonimo.
	 */
	#anonimo [data-c='0'] {
		color: var(--color-accent);
	}
	#anonimo [data-c='1'] {
		color: var(--color-mark);
	}
	#anonimo [data-c='2'] {
		color: var(--color-ok);
	}
	#anonimo [data-c='3'] {
		color: var(--color-building);
	}
	#anonimo [data-c='4'] {
		color: var(--color-heart);
	}
	#anonimo [data-c='5'] {
		color: var(--color-fg);
	}
</style>

<script>
	const section = document.querySelector<HTMLElement>('#anonimo');
	const log = section?.querySelector<HTMLElement>('[data-log]');
	const vacio = section?.querySelector<HTMLElement>('[data-vacio]');
	const form = section?.querySelector<HTMLFormElement>('[data-form]');
	const input = section?.querySelector<HTMLInputElement>('[data-input]');
	const aliasEl = section?.querySelector<HTMLElement>('[data-alias]');
	const aqui = section?.querySelector<HTMLElement>('[data-aqui]');
	const nota = section?.querySelector<HTMLElement>('[data-nota]');
	const rotar = section?.querySelector<HTMLButtonElement>('[data-rotar]');

	if (section && log && vacio && form && input && aliasEl && aqui && nota && rotar) {
		const API = '/api/chat/anon';
		const VIDA_MS = 10 * 60_000;
		const MAX_LINEAS = 80;
		const MAX_TEXTO = 400;
		const REPASO_MS = 15_000;
		const ESPERA_MS = 900;
		const SONDEO_MS = 3_000;
		const SONDEO_MAX_MS = 30_000;

		type Mensaje = { id: number; author: string; body: string; at: number };

		function azar(largo: number) {
			const bytes = new Uint8Array(largo);
			crypto.getRandomValues(bytes);
			return [...bytes]
				.map((byte) => byte.toString(16).padStart(2, '0'))
				.join('')
				.slice(0, largo);
		}

		const vivos = new Map<number, { at: number; fila: HTMLElement; queda: HTMLElement; tuyo: HTMLElement }>();
		// El servidor no sabe quién es quién aquí: lo tuyo se recuerda en la
		// pestaña con los ids que devuelve cada envío.
		const mios = new Set<number>();
		let alias = `anónimo#${azar(4)}`;
		let ultimo = 0;
		let visto = 0;

		function color(quien: string) {
			let suma = 0;
			for (const letra of quien) suma = (suma * 31 + letra.charCodeAt(0)) % 997;
			return String(suma % 6);
		}

		function restante(at: number) {
			const minutos = Math.ceil((at + VIDA_MS - Date.now()) / 60_000);
			if (minutos <= 1) return 'queda menos de 1 min';
			return `quedan ${minutos} min`;
		}

		function avisar(texto: string) {
			nota.textContent = texto;
		}

		function repintarVacio() {
			vacio.hidden = vivos.size > 0;
		}

		function abajo() {
			// Solo se sigue el hilo si ya se estaba mirando el final.
			return log.scrollHeight - log.scrollTop - log.clientHeight < 40;
		}

		function olvidar(id: number) {
			const entrada = vivos.get(id);
			if (!entrada) return;
			entrada.fila.remove();
			vivos.delete(id);
		}

		function marcarMio(id: number) {
			mios.add(id);
			const entrada = vivos.get(id);
			if (entrada) entrada.tuyo.hidden = false;
		}

		function pintar(mensaje: Mensaje) {
			if (vivos.has(mensaje.id)) return;
			// Un reloj adelantado en el servidor no puede alargar la vida del
			// mensaje más allá de lo que dura aquí.
			const at = Math.min(Number(mensaje.at) || Date.now(), Date.now());
			if (Date.now() - at >= VIDA_MS) return;
			const seguir = abajo();

			const fila = document.createElement('li');
			fila.className = 'flex min-w-0 flex-col gap-0.5 border-l border-line pl-3';

			const cabecera = document.createElement('p');
			cabecera.className = 'flex items-baseline justify-between gap-3 text-xs';

			const quien = document.createElement('span');
			quien.dataset.c = color(mensaje.author);
			quien.textContent = mensaje.author;

			// Va siempre y se enseña si el id es tuyo: el envío puede volver
			// después de que el sondeo ya lo haya pintado.
			const tuyo = document.createElement('span');
			tuyo.className = 'grow text-muted';
			tuyo.textContent = ' (tú)';
			tuyo.hidden = !mios.has(mensaje.id);

			const queda = document.createElement('span');
			queda.className = 'shrink-0 tabular-nums text-muted';
			queda.textContent = restante(at);
			cabecera.append(quien, tuyo, queda);

			const cuerpo = document.createElement('p');
			cuerpo.className = 'min-w-0 text-sm';
			cuerpo.textContent = mensaje.body;

			fila.append(cabecera, cuerpo);
			log.append(fila);
			vivos.set(mensaje.id, { at, fila, queda, tuyo });

			// El tope es de la lista entera: lo más viejo se cae aunque no haya
			// cumplido sus diez minutos.
			while (vivos.size > MAX_LINEAS) {
				const primero = vivos.keys().next();
				if (primero.done) break;
				olvidar(primero.value);
			}

			repintarVacio();
			if (seguir) log.scrollTop = log.scrollHeight;
		}

		function contar(online: number) {
			aqui.textContent = `${Math.max(1, online)} aquí`;
		}

		// --- Sondeo: se pregunta por lo posterior al último id visto ---

		let temporizador = 0;
		let enCurso = false;
		let otraVez = false;
		let fallos = 0;

		function programar() {
			clearTimeout(temporizador);
			if (document.visibilityState !== 'visible') return;
			// Ante errores se espera cada vez más, hasta medio minuto.
			const espera = fallos ? Math.min(SONDEO_MAX_MS, SONDEO_MS * 2 ** fallos) : SONDEO_MS;
			temporizador = window.setTimeout(sondear, espera);
		}

		async function sondear() {
			clearTimeout(temporizador);
			if (enCurso) {
				// No se solapan: la que está en marcha pedirá otra al terminar.
				otraVez = true;
				return;
			}
			if (document.visibilityState !== 'visible') return;
			enCurso = true;
			try {
				const respuesta = await fetch(`${API}?since=${ultimo}`);
				if (!respuesta.ok) throw new Error(String(respuesta.status));
				const datos = (await respuesta.json()) as { messages: Mensaje[]; online: number };

				if (fallos) avisar('De vuelta. Ya llegan los mensajes.');
				fallos = 0;
				contar(datos.online);

				for (const mensaje of datos.messages) {
					if (mensaje.id <= ultimo) continue;
					ultimo = mensaje.id;
					pintar(mensaje);
				}
				repintarVacio();
			} catch {
				if (!fallos) avisar('Sin conexión con el servidor. Reintentando…');
				fallos += 1;
			} finally {
				enCurso = false;
				if (otraVez) {
					otraVez = false;
					void sondear();
				} else {
					programar();
				}
			}
		}

		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible') void sondear();
			else clearTimeout(temporizador);
		});

		// --- Lo que se hace desde aquí ---

		const ERRORES: Record<number, string> = {
			400: 'Mensaje vacío o demasiado largo.',
			403: 'Ese envío no viene de esta web.',
			422: 'Eso parece spam. No se ha enviado.',
			429: 'Vas muy rápido. Espera un momento.',
		};

		form.addEventListener('submit', async (evento) => {
			evento.preventDefault();
			const texto = input.value.trim().slice(0, MAX_TEXTO);
			if (!texto) return;

			const ahora = Date.now();
			if (ahora - visto < ESPERA_MS) {
				avisar('Vas muy rápido. Espera un momento.');
				return;
			}
			visto = ahora;
			input.value = '';

			try {
				const respuesta = await fetch(API, {
					headers: { 'Content-Type': 'application/json' },
					method: 'POST',
					body: JSON.stringify({ body: texto, alias }),
				});
				if (!respuesta.ok) {
					avisar(ERRORES[respuesta.status] ?? 'No se ha podido enviar. Prueba otra vez.');
					if (!input.value) input.value = texto;
					return;
				}
				const datos = (await respuesta.json()) as { message: Mensaje };
				marcarMio(datos.message.id);
				avisar('Enviado. Se borra en diez minutos.');
				void sondear();
			} catch {
				avisar('No se ha podido enviar: sin conexión. Prueba otra vez.');
				if (!input.value) input.value = texto;
			}
		});

		rotar.addEventListener('click', () => {
			alias = `anónimo#${azar(4)}`;
			aliasEl.textContent = alias;
			aliasEl.dataset.c = color(alias);
			// Lo ya dicho se queda con el alias viejo: nadie puede atar los dos.
			avisar(`Ahora eres ${alias}. Lo de antes sigue con el alias anterior.`);
		});

		// --- Arranque ---

		aliasEl.textContent = alias;
		aliasEl.dataset.c = color(alias);
		contar(1);
		repintarVacio();
		avisar('Sin nombre y sin cuenta. Lo que escribas lo ve quien esté aquí y se borra a los diez minutos.');

		// Un repaso cada poco: lo que ha cumplido se va y al resto se le actualiza
		// lo que le queda.
		setInterval(() => {
			const ahora = Date.now();
			for (const [id, entrada] of vivos) {
				if (ahora - entrada.at >= VIDA_MS) {
					olvidar(id);
					continue;
				}
				entrada.queda.textContent = restante(entrada.at);
			}
			repintarVacio();
		}, REPASO_MS);

		void sondear();
	}
</script>
