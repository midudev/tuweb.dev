---
/**
 * La rejilla de tarjetas de sección. La usan la página de todo y la página de
 * cada apartado, así que una tarjeta se ve igual en los dos sitios.
 *
 * Cada tarjeta lleva en data-buscar lo que se puede escribir para encontrarla
 * —su nombre, su línea y su apartado—; el buscador de /todo filtra por ahí y
 * donde no hay buscador el atributo no molesta.
 */
import type { Section } from '../lib/sections';
import { getGroup } from '../lib/sections';
import Icon from './Icon.astro';

interface Props {
	sections: Section[];
}

const { sections } = Astro.props;
---

<!-- La rejilla ya no cuenta cortes de pantalla: cabe la tarjeta que quepa, con
     18rem de ancho mínimo. Salen las mismas tres columnas de siempre en el
     escritorio y dos en la tableta, pero también se reparte bien en los anchos
     de en medio, donde antes quedaba media rejilla vacía. -->
<ul class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,18rem),1fr))] gap-4">
	{
		sections.map((section) => (
			<li class="flex" data-buscar={`${section.title} ${section.card} ${getGroup(section.group).title}`}>
				<a
					href={section.href}
					class="group flex grow flex-col gap-2 border border-line bg-panel px-4 py-5 transition-colors hover:border-accent sm:px-5"
				>
					<span class="flex items-center gap-2.5 font-pixel text-lg">
						<Icon name={section.icon} class="size-5 shrink-0 text-accent" />
						{section.title}
					</span>
					<span class="text-sm text-pretty text-muted">{section.card}</span>
					<span class="mt-auto inline-flex items-center gap-2 pt-3 text-sm text-accent group-hover:underline">
						Abrir
						<Icon
							name="arrow-right"
							class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
						/>
					</span>
				</a>
			</li>
		))
	}
</ul>
