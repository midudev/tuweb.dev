---
import type { SessionUser } from '../lib/auth';
import type { SiteState } from '../lib/releases';
import { agoLabel } from '../lib/window';
import GitHubLogin from './GitHubLogin.astro';
import Icon from './Icon.astro';

interface Props {
	user: SessionUser | null;
	version: number;
	deployedAt?: string | null;
	state?: SiteState;
	as?: 'h1' | 'p';
}

/** Lo que dice el punto de al lado de la versión, para quien no lo ve. */
const LABELS: Record<SiteState, string> = {
	idle: 'Sin cambios en marcha',
	building: 'Construyendo una versión nueva',
	repairing: 'La última actualización falló y la IA la está arreglando',
	broken: 'La última actualización falló y hace falta mirarla a mano',
	reverted: 'La última actualización falló y la web volvió a la versión anterior',
};

const { user, version, deployedAt = null, state = 'idle', as: Tag = 'h1' } = Astro.props;
const working = state === 'building' || state === 'repairing';
const ago = deployedAt ? agoLabel(deployedAt) : null;
const exactDate = deployedAt
	? new Date(deployedAt).toLocaleDateString('es-ES', {
			day: 'numeric',
			month: 'long',
			hour: '2-digit',
			minute: '2-digit',
		})
	: null;
---

<header class="flex items-center justify-between gap-8">
	<a href="/" class="group/logo inline-flex items-start gap-1.5 no-underline">
		<Tag class="font-pixel text-[26px] leading-none font-normal">esta web es tuya</Tag>
		<span class="group/ver relative inline-flex items-start gap-1.5">
			<span class="font-pixel text-xs leading-none text-accent">v{version}</span>
			<span
				class:list={[
					'mt-px size-1.5 shrink-0 rounded-full',
					working && 'animate-pulse bg-building motion-reduce:animate-none',
					!working && (state === 'broken' ? 'bg-heart' : 'bg-ok'),
				]}
			/>
			<span class="sr-only">{LABELS[state]}</span>
			{
				(ago || state !== 'idle') && (
					<span
						role="tooltip"
						class="pointer-events-none absolute top-full left-1/2 z-10 mt-2 -translate-x-1/2 border border-line bg-panel px-3 py-2 text-xs whitespace-nowrap text-muted opacity-0 transition-opacity group-hover/ver:opacity-100 group-focus-visible/logo:opacity-100"
					>
						{state !== 'idle' && `${LABELS[state]}. `}
						{ago && `Desplegada ${ago} · ${exactDate}`}
					</span>
				)
			}
		</span>
	</a>

	{
		user ? (
			<div class="flex items-center gap-4 text-sm">
				<span class="flex items-center gap-2.5">
					<img
						src={user.avatarUrl}
						alt=""
						width="24"
						height="24"
						loading="lazy"
						class="size-6 shrink-0 bg-panel"
					/>
					<span class="text-muted">{user.login}</span>
				</span>
				<form method="post" action="/api/auth/logout" class="flex">
					<button type="submit" class="inline-flex items-center gap-1.5 text-muted hover:text-fg">
						<Icon name="logout" class="size-4 shrink-0" />
						Salir
					</button>
				</form>
			</div>
		) : (
			<GitHubLogin />
		)
	}
</header>
