# Detrás de nginx: 127.0.0.1. Si abres el puerto de Node: 0.0.0.0
HOST=127.0.0.1
PORT=4321
SITE_URL=http://localhost:4321
CRON_URL=http://127.0.0.1:4321/api/cron/process

# SQLite en el propio disco. En el VPS, fuera de la carpeta del repositorio.
# Local: file:local.db · VPS: file:/var/lib/tuweb/tuweb.db
DATABASE_URL=file:local.db

# GitHub OAuth App. En local, si esto está vacío, se usa `gh auth`.
# Callback: $SITE_URL/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Protege GET/POST /api/cron/process
CRON_SECRET=cambia-esto

# Opcional. Si no hay clave, el cron usa heurística local.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# Despliegue con vuelta atrás automática (scripts/release.mjs).
# Si el build falla o la web no responde, vuelve solo al commit anterior.
HEALTH_URL=http://127.0.0.1:4321
# Con pm2. Con systemd: sudo systemctl restart tuweb
RESTART_CMD=pm2 restart tuweb
INSTALL_CMD=pnpm install --frozen-lockfile
BUILD_CMD=pnpm build

# La IA que implementa la idea ganadora (scripts/iterate.mjs).
ANTHROPIC_API_KEY=
CLAUDE_CMD=claude
ITERATE_TIMEOUT_MS=900000
MAX_CHANGED_LINES=800

# Commits del bot. El push va por SSH con la clave del propio servidor.
BOT_NAME=tuweb-bot
BOT_EMAIL=bot@tuweb.dev
GIT_REMOTE=origin
GIT_BRANCH=main
